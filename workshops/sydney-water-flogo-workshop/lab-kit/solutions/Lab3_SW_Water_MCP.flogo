{
    "imports": [
        "github.com/project-flogo/flow",
        "github.com/tibco/flogo-general/src/app/General/activity/log",
        "github.com/tibco/flogo-general/src/app/General/activity/mapper",
        "github.com/project-flogo/contrib/activity/actreturn",
        "github.com/tibco/flogo-general/src/app/General/activity/rest",
        "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
        "github.com/project-flogo/contrib/function/coerce",
        "github.com/project-flogo/contrib/function/string"
    ],
    "name": "SW_Water_MCP",
    "description": "Sydney Water workshop Lab 3 - MCP tools over the Lab 1 and Lab 2 Flogo APIs WITH guardrails (API key, input validation, PII masking, least privilege)",
    "version": "1.0.0",
    "type": "flogo:app",
    "appModel": "1.1.1",
    "tags": [],
    "triggers": [
        {
            "ref": "#mcpserver",
            "name": "flogo-mcp-mcpsever",
            "description": "MCP server for AI agents",
            "settings": {
                "serverName": "SW_Water_MCP",
                "serverVersion": "1.0.0",
                "serverType": "HTTP",
                "serverPort": "9090",
                "statelessServer": false,
                "serverEndpointPath": "/mcp",
                "enableTLS": false,
                "serverCertificate": "",
                "serverPrivateKey": "",
                "authType": "API Key",
                "authToken": "=$property[\"MCP.ApiKey\"]",
                "oauthIssuer": "",
                "oauthJWKSURL": "",
                "oauthAudience": "",
                "oauthAuthorizationServers": "",
                "oauthRequiredScopes": "",
                "oauthResourceURL": ""
            },
            "id": "MCPServer",
            "handlers": [
                {
                    "description": "MCP tool assess_rainfall_risk",
                    "settings": {
                        "handlerType": "Tool",
                        "resourceUri": "",
                        "handlerName": "assess_rainfall_risk",
                        "handlerDescription": "Assess the wet-weather overflow/inflow risk at one Sydney Water site in Greater Sydney from forecast rainfall. Calls the Rainfall Risk API, which reads the weather forecast and, when the risk is MEDIUM or HIGH, raises an inspection request in Field Service. forecastDays must be 1-7; latitude/longitude must be inside Greater Sydney (latitude -34.2 to -33.3, longitude 150.5 to 151.4). Returns siteId, siteName, riskLevel (LOW, MEDIUM or HIGH), totalRainfallMm, inspectionRequested and message.",
                        "toolTitle": "Assess rainfall risk",
                        "readOnlyToolHint": false,
                        "destructiveToolHint": false,
                        "idempotentToolHint": false,
                        "openWorldToolHint": true,
                        "scope": ""
                    },
                    "action": {
                        "ref": "github.com/project-flogo/flow",
                        "settings": {
                            "flowURI": "res://flow:AssessRainfallRisk"
                        },
                        "input": {
                            "arguments": "=$.arguments",
                            "httpHeaders": "=$.httpHeaders",
                            "tokenInfo": "=$.tokenInfo"
                        },
                        "output": {
                            "response": "=$.response"
                        }
                    },
                    "reply": {
                        "outputSchema": ""
                    },
                    "schemas": {
                        "reply": {
                            "response": {
                                "type": "json",
                                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
                            }
                        },
                        "output": {
                            "arguments": {
                                "type": "json",
                                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\",\"description\":\"Sydney Water site ID, e.g. PS-102\"},\"siteName\":{\"type\":\"string\",\"description\":\"Site name, e.g. Parramatta Sewage Pumping Station SP0102\"},\"latitude\":{\"type\":\"number\",\"description\":\"Site latitude in decimal degrees; Greater Sydney only (-34.2 to -33.3)\"},\"longitude\":{\"type\":\"number\",\"description\":\"Site longitude in decimal degrees; Greater Sydney only (150.5 to 151.4)\"},\"forecastDays\":{\"type\":\"integer\",\"description\":\"Number of forecast days to assess, 1 to 7\"}},\"required\":[\"siteId\",\"siteName\",\"latitude\",\"longitude\",\"forecastDays\"]}",
                                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\",\"description\":\"Sydney Water site ID, e.g. PS-102\"},\"siteName\":{\"type\":\"string\",\"description\":\"Site name, e.g. Parramatta Sewage Pumping Station SP0102\"},\"latitude\":{\"type\":\"number\",\"description\":\"Site latitude in decimal degrees; Greater Sydney only (-34.2 to -33.3)\"},\"longitude\":{\"type\":\"number\",\"description\":\"Site longitude in decimal degrees; Greater Sydney only (150.5 to 151.4)\"},\"forecastDays\":{\"type\":\"integer\",\"description\":\"Number of forecast days to assess, 1 to 7\"}},\"required\":[\"siteId\",\"siteName\",\"latitude\",\"longitude\",\"forecastDays\"]}"
                            },
                            "tokenInfo": {
                                "type": "json",
                                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"scopes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"expiration\":{\"type\":\"number\"},\"iss\":{\"type\":\"string\"},\"sub\":{\"type\":\"string\"},\"aud\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"}}}",
                                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"scopes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"expiration\":{\"type\":\"number\"},\"iss\":{\"type\":\"string\"},\"sub\":{\"type\":\"string\"},\"aud\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"}}}"
                            }
                        }
                    },
                    "name": "AssessRainfallRisk"
                },
                {
                    "description": "MCP tool report_leak",
                    "settings": {
                        "handlerType": "Tool",
                        "resourceUri": "",
                        "handlerName": "report_leak",
                        "handlerDescription": "Log a water leak reported by a resident or a field crew. Calls the Leak Report API, which creates a work order in Field Service. reportId must look like LR-1234; severity must be HIGH, MEDIUM or LOW; description is what the reporter said, 10-500 characters. Returns reportId, workOrderRef, priority (P1, P2 or P3) and status.",
                        "toolTitle": "Report a water leak",
                        "readOnlyToolHint": false,
                        "destructiveToolHint": false,
                        "idempotentToolHint": false,
                        "openWorldToolHint": true,
                        "scope": ""
                    },
                    "action": {
                        "ref": "github.com/project-flogo/flow",
                        "settings": {
                            "flowURI": "res://flow:ReportLeak"
                        },
                        "input": {
                            "arguments": "=$.arguments",
                            "httpHeaders": "=$.httpHeaders",
                            "tokenInfo": "=$.tokenInfo"
                        },
                        "output": {
                            "response": "=$.response"
                        }
                    },
                    "reply": {
                        "outputSchema": ""
                    },
                    "schemas": {
                        "reply": {
                            "response": {
                                "type": "json",
                                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
                            }
                        },
                        "output": {
                            "arguments": {
                                "type": "json",
                                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\",\"description\":\"Leak report ID: LR- followed by 4 digits, e.g. LR-2001\"},\"address\":{\"type\":\"string\",\"description\":\"Street address of the leak, e.g. 12 Church St\"},\"suburb\":{\"type\":\"string\",\"description\":\"Suburb, e.g. Parramatta\"},\"description\":{\"type\":\"string\",\"description\":\"What the reporter observed, in their words (10-500 characters)\"},\"severity\":{\"type\":\"string\",\"description\":\"HIGH, MEDIUM or LOW\"}},\"required\":[\"reportId\",\"address\",\"suburb\",\"description\",\"severity\"]}",
                                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\",\"description\":\"Leak report ID: LR- followed by 4 digits, e.g. LR-2001\"},\"address\":{\"type\":\"string\",\"description\":\"Street address of the leak, e.g. 12 Church St\"},\"suburb\":{\"type\":\"string\",\"description\":\"Suburb, e.g. Parramatta\"},\"description\":{\"type\":\"string\",\"description\":\"What the reporter observed, in their words (10-500 characters)\"},\"severity\":{\"type\":\"string\",\"description\":\"HIGH, MEDIUM or LOW\"}},\"required\":[\"reportId\",\"address\",\"suburb\",\"description\",\"severity\"]}"
                            },
                            "tokenInfo": {
                                "type": "json",
                                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"scopes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"expiration\":{\"type\":\"number\"},\"iss\":{\"type\":\"string\"},\"sub\":{\"type\":\"string\"},\"aud\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"}}}",
                                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"scopes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"expiration\":{\"type\":\"number\"},\"iss\":{\"type\":\"string\"},\"sub\":{\"type\":\"string\"},\"aud\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"}}}"
                            }
                        }
                    },
                    "name": "ReportLeak"
                }
            ]
        }
    ],
    "resources": [
        {
            "id": "flow:AssessRainfallRisk",
            "data": {
                "name": "AssessRainfallRisk",
                "description": "MCP tool assess_rainfall_risk",
                "links": [
                    {
                        "id": 1,
                        "from": "LogCall",
                        "to": "ValidateInput",
                        "type": "label",
                        "label": "LogCall to ValidateInput"
                    },
                    {
                        "id": 2,
                        "from": "ValidateInput",
                        "to": "ReturnRejected",
                        "type": "expression",
                        "label": "ValidateInput to ReturnRejected",
                        "value": "$activity[ValidateInput].output.rejectReason != \"\""
                    },
                    {
                        "id": 3,
                        "from": "ValidateInput",
                        "to": "CallRainfallRiskAPI",
                        "type": "exprOtherwise",
                        "label": "ValidateInput to CallRainfallRiskAPI"
                    },
                    {
                        "id": 4,
                        "from": "CallRainfallRiskAPI",
                        "to": "ShapeResult",
                        "type": "label",
                        "label": "CallRainfallRiskAPI to ShapeResult"
                    },
                    {
                        "id": 5,
                        "from": "ShapeResult",
                        "to": "Return",
                        "type": "label",
                        "label": "ShapeResult to Return"
                    },
                    {
                        "id": 6,
                        "from": "CallRainfallRiskAPI",
                        "to": "ReturnBackendError",
                        "type": "error",
                        "label": "CallRainfallRiskAPI to ReturnBackendError"
                    }
                ],
                "tasks": [
                    {
                        "id": "LogCall",
                        "name": "LogCall",
                        "description": "Log the tool call",
                        "activity": {
                            "ref": "#log",
                            "input": {
                                "Log Level": "INFO",
                                "flowInfo": false,
                                "message": "=string.concat(\"assess_rainfall_risk called with \", coerce.toString($flow.arguments))",
                                "logLevel": ""
                            },
                            "schemas": {
                                "input": {
                                    "dynamicLogFields": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "ValidateInput",
                        "name": "ValidateInput",
                        "description": "Guardrail: validate the arguments before calling the backend",
                        "activity": {
                            "ref": "#mapper",
                            "input": {
                                "input": {
                                    "mapping": {
                                        "rejectReason": "=(coerce.toInt($flow.arguments.forecastDays) < 1 || coerce.toInt($flow.arguments.forecastDays) > 7) ? string.concat(\"forecastDays must be between 1 and 7 (got \", coerce.toString($flow.arguments.forecastDays), \")\") : ((coerce.toFloat64($flow.arguments.latitude) < -34.2 || coerce.toFloat64($flow.arguments.latitude) > -33.3 || coerce.toFloat64($flow.arguments.longitude) < 150.5 || coerce.toFloat64($flow.arguments.longitude) > 151.4) ? string.concat(\"site must be in Greater Sydney (latitude -34.2 to -33.3, longitude 150.5 to 151.4), got \", coerce.toString($flow.arguments.latitude), \", \", coerce.toString($flow.arguments.longitude)) : \"\")"
                                    }
                                }
                            },
                            "schemas": {
                                "input": {
                                    "input": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"rejectReason\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"rejectReason\":{\"type\":\"string\"}}}"
                                    }
                                },
                                "output": {
                                    "output": {
                                        "type": "json",
                                        "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"rejectReason\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                                        "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"rejectReason\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "ReturnRejected",
                        "name": "ReturnRejected",
                        "description": "Reject without calling the backend",
                        "activity": {
                            "ref": "#actreturn",
                            "settings": {
                                "mappings": {
                                    "response": {
                                        "mapping": {
                                            "error": "=string.concat(\"Rejected by guardrail: \", $activity[ValidateInput].output.rejectReason)"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "id": "CallRainfallRiskAPI",
                        "name": "CallRainfallRiskAPI",
                        "description": "Call the Lab 1 Rainfall Risk API",
                        "settings": {
                            "retryOnError": {
                                "count": 0,
                                "interval": 0
                            }
                        },
                        "activity": {
                            "ref": "#rest",
                            "input": {
                                "swagger": "",
                                "authorization": false,
                                "authorizationConn": "",
                                "serviceName": "",
                                "resourcePath": "",
                                "Method": "POST",
                                "Uri": "=$property[\"Lab1.AssessURL\"]",
                                "requestType": "application/json",
                                "Use certificate for verification": false,
                                "mutualAuth": false,
                                "Client Certificate": "",
                                "Client Key": "",
                                "Server Certificate": "",
                                "disableSSLVerification": false,
                                "disableKeepAlives": false,
                                "followRedirects": true,
                                "Timeout": 0,
                                "proxy": "",
                                "host": "",
                                "body": {
                                    "mapping": {
                                        "siteId": "=$flow.arguments.siteId",
                                        "siteName": "=$flow.arguments.siteName",
                                        "latitude": "=$flow.arguments.latitude",
                                        "longitude": "=$flow.arguments.longitude",
                                        "forecastDays": "=$flow.arguments.forecastDays"
                                    }
                                }
                            },
                            "output": {
                                "configureResponseCodes": false,
                                "throwError": true,
                                "responseType": "application/json",
                                "responseOutput": "JSON Object"
                            },
                            "schemas": {
                                "input": {
                                    "headers": {
                                        "type": "json",
                                        "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                                        "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                                    },
                                    "dynamicRequestHeaders": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                                    },
                                    "body": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\"},\"siteName\":{\"type\":\"string\"},\"latitude\":{\"type\":\"number\"},\"longitude\":{\"type\":\"number\"},\"forecastDays\":{\"type\":\"integer\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\"},\"siteName\":{\"type\":\"string\"},\"latitude\":{\"type\":\"number\"},\"longitude\":{\"type\":\"number\"},\"forecastDays\":{\"type\":\"integer\"}}}"
                                    }
                                },
                                "output": {
                                    "responseBody": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\"},\"siteName\":{\"type\":\"string\"},\"riskLevel\":{\"type\":\"string\"},\"totalRainfallMm\":{\"type\":\"number\"},\"inspectionRequested\":{\"type\":\"boolean\"},\"message\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\"},\"siteName\":{\"type\":\"string\"},\"riskLevel\":{\"type\":\"string\"},\"totalRainfallMm\":{\"type\":\"number\"},\"inspectionRequested\":{\"type\":\"boolean\"},\"message\":{\"type\":\"string\"}}}"
                                    },
                                    "headers": {
                                        "type": "json",
                                        "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Set-Cookie\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                                        "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Set-Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "ShapeResult",
                        "name": "ShapeResult",
                        "description": "Guardrail: return only the documented fields",
                        "activity": {
                            "ref": "#mapper",
                            "input": {
                                "input": {
                                    "mapping": {
                                        "siteId": "=$activity[CallRainfallRiskAPI].responseBody.siteId",
                                        "siteName": "=$activity[CallRainfallRiskAPI].responseBody.siteName",
                                        "riskLevel": "=$activity[CallRainfallRiskAPI].responseBody.riskLevel",
                                        "totalRainfallMm": "=$activity[CallRainfallRiskAPI].responseBody.totalRainfallMm",
                                        "inspectionRequested": "=$activity[CallRainfallRiskAPI].responseBody.inspectionRequested",
                                        "message": "=$activity[CallRainfallRiskAPI].responseBody.message"
                                    }
                                }
                            },
                            "schemas": {
                                "input": {
                                    "input": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\"},\"siteName\":{\"type\":\"string\"},\"riskLevel\":{\"type\":\"string\"},\"totalRainfallMm\":{\"type\":\"number\"},\"inspectionRequested\":{\"type\":\"boolean\"},\"message\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\"},\"siteName\":{\"type\":\"string\"},\"riskLevel\":{\"type\":\"string\"},\"totalRainfallMm\":{\"type\":\"number\"},\"inspectionRequested\":{\"type\":\"boolean\"},\"message\":{\"type\":\"string\"}}}"
                                    }
                                },
                                "output": {
                                    "output": {
                                        "type": "json",
                                        "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"siteId\": {\n      \"type\": \"string\"\n    },\n    \"siteName\": {\n      \"type\": \"string\"\n    },\n    \"riskLevel\": {\n      \"type\": \"string\"\n    },\n    \"totalRainfallMm\": {\n      \"type\": \"number\"\n    },\n    \"inspectionRequested\": {\n      \"type\": \"boolean\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                                        "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"siteId\": {\n      \"type\": \"string\"\n    },\n    \"siteName\": {\n      \"type\": \"string\"\n    },\n    \"riskLevel\": {\n      \"type\": \"string\"\n    },\n    \"totalRainfallMm\": {\n      \"type\": \"number\"\n    },\n    \"inspectionRequested\": {\n      \"type\": \"boolean\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "Return",
                        "name": "Return",
                        "description": "Return the shaped result",
                        "activity": {
                            "ref": "#actreturn",
                            "settings": {
                                "mappings": {
                                    "response": {
                                        "mapping": {
                                            "data": "=coerce.toString($activity[ShapeResult].output)"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "id": "ReturnBackendError",
                        "name": "ReturnBackendError",
                        "description": "Backend unavailable or returned an error",
                        "activity": {
                            "ref": "#actreturn",
                            "settings": {
                                "mappings": {
                                    "response": {
                                        "mapping": {
                                            "error": "=string.concat(\"Rainfall Risk API (Lab 1) failed: \", $error[CallRainfallRiskAPI].message)"
                                        }
                                    }
                                }
                            }
                        }
                    }
                ],
                "fe_metadata": "",
                "metadata": {
                    "input": [
                        {
                            "name": "arguments",
                            "type": "object",
                            "schema": {
                                "type": "json",
                                "value": "{\"siteId\":{\"type\":\"string\",\"description\":\"Sydney Water site ID, e.g. PS-102\"},\"siteName\":{\"type\":\"string\",\"description\":\"Site name, e.g. Parramatta Sewage Pumping Station SP0102\"},\"latitude\":{\"type\":\"number\",\"description\":\"Site latitude in decimal degrees; Greater Sydney only (-34.2 to -33.3)\"},\"longitude\":{\"type\":\"number\",\"description\":\"Site longitude in decimal degrees; Greater Sydney only (150.5 to 151.4)\"},\"forecastDays\":{\"type\":\"integer\",\"description\":\"Number of forecast days to assess, 1 to 7\"}}"
                            }
                        },
                        {
                            "name": "httpHeaders",
                            "type": "params"
                        }
                    ],
                    "output": [
                        {
                            "name": "response",
                            "type": "object",
                            "schema": {
                                "type": "json",
                                "value": "{\"data\":{\"type\":\"string\"},\"audience\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"priority\":{\"type\":\"number\"},\"error\":{\"type\":\"string\"}}"
                            }
                        },
                        {
                            "name": "structuredContent",
                            "type": "object"
                        }
                    ],
                    "fe_metadata": {
                        "input": "{\"type\":\"object\",\"title\":\"MCPServer\",\"properties\":{\"arguments\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"siteId\":{\"type\":\"string\",\"description\":\"Sydney Water site ID, e.g. PS-102\"},\"siteName\":{\"type\":\"string\",\"description\":\"Site name, e.g. Parramatta Sewage Pumping Station SP0102\"},\"latitude\":{\"type\":\"number\",\"description\":\"Site latitude in decimal degrees; Greater Sydney only (-34.2 to -33.3)\"},\"longitude\":{\"type\":\"number\",\"description\":\"Site longitude in decimal degrees; Greater Sydney only (150.5 to 151.4)\"},\"forecastDays\":{\"type\":\"integer\",\"description\":\"Number of forecast days to assess, 1 to 7\"}},\"required\":[\"siteId\",\"siteName\",\"latitude\",\"longitude\",\"forecastDays\"]},\"httpHeaders\":{\"type\":\"params\"}}}",
                        "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"audience\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"priority\":{\"type\":\"number\"},\"error\":{\"type\":\"string\"}}},\"structuredContent\":{\"type\":\"object\"}},\"required\":[\"response\"]}"
                    }
                }
            }
        },
        {
            "id": "flow:ReportLeak",
            "data": {
                "name": "ReportLeak",
                "description": "MCP tool report_leak",
                "links": [
                    {
                        "id": 1,
                        "from": "ValidateInput",
                        "to": "ReturnRejected",
                        "type": "expression",
                        "label": "ValidateInput to ReturnRejected",
                        "value": "$activity[ValidateInput].output.rejectReason != \"\""
                    },
                    {
                        "id": 2,
                        "from": "ValidateInput",
                        "to": "MaskPII",
                        "type": "exprOtherwise",
                        "label": "ValidateInput to MaskPII"
                    },
                    {
                        "id": 3,
                        "from": "MaskPII",
                        "to": "LogForward",
                        "type": "label",
                        "label": "MaskPII to LogForward"
                    },
                    {
                        "id": 4,
                        "from": "LogForward",
                        "to": "CallLeakReportAPI",
                        "type": "label",
                        "label": "LogForward to CallLeakReportAPI"
                    },
                    {
                        "id": 5,
                        "from": "CallLeakReportAPI",
                        "to": "ShapeResult",
                        "type": "label",
                        "label": "CallLeakReportAPI to ShapeResult"
                    },
                    {
                        "id": 6,
                        "from": "ShapeResult",
                        "to": "Return",
                        "type": "label",
                        "label": "ShapeResult to Return"
                    },
                    {
                        "id": 7,
                        "from": "CallLeakReportAPI",
                        "to": "ReturnBackendError",
                        "type": "error",
                        "label": "CallLeakReportAPI to ReturnBackendError"
                    }
                ],
                "tasks": [
                    {
                        "id": "ValidateInput",
                        "name": "ValidateInput",
                        "description": "Guardrail: validate the arguments before calling the backend",
                        "activity": {
                            "ref": "#mapper",
                            "input": {
                                "input": {
                                    "mapping": {
                                        "rejectReason": "=string.matchRegEx(\"^LR-[0-9]{4}$\", $flow.arguments.reportId) == false ? string.concat(\"reportId must look like LR-1234 (got \", $flow.arguments.reportId, \")\") : (($flow.arguments.severity != \"HIGH\" && $flow.arguments.severity != \"MEDIUM\" && $flow.arguments.severity != \"LOW\") ? string.concat(\"severity must be HIGH, MEDIUM or LOW (got \", $flow.arguments.severity, \")\") : ((string.len($flow.arguments.description) < 10 || string.len($flow.arguments.description) > 500) ? \"description must be 10-500 characters\" : \"\"))"
                                    }
                                }
                            },
                            "schemas": {
                                "input": {
                                    "input": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"rejectReason\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"rejectReason\":{\"type\":\"string\"}}}"
                                    }
                                },
                                "output": {
                                    "output": {
                                        "type": "json",
                                        "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"rejectReason\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                                        "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"rejectReason\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "ReturnRejected",
                        "name": "ReturnRejected",
                        "description": "Reject without calling the backend",
                        "activity": {
                            "ref": "#actreturn",
                            "settings": {
                                "mappings": {
                                    "response": {
                                        "mapping": {
                                            "error": "=string.concat(\"Rejected by guardrail: \", $activity[ValidateInput].output.rejectReason)"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "id": "MaskPII",
                        "name": "MaskPII",
                        "description": "Guardrail: redact phone numbers and emails before the description leaves this server",
                        "activity": {
                            "ref": "#mapper",
                            "input": {
                                "input": {
                                    "mapping": {
                                        "description": "=string.replaceRegEx(\"([+]61[ ]?|0)4[0-9]{2}[ -]?[0-9]{3}[ -]?[0-9]{3}|([(]0[2378][)]|0[2378]|[+]61[ ]?[2378])[ -]?[0-9]{4}[ -]?[0-9]{4}\", string.replaceRegEx(\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}\", $flow.arguments.description, \"[redacted]\"), \"[redacted]\")"
                                    }
                                }
                            },
                            "schemas": {
                                "input": {
                                    "input": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"description\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"description\":{\"type\":\"string\"}}}"
                                    }
                                },
                                "output": {
                                    "output": {
                                        "type": "json",
                                        "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"description\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                                        "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"description\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "LogForward",
                        "name": "LogForward",
                        "description": "Log what is sent to Lab 2 (masked)",
                        "activity": {
                            "ref": "#log",
                            "input": {
                                "Log Level": "INFO",
                                "flowInfo": false,
                                "message": "=string.concat(\"report_leak \", $flow.arguments.reportId, \" forwarded to Lab 2 with description: \", $activity[MaskPII].output.description)",
                                "logLevel": ""
                            },
                            "schemas": {
                                "input": {
                                    "dynamicLogFields": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "CallLeakReportAPI",
                        "name": "CallLeakReportAPI",
                        "description": "Call the Lab 2 Leak Report API",
                        "settings": {
                            "retryOnError": {
                                "count": 0,
                                "interval": 0
                            }
                        },
                        "activity": {
                            "ref": "#rest",
                            "input": {
                                "swagger": "",
                                "authorization": false,
                                "authorizationConn": "",
                                "serviceName": "",
                                "resourcePath": "",
                                "Method": "POST",
                                "Uri": "=$property[\"Lab2.LeakReportURL\"]",
                                "requestType": "application/json",
                                "Use certificate for verification": false,
                                "mutualAuth": false,
                                "Client Certificate": "",
                                "Client Key": "",
                                "Server Certificate": "",
                                "disableSSLVerification": false,
                                "disableKeepAlives": false,
                                "followRedirects": true,
                                "Timeout": 0,
                                "proxy": "",
                                "host": "",
                                "body": {
                                    "mapping": {
                                        "reportId": "=$flow.arguments.reportId",
                                        "address": "=$flow.arguments.address",
                                        "suburb": "=$flow.arguments.suburb",
                                        "description": "=$activity[MaskPII].output.description",
                                        "severity": "=$flow.arguments.severity"
                                    }
                                }
                            },
                            "output": {
                                "configureResponseCodes": false,
                                "throwError": true,
                                "responseType": "application/json",
                                "responseOutput": "JSON Object"
                            },
                            "schemas": {
                                "input": {
                                    "headers": {
                                        "type": "json",
                                        "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                                        "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                                    },
                                    "dynamicRequestHeaders": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                                    },
                                    "body": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\"},\"address\":{\"type\":\"string\"},\"suburb\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"severity\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\"},\"address\":{\"type\":\"string\"},\"suburb\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"severity\":{\"type\":\"string\"}}}"
                                    }
                                },
                                "output": {
                                    "responseBody": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\"},\"workOrderRef\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\"},\"workOrderRef\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}"
                                    },
                                    "headers": {
                                        "type": "json",
                                        "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Set-Cookie\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                                        "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Set-Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "ShapeResult",
                        "name": "ShapeResult",
                        "description": "Guardrail: return only the documented fields",
                        "activity": {
                            "ref": "#mapper",
                            "input": {
                                "input": {
                                    "mapping": {
                                        "reportId": "=$activity[CallLeakReportAPI].responseBody.reportId",
                                        "workOrderRef": "=$activity[CallLeakReportAPI].responseBody.workOrderRef",
                                        "priority": "=$activity[CallLeakReportAPI].responseBody.priority",
                                        "status": "=$activity[CallLeakReportAPI].responseBody.status"
                                    }
                                }
                            },
                            "schemas": {
                                "input": {
                                    "input": {
                                        "type": "json",
                                        "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\"},\"workOrderRef\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}",
                                        "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\"},\"workOrderRef\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}"
                                    }
                                },
                                "output": {
                                    "output": {
                                        "type": "json",
                                        "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"reportId\": {\n      \"type\": \"string\"\n    },\n    \"workOrderRef\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                                        "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"reportId\": {\n      \"type\": \"string\"\n    },\n    \"workOrderRef\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                                    }
                                }
                            },
                            "feSchemaMap": {}
                        }
                    },
                    {
                        "id": "Return",
                        "name": "Return",
                        "description": "Return the shaped result",
                        "activity": {
                            "ref": "#actreturn",
                            "settings": {
                                "mappings": {
                                    "response": {
                                        "mapping": {
                                            "data": "=coerce.toString($activity[ShapeResult].output)"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "id": "ReturnBackendError",
                        "name": "ReturnBackendError",
                        "description": "Backend unavailable or returned an error",
                        "activity": {
                            "ref": "#actreturn",
                            "settings": {
                                "mappings": {
                                    "response": {
                                        "mapping": {
                                            "error": "=string.concat(\"Leak Report API (Lab 2) failed: \", $error[CallLeakReportAPI].message)"
                                        }
                                    }
                                }
                            }
                        }
                    }
                ],
                "fe_metadata": "",
                "metadata": {
                    "input": [
                        {
                            "name": "arguments",
                            "type": "object",
                            "schema": {
                                "type": "json",
                                "value": "{\"reportId\":{\"type\":\"string\",\"description\":\"Leak report ID: LR- followed by 4 digits, e.g. LR-2001\"},\"address\":{\"type\":\"string\",\"description\":\"Street address of the leak, e.g. 12 Church St\"},\"suburb\":{\"type\":\"string\",\"description\":\"Suburb, e.g. Parramatta\"},\"description\":{\"type\":\"string\",\"description\":\"What the reporter observed, in their words (10-500 characters)\"},\"severity\":{\"type\":\"string\",\"description\":\"HIGH, MEDIUM or LOW\"}}"
                            }
                        },
                        {
                            "name": "httpHeaders",
                            "type": "params"
                        }
                    ],
                    "output": [
                        {
                            "name": "response",
                            "type": "object",
                            "schema": {
                                "type": "json",
                                "value": "{\"data\":{\"type\":\"string\"},\"audience\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"priority\":{\"type\":\"number\"},\"error\":{\"type\":\"string\"}}"
                            }
                        },
                        {
                            "name": "structuredContent",
                            "type": "object"
                        }
                    ],
                    "fe_metadata": {
                        "input": "{\"type\":\"object\",\"title\":\"MCPServer\",\"properties\":{\"arguments\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"reportId\":{\"type\":\"string\",\"description\":\"Leak report ID: LR- followed by 4 digits, e.g. LR-2001\"},\"address\":{\"type\":\"string\",\"description\":\"Street address of the leak, e.g. 12 Church St\"},\"suburb\":{\"type\":\"string\",\"description\":\"Suburb, e.g. Parramatta\"},\"description\":{\"type\":\"string\",\"description\":\"What the reporter observed, in their words (10-500 characters)\"},\"severity\":{\"type\":\"string\",\"description\":\"HIGH, MEDIUM or LOW\"}},\"required\":[\"reportId\",\"address\",\"suburb\",\"description\",\"severity\"]},\"httpHeaders\":{\"type\":\"params\"}}}",
                        "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"audience\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"priority\":{\"type\":\"number\"},\"error\":{\"type\":\"string\"}}},\"structuredContent\":{\"type\":\"object\"}},\"required\":[\"response\"]}"
                    }
                }
            }
