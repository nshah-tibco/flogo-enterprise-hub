{
  "openapi": "3.0.3",
  "info": {
    "title": "Sydney Water workshop Flogo APIs",
    "version": "1.0.0",
    "description": "The Lab 1 and Lab 2 Flogo REST APIs. Lab 1 listens on port 9999 and Lab 2 on port 9998. FDA create-mcp-skeleton reads only the first server, so after generating, point the leak-reports tool at http://localhost:9998 (see presenter-demo.md). The per-path servers below document the real endpoints; FDA ignores them."
  },
  "servers": [
    {
      "url": "http://localhost:9999",
      "description": "Lab 1 SW_RainfallRisk (FDA uses this first server as API_Endpoint for every tool)"
    },
    {
      "url": "http://localhost:9998",
      "description": "Lab 2 SW_LeakReport"
    }
  ],
  "paths": {
    "/rainfall-risk/assessments": {
      "post": {
        "operationId": "assessRainfallRisk",
        "summary": "Assess rainfall risk for a site",
        "description": "Lab 1 SW_RainfallRisk: sums the forecast rainfall for the site and raises an inspection in Field Service when the risk is MEDIUM or HIGH.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "http://localhost:9999"
        }
      ]
    },
    "/leak-reports": {
      "post": {
        "operationId": "createLeakReport",
        "summary": "Log a water leak report",
        "description": "Lab 2 SW_LeakReport: creates a work order in Field Service (HIGH=P1, MEDIUM=P2, LOW=P3).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeakReport"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeakReportReceipt"
                }
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "http://localhost:9998"
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "AssessmentRequest": {
        "type": "object",
        "required": [
          "siteId",
          "siteName",
          "latitude",
          "longitude",
          "forecastDays"
        ],
        "properties": {
          "siteId": {
            "type": "string",
            "example": "PS-102"
          },
          "siteName": {
            "type": "string",
            "example": "Parramatta Sewage Pumping Station SP0102"
          },
          "latitude": {
            "type": "number",
            "example": -33.815
          },
          "longitude": {
            "type": "number",
            "example": 151.001
          },
          "forecastDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "example": 3
          }
        }
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string"
          },
          "siteName": {
            "type": "string"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "UNKNOWN"
            ]
          },
          "totalRainfallMm": {
            "type": "number"
          },
          "inspectionRequested": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LeakReport": {
        "type": "object",
        "required": [
          "reportId",
          "address",
          "suburb",
          "description",
          "severity"
        ],
        "properties": {
          "reportId": {
            "type": "string",
            "example": "LR-2001"
          },
          "address": {
            "type": "string",
            "example": "12 Church St"
          },
          "suburb": {
            "type": "string",
            "example": "Parramatta"
          },
          "description": {
            "type": "string",
            "example": "Water bubbling up through the footpath"
          },
          "severity": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      },
      "LeakReportReceipt": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string"
          },
          "workOrderRef": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}