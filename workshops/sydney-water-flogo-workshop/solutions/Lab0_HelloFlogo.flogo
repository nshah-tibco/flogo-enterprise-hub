{
  "imports": [
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "tr_timer github.com/tibco/flogo-general/src/app/General/trigger/timer",
    "act_general_log github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/datetime"
  ],
  "name": "HelloFlogo",
  "description": "Lab 0 - Hello Flogo: a timer trigger and a log message",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {},
      "id": "HelloTimer",
      "name": "HelloTimer",
      "description": "Trigger created with Flogo Design",
      "ref": "#tr_timer",
      "handlers": [
        {
          "settings": {
            "Scheduler Options": "Timer",
            "Start Time": "",
            "Repeating": true,
            "Delayed Start": false,
            "Time Interval": 10,
            "Interval Unit": "Second",
            "Cron Expression": ""
          },
          "action": {
            "input": {},
            "output": {},
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:SayHello"
            }
          },
          "name": "SayHello",
          "description": "Run SayHello every 10 seconds",
          "reply": {}
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:SayHello",
      "data": {
        "name": "SayHello",
        "description": "Logs a greeting every 10 seconds",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogHello",
            "type": "label",
            "label": "StartActivity to LogHello"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat($property[\"Greeting.Message\"], \" - \", datetime.format(datetime.now(), \"YYYY-MM-DD hh:mm:ss\"))",
                "logLevel": ""
              },
              "ref": "#act_general_log"
            },
            "id": "LogHello",
            "name": "LogHello",
            "description": "General tibco-wi-log Activity"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"HelloTimer\",\"properties\":{}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{}}"
          }
        }
      }
    }
  ],
  "properties": [
    {
      "name": "Greeting.Message",
      "type": "string",
      "value": "Hello Sydney Water from Flogo"
    }
  ],
  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [],
    "flogoVersion": "2.26.6"
  }
}