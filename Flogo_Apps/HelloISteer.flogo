{
  "imports": [
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "tr_timer github.com/tibco/flogo-general/src/app/General/trigger/timer",
    "act_general_log github.com/tibco/flogo-general/src/app/General/activity/log"
  ],
  "name": "HelloISteer",
  "description": "Flogo Project created with Flogo Design",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {},
      "id": "TimerTrigger",
      "name": "TimerTrigger",
      "description": "Fires periodically",
      "ref": "#tr_timer",
      "handlers": [
        {
          "settings": {
            "Scheduler Options": "Timer",
            "Start Time": "",
            "Repeating": false,
            "Delayed Start": false,
            "Time Interval": 1,
            "Interval Unit": "Second",
            "Cron Expression": ""
          },
          "action": {
            "input": {},
            "output": {},
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:HelloFlow"
            }
          },
          "name": "HelloFlow",
          "description": "Timer handler for HelloFlow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:HelloFlow",
      "data": {
        "name": "HelloFlow",
        "description": "Flogo Flow created with Flogo Design",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Hello iSteer team",
                "logLevel": ""
              },
              "ref": "#act_general_log"
            },
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "General tibco-wi-log Activity"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        }
      }
    }
  ],
  "properties": [],
  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [],
    "flogoVersion": "2.26.6"
  }
}