                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"isbn\",\n    \"name\",\n    \"authorName\",\n    \"price\"\n  ],\n  \"properties\": {\n    \"isbn\": {\n      \"type\": \"string\",\n      \"description\": \"International Standard Book Number\",\n      \"example\": \"1451648537\"\n    },\n    \"name\": {\n      \"type\": \"string\",\n      \"description\": \"Title of the book\",\n      \"example\": \"Steve Jobs\"\n    },\n    \"description\": {\n      \"type\": \"string\",\n      \"description\": \"Brief description of the book\",\n      \"example\": \"Biography of Apple Co-Founder Steve Jobs\"\n    },\n    \"authorName\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the author\",\n      \"example\": \"Walter Isaacson\"\n    },\n    \"releaseDate\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Original release date of the book (YYYY-MM-DD)\",\n      \"example\": \"2012-10-24\"\n    },\n    \"vintage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"true\",\n        \"false\"\n      ],\n      \"description\": \"Whether the book is a vintage edition\",\n      \"example\": \"false\"\n    },\n    \"signed\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"true\",\n        \"false\"\n      ],\n      \"description\": \"Whether the book is signed by the author\",\n      \"example\": \"false\"\n    },\n    \"price\": {\n      \"type\": \"string\",\n      \"description\": \"Price of the book in USD\",\n      \"example\": \"21.00\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"isbn\",\n    \"name\",\n    \"authorName\",\n    \"price\"\n  ],\n  \"properties\": {\n    \"isbn\": {\n      \"type\": \"string\",\n      \"description\": \"International Standard Book Number\",\n      \"example\": \"1451648537\"\n    },\n    \"name\": {\n      \"type\": \"string\",\n      \"description\": \"Title of the book\",\n      \"example\": \"Steve Jobs\"\n    },\n    \"description\": {\n      \"type\": \"string\",\n      \"description\": \"Brief description of the book\",\n      \"example\": \"Biography of Apple Co-Founder Steve Jobs\"\n    },\n    \"authorName\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the author\",\n      \"example\": \"Walter Isaacson\"\n    },\n    \"releaseDate\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Original release date of the book (YYYY-MM-DD)\",\n      \"example\": \"2012-10-24\"\n    },\n    \"vintage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"true\",\n        \"false\"\n      ],\n      \"description\": \"Whether the book is a vintage edition\",\n      \"example\": \"false\"\n    },\n    \"signed\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"true\",\n        \"false\"\n      ],\n      \"description\": \"Whether the book is signed by the author\",\n      \"example\": \"false\"\n    },\n    \"price\": {\n      \"type\": \"string\",\n      \"description\": \"Price of the book in USD\",\n      \"example\": \"21.00\"\n    }\n  }\n}"
              }
