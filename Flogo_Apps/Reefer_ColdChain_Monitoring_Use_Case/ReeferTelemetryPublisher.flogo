                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"TelemetryTopic\"]",
                "partition": 0,
                "key": "=coerce.toString(json.get(coerce.toObject(array.get($activity[BuildReadings].output.readings, 2)), \"container_id\"))",
                "stringValue": "=array.get($activity[BuildReadings].output.readings, 2)",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "Publish4",
            "name": "Publish4",
            "description": "Publish RCON-1004 dairy reading (normal)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://60a5c415-16b9-469d-98bc-883d75ec0beb",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
                "compressionType": "None",
                "valueType": "String",
                "subjects": "",
                "versions": 0,
                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"TelemetryTopic\"]",
                "partition": 0,
                "key": "=coerce.toString(json.get(coerce.toObject(array.get($activity[BuildReadings].output.readings, 3)), \"container_id\"))",
                "stringValue": "=array.get($activity[BuildReadings].output.readings, 3)",
                "jsonValue": {
