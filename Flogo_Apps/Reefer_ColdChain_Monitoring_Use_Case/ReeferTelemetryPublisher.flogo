        "caCert": "=$property[\"Kafka.ReeferKafka.CA_or_Server_Certificate\"]",
        "connectionTimeout": "=$property[\"Kafka.ReeferKafka.Connection_Timeout\"]",
        "retryBackoff": "=$property[\"Kafka.ReeferKafka.Retry_Backoff\"]",
        "retryMax": "=$property[\"Kafka.ReeferKafka.Max_Retry\"]",
        "refreshFrequency": "=$property[\"Kafka.ReeferKafka.Refresh_Frequency\"]",
