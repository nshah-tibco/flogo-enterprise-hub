                "frequency": 100,
                "topic": "=$property[\"TelemetryTopic\"]",
                "partition": 0,
                "key": "=coerce.toString(json.get(coerce.toObject(array.get($activity[BuildReadings].output.readings, 4)), \"container_id\"))",
                "stringValue": "=array.get($activity[BuildReadings].output.readings, 4)",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkJ1aWxkUmVhZGluZ3MiOnsieCI6MjUwLCJ5Ijo0NX0sIlB1Ymxpc2gxIjp7IngiOjQ1MCwieSI6NDV9LCJQdWJsaXNoMiI6eyJ4Ijo2NTAsInkiOjQ1fSwiUHVibGlzaDMiOnsieCI6MjUwLCJ5IjoxOTV9LCJQdWJsaXNoNCI6eyJ4Ijo0NTAsInkiOjE5NX0sIlB1Ymxpc2g1Ijp7IngiOjY1MCwieSI6MTk1fX0=",
        "metadata": {
