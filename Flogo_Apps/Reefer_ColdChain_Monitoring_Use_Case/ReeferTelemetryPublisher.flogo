{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/activity/producer",
    "github.com/tibco/flogo-general/src/app/General/trigger/timer",
    "github.com/project-flogo/contrib/function/datetime",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/array",
    "github.com/project-flogo/contrib/function/json",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/connector/kafka"
  ],
  "name": "ReeferTelemetryPublisher",
  "description": "Reefer cold-chain telemetry producer: timer-driven simulator publishing container telemetry to Kafka",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#timer",
      "name": "tibco-wi-timer",
      "description": "Fires periodically to publish reefer telemetry",
      "settings": {},
      "id": "PublishTimer",
      "handlers": [
        {
          "description": "Timer-driven: build a batch of reefer telemetry readings and publish each to Kafka",
          "settings": {
            "Scheduler Options": "Timer",
            "Start Time": "",
            "Repeating": true,
            "Delayed Start": false,
            "Time Interval": "=$property[\"PublishInterval_sec\"]",
            "Interval Unit": "Second",
            "Cron Expression": "CRON_TZ=Asia/Calcutta * * * * *"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:PublishTelemetryFlow"
            }
          },
          "name": "PublishTelemetryFlow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:PublishTelemetryFlow",
      "data": {
        "name": "PublishTelemetryFlow",
        "description": "Timer-driven: build a batch of reefer telemetry readings and publish each to Kafka",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildReadings",
            "type": "label",
            "label": "StartActivity to BuildReadings"
          },
          {
            "id": 2,
            "from": "BuildReadings",
            "to": "Publish1",
            "type": "label",
            "label": "BuildReadings to Publish1"
          },
          {
            "id": 3,
            "from": "Publish1",
            "to": "Publish2",
            "type": "label",
            "label": "Publish1 to Publish2"
          },
          {
            "id": 4,
            "from": "Publish2",
            "to": "Publish3",
            "type": "label",
            "label": "Publish2 to Publish3"
          },
          {
            "id": 5,
            "from": "Publish3",
            "to": "Publish4",
            "type": "label",
            "label": "Publish3 to Publish4"
          },
          {
            "id": 6,
            "from": "Publish4",
            "to": "Publish5",
            "type": "label",
            "label": "Publish4 to Publish5"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildReadings",
            "name": "BuildReadings",
            "description": "Build a batch of reefer telemetry readings (JSON strings)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "readings": "=array.create(\"{\\\"container_id\\\":\\\"RCON-1001\\\",\\\"temperature_c\\\":-20.1,\\\"humidity_pct\\\":62,\\\"power_status\\\":\\\"ON\\\",\\\"latitude\\\":1.264,\\\"longitude\\\":103.84,\\\"event_time\\\":\\\"\"+coerce.toString(datetime.currentDatetime())+\"\\\"}\", \"{\\\"container_id\\\":\\\"RCON-1002\\\",\\\"temperature_c\\\":-8.0,\\\"humidity_pct\\\":58,\\\"power_status\\\":\\\"ON\\\",\\\"latitude\\\":1.265,\\\"longitude\\\":103.842,\\\"event_time\\\":\\\"\"+coerce.toString(datetime.currentDatetime())+\"\\\"}\", \"{\\\"container_id\\\":\\\"RCON-1003\\\",\\\"temperature_c\\\":13.2,\\\"humidity_pct\\\":85,\\\"power_status\\\":\\\"OFF\\\",\\\"latitude\\\":1.266,\\\"longitude\\\":103.844,\\\"event_time\\\":\\\"\"+coerce.toString(datetime.currentDatetime())+\"\\\"}\", \"{\\\"container_id\\\":\\\"RCON-1004\\\",\\\"temperature_c\\\":4.2,\\\"humidity_pct\\\":70,\\\"power_status\\\":\\\"ON\\\",\\\"latitude\\\":1.267,\\\"longitude\\\":103.846,\\\"event_time\\\":\\\"\"+coerce.toString(datetime.currentDatetime())+\"\\\"}\", \"{\\\"container_id\\\":\\\"RCON-1005\\\",\\\"temperature_c\\\":9.3,\\\"humidity_pct\\\":52,\\\"power_status\\\":\\\"ON\\\",\\\"latitude\\\":1.268,\\\"longitude\\\":103.848,\\\"event_time\\\":\\\"\"+coerce.toString(datetime.currentDatetime())+\"\\\"}\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://TelemetryBatch"
                },
                "output": {
                  "output": "schema://TelemetryBatch"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Publish1",
            "name": "Publish1",
            "description": "Publish RCON-1001 vaccines reading (normal)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://60a5c415-16b9-469d-98bc-883d75ec0beb",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
                "compressionType": "None",
                "valueType": "String",
                "subjects": "",
                "versions": 0,
                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"TelemetryTopic\"]",
                "partition": 0,
                "key": "=coerce.toString(json.get(coerce.toObject(array.get($activity[BuildReadings].output.readings, 0)), \"container_id\"))",
                "stringValue": "=array.get($activity[BuildReadings].output.readings, 0)",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "Publish2",
            "name": "Publish2",
            "description": "Publish RCON-1002 seafood reading (breach: too warm)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://60a5c415-16b9-469d-98bc-883d75ec0beb",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
                "compressionType": "None",
                "valueType": "String",
                "subjects": "",
                "versions": 0,
                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"TelemetryTopic\"]",
                "partition": 0,
                "key": "=coerce.toString(json.get(coerce.toObject(array.get($activity[BuildReadings].output.readings, 1)), \"container_id\"))",
                "stringValue": "=array.get($activity[BuildReadings].output.readings, 1)",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "Publish3",
            "name": "Publish3",
            "description": "Publish RCON-1003 produce reading (breach: power off)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
