            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://60a5c415-16b9-469d-98bc-883d75ec0beb",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
