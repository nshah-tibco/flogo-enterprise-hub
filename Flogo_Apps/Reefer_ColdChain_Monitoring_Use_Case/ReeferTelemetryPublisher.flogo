        }
      }
    }
  ],
  "properties": [
    {
      "name": "TelemetryTopic",
      "type": "string",
      "value": "reefer.telemetry"
    },
    {
      "name": "PublishInterval_sec",
      "type": "float64",
      "value": 10
    },
    {
      "name": "Kafka.ReeferKafka.Brokers",
      "type": "string",
      "value": "gasdflgflogo301.dev.tibco.com:9093"
    },
    {
      "name": "Kafka.ReeferKafka.Connection_Timeout",
      "type": "float64",
      "value": 30
    },
    {
      "name": "Kafka.ReeferKafka.Retry_Backoff",
      "type": "float64",
      "value": 250
    },
    {
      "name": "Kafka.ReeferKafka.Max_Retry",
      "type": "float64",
      "value": 3
    },
    {
      "name": "Kafka.ReeferKafka.Refresh_Frequency",
      "type": "float64",
      "value": 40
    },
    {
      "name": "Kafka.ReeferKafka.Client_Certificate",
      "type": "string",
      "value": {
        "filename": "client.crt.pem",
        "content": "data:application/octet-stream;base64,"
      }
    },
    {
      "name": "Kafka.ReeferKafka.Client_Key",
      "type": "string",
      "value": {
