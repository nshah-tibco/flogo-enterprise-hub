      }
    }
  ],
  "schemas": {
    "TelemetryBatch": {
      "type": "json",
      "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"readings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}",
      "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"readings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}"
    }
  },
  "connections": {
    "60a5c415-16b9-469d-98bc-883d75ec0beb": {
      "id": "60a5c415-16b9-469d-98bc-883d75ec0beb",
      "name": "ReeferKafka",
      "ref": "#kafka",
      "isGlobal": false,
      "settings": {
        "name": "ReeferKafka",
        "description": "Your kafka Connector",
        "brokers": "=$property[\"Kafka.ReeferKafka.Brokers\"]",
        "authMode": "SSL",
        "userName": "",
