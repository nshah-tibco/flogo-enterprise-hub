{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/activity/producer",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/trigger/consumer",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/json",
    "github.com/project-flogo/contrib/function/array",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/connector/kafka",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "ReeferMonitorProcessor",
  "description": "Flogo Project created with Flogo Design",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#consumer",
      "name": "tibco-kafka-consumer-trigger",
      "description": "Kafka consumer for reefer telemetry",
      "settings": {
        "kafkaConnection": "conn://df18ab49-b84b-4115-97c1-f25ace58a80d"
      },
      "id": "ReeferConsumer",
      "handlers": [
        {
          "description": "Flogo Flow created with Flogo Design",
          "settings": {
            "topic": "=$property[\"TelemetryTopic\"]",
            "customPartition": false,
            "partitionId": 0,
            "topicPattern": "",
            "consumerGroup": "=$property[\"ConsumerGroup\"]",
            "valueType": "String",
            "subjects": "",
            "versions": 0,
            "commitInterval": 5000,
            "initialOffset": "Oldest",
            "seekOffset": 0,
            "timeStamp": "",
            "fetchMinBytes": 1,
            "fetchMaxWait": 500,
            "heartbeatInterval": 3000,
            "sessionTimeout": 30000
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ProcessTelemetryFlow"
            },
            "input": {
              "topic": "=$.topic",
              "partition": "=$.partition",
              "offset": "=$.offset",
              "key": "=$.key",
              "stringValue": "=$.stringValue",
              "jsonValue": "=$.jsonValue",
              "avroData": "=$.avroData",
              "headers": "=$.headers"
            }
          },
          "name": "ProcessTelemetryFlow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:ProcessTelemetryFlow",
      "data": {
        "name": "ProcessTelemetryFlow",
        "description": "Flogo Flow created with Flogo Design",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ParseTelemetry",
            "type": "label",
            "label": "StartActivity to ParseTelemetry"
          },
          {
            "id": 2,
            "from": "ParseTelemetry",
            "to": "LookupContainer",
            "type": "label",
            "label": "ParseTelemetry to LookupContainer"
          },
          {
            "id": 3,
            "from": "LookupContainer",
            "to": "EnrichReading",
            "type": "label",
            "label": "LookupContainer to EnrichReading"
          },
          {
            "id": 4,
            "from": "EnrichReading",
            "to": "LogNormal",
            "type": "expression",
            "label": "normal",
            "value": "$activity[EnrichReading].output.powerStatus == \"ON\" && $activity[EnrichReading].output.temperatureC <= $activity[EnrichReading].output.upperLimit && $activity[EnrichReading].output.temperatureC >= $activity[EnrichReading].output.lowerLimit"
          },
          {
            "id": 5,
            "from": "EnrichReading",
            "to": "PublishAlert",
            "type": "expression",
            "label": "breach",
            "value": "$activity[EnrichReading].output.powerStatus != \"ON\" || $activity[EnrichReading].output.temperatureC > $activity[EnrichReading].output.upperLimit || $activity[EnrichReading].output.temperatureC < $activity[EnrichReading].output.lowerLimit"
          },
          {
            "id": 6,
            "from": "PublishAlert",
            "to": "PersistAlert",
            "type": "label",
            "label": "PublishAlert to PersistAlert"
          },
          {
            "id": 7,
            "from": "PersistAlert",
            "to": "LogAlert",
            "type": "label",
            "label": "PersistAlert to LogAlert"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ParseTelemetry",
            "name": "ParseTelemetry",
            "description": "Parse telemetry JSON into typed fields",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "containerId": "=coerce.toString(json.get(coerce.toObject($flow.stringValue), \"container_id\"))",
                    "temperatureC": "=coerce.toFloat64(json.get(coerce.toObject($flow.stringValue), \"temperature_c\"))",
                    "humidityPct": "=coerce.toFloat64(json.get(coerce.toObject($flow.stringValue), \"humidity_pct\"))",
                    "powerStatus": "=coerce.toString(json.get(coerce.toObject($flow.stringValue), \"power_status\"))",
                    "latitude": "=coerce.toFloat64(json.get(coerce.toObject($flow.stringValue), \"latitude\"))",
                    "longitude": "=coerce.toFloat64(json.get(coerce.toObject($flow.stringValue), \"longitude\"))",
                    "eventTime": "=coerce.toString(json.get(coerce.toObject($flow.stringValue), \"event_time\"))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ReeferTelemetry"
                },
                "output": {
                  "output": "schema://ReeferTelemetry"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LookupContainer",
            "name": "LookupContainer",
            "description": "Lookup container reference + thresholds",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://d1cb0507-7eca-4e50-80b4-ee785c19927b",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT set_point_c, allowed_deviation_c, cargo_type, customer_name, destination_port, priority FROM reefer_containers WHERE container_id = ?containerId;",
                "manualmode": false,
                "fetchMetadata": "",
                "Fields": [
                  {
                    "FieldName": "containerId",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "set_point_c",
                    "Type": "NUMERIC",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "allowed_deviation_c",
                    "Type": "NUMERIC",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "cargo_type",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "customer_name",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "destination_port",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "priority",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "861b2eae-efa2-4346-b535-c1e0e0754de1SELECT set_point_c, allowed_deviation_c, cargo_type, customer_name, destination_port, priority FROM reefer_containers WHERE container_id = ?containerId;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "containerId": "=$activity[ParseTelemetry].output.containerId"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"containerId\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"containerId\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"set_point_c\":{\"type\":\"number\"},\"allowed_deviation_c\":{\"type\":\"number\"},\"cargo_type\":{\"type\":\"string\"},\"customer_name\":{\"type\":\"string\"},\"destination_port\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"set_point_c\":{\"type\":\"number\"},\"allowed_deviation_c\":{\"type\":\"number\"},\"cargo_type\":{\"type\":\"string\"},\"customer_name\":{\"type\":\"string\"},\"destination_port\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "EnrichReading",
            "name": "EnrichReading",
            "description": "Enrich reading + compute temperature limits",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "containerId": "=$activity[ParseTelemetry].output.containerId",
                    "temperatureC": "=$activity[ParseTelemetry].output.temperatureC",
                    "humidityPct": "=$activity[ParseTelemetry].output.humidityPct",
                    "powerStatus": "=$activity[ParseTelemetry].output.powerStatus",
                    "eventTime": "=$activity[ParseTelemetry].output.eventTime",
                    "cargoType": "=coerce.toString(json.get(array.get($activity[LookupContainer].Output.records, 0), \"cargo_type\"))",
                    "customerName": "=coerce.toString(json.get(array.get($activity[LookupContainer].Output.records, 0), \"customer_name\"))",
                    "destinationPort": "=coerce.toString(json.get(array.get($activity[LookupContainer].Output.records, 0), \"destination_port\"))",
                    "priority": "=coerce.toString(json.get(array.get($activity[LookupContainer].Output.records, 0), \"priority\"))",
                    "setPoint": "=coerce.toFloat64(json.get(array.get($activity[LookupContainer].Output.records, 0), \"set_point_c\"))",
                    "allowedDeviation": "=coerce.toFloat64(json.get(array.get($activity[LookupContainer].Output.records, 0), \"allowed_deviation_c\"))",
                    "upperLimit": "=coerce.toFloat64(json.get(array.get($activity[LookupContainer].Output.records, 0), \"set_point_c\")) + coerce.toFloat64(json.get(array.get($activity[LookupContainer].Output.records, 0), \"allowed_deviation_c\"))",
                    "lowerLimit": "=coerce.toFloat64(json.get(array.get($activity[LookupContainer].Output.records, 0), \"set_point_c\")) - coerce.toFloat64(json.get(array.get($activity[LookupContainer].Output.records, 0), \"allowed_deviation_c\"))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ContainerEnriched"
                },
                "output": {
                  "output": "schema://ContainerEnriched"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogNormal",
            "name": "LogNormal",
            "description": "Log an in-range reading",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\" [REEFER NORMAL] \"+$activity[EnrichReading].output.containerId+\" (\"+$activity[EnrichReading].output.cargoType+\") temp=\"+coerce.toString($activity[EnrichReading].output.temperatureC)+\"C within [\"+coerce.toString($activity[EnrichReading].output.lowerLimit)+\",\"+coerce.toString($activity[EnrichReading].output.upperLimit)+\"]C power=\"+$activity[EnrichReading].output.powerStatus",
                "logLevel": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "PublishAlert",
            "name": "PublishAlert",
            "description": "Publish breach alert to alerts topic",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://df18ab49-b84b-4115-97c1-f25ace58a80d",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
                "compressionType": "None",
                "valueType": "String",
                "subjects": "",
                "versions": 0,
                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"AlertsTopic\"]",
                "partition": 0,
                "key": "=$activity[EnrichReading].output.containerId",
                "stringValue": "=\"{\\\"container_id\\\":\\\"\"+$activity[EnrichReading].output.containerId+\"\\\",\\\"cargo_type\\\":\\\"\"+$activity[EnrichReading].output.cargoType+\"\\\",\\\"customer_name\\\":\\\"\"+$activity[EnrichReading].output.customerName+\"\\\",\\\"destination_port\\\":\\\"\"+$activity[EnrichReading].output.destinationPort+\"\\\",\\\"priority\\\":\\\"\"+$activity[EnrichReading].output.priority+\"\\\",\\\"temperature_c\\\":\"+coerce.toString($activity[EnrichReading].output.temperatureC)+\",\\\"set_point_c\\\":\"+coerce.toString($activity[EnrichReading].output.setPoint)+\",\\\"upper_limit_c\\\":\"+coerce.toString($activity[EnrichReading].output.upperLimit)+\",\\\"lower_limit_c\\\":\"+coerce.toString($activity[EnrichReading].output.lowerLimit)+\",\\\"power_status\\\":\\\"\"+$activity[EnrichReading].output.powerStatus+\"\\\",\\\"event_time\\\":\\\"\"+$activity[EnrichReading].output.eventTime+\"\\\"}\"",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "PersistAlert",
            "name": "PersistAlert",
            "description": "Persist breach to audit table",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://d1cb0507-7eca-4e50-80b4-ee785c19927b",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO reefer_alerts (container_id, cargo_type, reported_temp_c, set_point_c, deviation_c, power_status, alert_reason, event_time) VALUES (?container_id, ?cargo_type, ?reported_temp_c, ?set_point_c, ?deviation_c, ?power_status, ?alert_reason, ?event_time);",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "container_id",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "cargo_type",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "reported_temp_c",
                    "Type": "NUMERIC",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "set_point_c",
                    "Type": "NUMERIC",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "deviation_c",
                    "Type": "NUMERIC",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "power_status",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "alert_reason",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "event_time",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  }
                ],
                "RuntimeQuery": "",
                "State": "48be4a5b-23ee-4200-8471-3d55d15db6a0INSERT INTO reefer_alerts (container_id, cargo_type, reported_temp_c, set_point_c, deviation_c, power_status, alert_reason, event_time) VALUES (?container_id, ?cargo_type, ?reported_temp_c, ?set_point_c, ?deviation_c, ?power_status, ?alert_reason, ?event_time);",
                "input": {
                  "mapping": {
                    "parameters": {
                      "container_id": "=$activity[EnrichReading].output.containerId",
                      "cargo_type": "=$activity[EnrichReading].output.cargoType",
                      "reported_temp_c": "=$activity[EnrichReading].output.temperatureC",
                      "set_point_c": "=$activity[EnrichReading].output.setPoint",
                      "deviation_c": "=$activity[EnrichReading].output.allowedDeviation",
                      "power_status": "=$activity[EnrichReading].output.powerStatus",
                      "alert_reason": "=\"power=\"+$activity[EnrichReading].output.powerStatus+\", temp=\"+coerce.toString($activity[EnrichReading].output.temperatureC)+\"C, allowed \"+coerce.toString($activity[EnrichReading].output.lowerLimit)+\" to \"+coerce.toString($activity[EnrichReading].output.upperLimit)+\"C, setpoint=\"+coerce.toString($activity[EnrichReading].output.setPoint)+\"C\"",
                      "event_time": "=$activity[EnrichReading].output.eventTime"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}},\"parameters\":{\"type\":\"object\",\"properties\":{\"container_id\":{\"type\":\"string\"},\"cargo_type\":{\"type\":\"string\"},\"reported_temp_c\":{\"type\":\"number\"},\"set_point_c\":{\"type\":\"number\"},\"deviation_c\":{\"type\":\"number\"},\"power_status\":{\"type\":\"string\"},\"alert_reason\":{\"type\":\"string\"},\"event_time\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}},\"parameters\":{\"type\":\"object\",\"properties\":{\"container_id\":{\"type\":\"string\"},\"cargo_type\":{\"type\":\"string\"},\"reported_temp_c\":{\"type\":\"number\"},\"set_point_c\":{\"type\":\"number\"},\"deviation_c\":{\"type\":\"number\"},\"power_status\":{\"type\":\"string\"},\"alert_reason\":{\"type\":\"string\"},\"event_time\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogAlert",
            "name": "LogAlert",
            "description": "Log the breach alert",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\" [REEFER BREACH] \"+$activity[EnrichReading].output.priority+\" \"+$activity[EnrichReading].output.containerId+\" (\"+$activity[EnrichReading].output.cargoType+\") cust=\"+$activity[EnrichReading].output.customerName+\" dest=\"+$activity[EnrichReading].output.destinationPort+\" temp=\"+coerce.toString($activity[EnrichReading].output.temperatureC)+\"C setpoint=\"+coerce.toString($activity[EnrichReading].output.setPoint)+\"C allowed=[\"+coerce.toString($activity[EnrichReading].output.lowerLimit)+\",\"+coerce.toString($activity[EnrichReading].output.upperLimit)+\"]C power=\"+$activity[EnrichReading].output.powerStatus",
                "logLevel": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "topic",
              "type": "string"
            },
            {
              "name": "partition",
              "type": "integer"
            },
            {
              "name": "offset",
              "type": "integer"
            },
            {
              "name": "key",
              "type": "string"
            },
            {
              "name": "stringValue",
              "type": "string"
            },
            {
              "name": "headers",
              "type": "object"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ReeferConsumer\",\"properties\":{\"topic\":{\"type\":\"string\",\"required\":false},\"partition\":{\"type\":\"integer\",\"required\":false},\"offset\":{\"type\":\"integer\",\"required\":false},\"key\":{\"type\":\"string\",\"required\":false},\"stringValue\":{\"type\":\"string\",\"required\":false},\"headers\":{\"type\":\"object\"}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{}}"
          }
        },
        "explicitReply": true
      }
    }
  ],
  "properties": [
    {
      "name": "TelemetryTopic",
      "type": "string",
      "value": "reefer.telemetry"
    },
    {
      "name": "AlertsTopic",
      "type": "string",
      "value": "reefer.alerts"
    },
    {
      "name": "ConsumerGroup",
      "type": "string",
      "value": "reefer-monitor"
    },
    {
      "name": "Kafka.ReeferKafka.Brokers",
      "type": "string",
      "value": "gasdflgflogo301.dev.tibco.com:9093"
    },
