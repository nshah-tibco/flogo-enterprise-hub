  "resources": [
    {
      "id": "flow:GetBook",
      "data": {
        "name": "GetBook",
        "description": "Get book by ID from PostgreSQL",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "QueryBook",
            "type": "label",
            "label": "LogRequest to QueryBook"
          },
          {
            "id": 3,
            "from": "QueryBook",
            "to": "LogResult",
            "type": "label",
            "label": "QueryBook to LogResult"
          },
          {
            "id": 4,
            "from": "LogResult",
            "to": "ReplyBookData",
            "type": "label",
            "label": "LogResult to ReplyBookData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log incoming request",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "string(\"Received request for Book ID: \") + coerce.toString($flow.BookId)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "QueryBook",
            "name": "QueryBook",
            "description": "Query book from PostgreSQL",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://0eb47f2b-a5ac-4b4a-919e-7fa0cb20e533",
                "QueryName": "GetBookById",
                "Schema": "public",
                "Query": "SELECT book_id, title, author FROM books WHERE book_id = ?BookId;",
                "manualmode": false,
                "fetchMetadata": "",
                "Fields": [
                  {
                    "FieldName": "BookId",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "book_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "title",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "author",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "4c4a85b1-933f-49a1-a0dc-369f4bf8e93aSELECT book_id, title, author FROM books WHERE book_id = ?BookId;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "BookId": "=$flow.BookId"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"BookId\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"BookId\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"book_id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"book_id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogResult",
            "name": "LogResult",
            "description": "Log query result",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "string(\"Book data retrieved: \") + coerce.toString($activity[QueryBook].Output)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "ReplyBookData",
            "name": "ReplyBookData",
            "description": "Reply with book data",
            "activity": {
              "ref": "#reply",
              "input": {
                "Reply": "Success with Data",
                "code": 200,
                "message": "",
                "data": {
                  "mapping": {
                    "BookId": "=$activity[QueryBook].Output.records[0].book_id",
                    "Title": "=$activity[QueryBook].Output.records[0].title",
                    "Author": "=$activity[QueryBook].Output.records[0].author"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ1JlcXVlc3QiOnsieCI6MjUwLCJ5Ijo0NX0sIlF1ZXJ5Qm9vayI6eyJ4Ijo0NDksInkiOjQ1fSwiTG9nUmVzdWx0Ijp7IngiOjY1MCwieSI6NDV9LCJSZXBseUJvb2tEYXRhIjp7IngiOjI1MCwieSI6MTk1fX0=",
