{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/activity/producer",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/flogo-general/src/app/General/trigger/rest",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/trigger/consumer",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/json",
    "github.com/project-flogo/contrib/function/array",
    "github.com/tibco/wi-plugins/contributions/kafka/src/app/Kafka/connector/kafka",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "OrderStreamProcessor",
  "description": "Real-time order streaming: ingest from Kafka, enrich from PostgreSQL, route/alert flagged orders",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#rest",
      "name": "tibco-wi-rest",
      "description": "REST feeder for order events",
      "settings": {
        "port": 9999,
        "APISpecUpdate": false,
        "swagger": "spec://303c5749-6362-4d42-a5c2-a6e2eabf32d3",
        "swaggerVersion": "v2",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": ""
      },
      "id": "RestTrigger",
      "handlers": [
        {
          "description": "Publish an order event to the incoming Kafka topic (test feeder)",
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/orders",
            "OutputValidation": false
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:PublishOrderFlow"
            },
            "input": {
              "headers": "=$.headers",
              "body": "=$.body",
              "requestURI": "=$.requestURI",
              "method": "=$.method"
            },
            "output": {
              "code": "=$.code",
              "message": "=$.message"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "message": ""
          },
          "schemas": {
            "reply": {
              "responseBody": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}"
              }
            },
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Authorization\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              },
              "body": "schema://OrderRequest"
            }
          },
          "name": "PublishOrderFlow"
        }
      ]
    },
    {
      "ref": "#consumer",
      "name": "tibco-kafka-consumer-trigger",
      "description": "Consume order events from orders.incoming",
      "settings": {
        "kafkaConnection": "conn://ffc2b8fa-7d9f-4adb-809d-1db4abc8a085"
      },
      "id": "KafkaConsumer",
      "handlers": [
        {
          "description": "Consume order events, enrich from PostgreSQL, and route/alert flagged orders",
          "settings": {
            "topic": "=$property[\"IncomingTopic\"]",
            "customPartition": false,
            "partitionId": 0,
            "topicPattern": "",
            "consumerGroup": "=$property[\"ConsumerGroup\"]",
            "valueType": "String",
            "subjects": "",
            "versions": 0,
            "commitInterval": 5000,
            "initialOffset": "Oldest",
            "seekOffset": 0,
            "timeStamp": "",
            "fetchMinBytes": 1,
            "fetchMaxWait": 500,
            "heartbeatInterval": 3000,
            "sessionTimeout": 30000
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ProcessOrderFlow"
            },
            "input": {
              "topic": "=$.topic",
              "partition": "=$.partition",
              "offset": "=$.offset",
              "key": "=$.key",
              "stringValue": "=$.stringValue",
              "headers": "=$.headers"
            }
          },
          "name": "ProcessOrderFlow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:PublishOrderFlow",
      "data": {
        "name": "PublishOrderFlow",
        "description": "Publish an order event to the incoming Kafka topic (test feeder)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildMessage",
            "type": "label",
            "label": "StartActivity to BuildMessage"
          },
          {
            "id": 2,
            "from": "BuildMessage",
            "to": "PublishIncoming",
            "type": "label",
            "label": "BuildMessage to PublishIncoming"
          },
          {
            "id": 3,
            "from": "PublishIncoming",
            "to": "Return",
            "type": "label",
            "label": "PublishIncoming to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildMessage",
            "name": "BuildMessage",
            "description": "Build order JSON payload",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "payload": "=\"{\\\"order_id\\\":\\\"\"+$flow.body.order_id+\"\\\",\\\"customer_id\\\":\"+coerce.toString($flow.body.customer_id)+\",\\\"amount\\\":\"+coerce.toString($flow.body.amount)+\",\\\"currency\\\":\\\"\"+$flow.body.currency+\"\\\",\\\"items\\\":\"+coerce.toString($flow.body.items)+\",\\\"channel\\\":\\\"\"+$flow.body.channel+\"\\\"}\""
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://OrderMessage"
                },
                "output": {
                  "output": "schema://OrderMessage"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "PublishIncoming",
            "name": "PublishIncoming",
            "description": "Publish order to orders.incoming topic",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://ffc2b8fa-7d9f-4adb-809d-1db4abc8a085",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
                "compressionType": "None",
                "valueType": "String",
                "subjects": "",
                "versions": 0,
                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"IncomingTopic\"]",
                "partition": 0,
                "key": "=$flow.body.order_id",
                "stringValue": "=$activity[BuildMessage].output.payload",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return REST response",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$property[\"HttpStatusCode\"]",
                  "message": "=\"Order \"+$flow.body.order_id+\" published to topic \"+$property[\"IncomingTopic\"]"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkJ1aWxkTWVzc2FnZSI6eyJ4IjoyNTAsInkiOjQ1fSwiUHVibGlzaEluY29taW5nIjp7IngiOjQ1MCwieSI6NDV9LCJSZXR1cm4iOnsieCI6NjUwLCJ5Ijo0NX19",
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object"
            },
            {
              "name": "body",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"order_id\":{\"type\":\"string\"},\"customer_id\":{\"type\":\"integer\"},\"amount\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\"},\"items\":{\"type\":\"integer\"},\"channel\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "requestURI",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "message",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"RestTrigger\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{}},\"body\":{\"type\":\"object\",\"properties\":{\"order_id\":{\"type\":\"string\"},\"customer_id\":{\"type\":\"integer\"},\"amount\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\"},\"items\":{\"type\":\"integer\"},\"channel\":{\"type\":\"string\"}},\"required\":[\"order_id\",\"customer_id\",\"amount\"]},\"requestURI\":{\"type\":\"string\"},\"method\":{\"type\":\"string\"}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:ProcessOrderFlow",
      "data": {
        "name": "ProcessOrderFlow",
        "description": "Consume order events, enrich from PostgreSQL, and route/alert flagged orders",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ParseOrder",
            "type": "label",
            "label": "StartActivity to ParseOrder"
          },
          {
            "id": 2,
            "from": "ParseOrder",
            "to": "LookupCustomer",
            "type": "label",
            "label": "ParseOrder to LookupCustomer"
          },
          {
            "id": 3,
            "from": "LookupCustomer",
            "to": "EnrichCustomer",
            "type": "label",
            "label": "LookupCustomer to EnrichCustomer"
          },
          {
            "id": 4,
            "from": "EnrichCustomer",
            "to": "LogNormal",
            "type": "expression",
            "label": "normal",
            "value": "$activity[ParseOrder].output.amount <= $property[\"HighValueThreshold\"] && $activity[EnrichCustomer].output.tier != \"VIP\" && $activity[EnrichCustomer].output.accountStatus == \"ACTIVE\""
          },
          {
            "id": 5,
            "from": "EnrichCustomer",
            "to": "PublishFlagged",
            "type": "expression",
            "label": "flagged",
            "value": "$activity[ParseOrder].output.amount > $property[\"HighValueThreshold\"] || $activity[EnrichCustomer].output.tier == \"VIP\" || $activity[EnrichCustomer].output.accountStatus != \"ACTIVE\""
          },
          {
            "id": 6,
            "from": "PublishFlagged",
            "to": "PersistFlagged",
            "type": "label",
            "label": "PublishFlagged to PersistFlagged"
          },
          {
            "id": 7,
            "from": "PersistFlagged",
            "to": "LogFlagged",
            "type": "label",
            "label": "PersistFlagged to LogFlagged"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ParseOrder",
            "name": "ParseOrder",
            "description": "Parse incoming order JSON",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "orderId": "=coerce.toString(json.get(coerce.toObject($flow.stringValue), \"order_id\"))",
                    "customerId": "=json.get(coerce.toObject($flow.stringValue), \"customer_id\")",
                    "amount": "=json.get(coerce.toObject($flow.stringValue), \"amount\")",
                    "currency": "=coerce.toString(json.get(coerce.toObject($flow.stringValue), \"currency\"))",
                    "items": "=json.get(coerce.toObject($flow.stringValue), \"items\")",
                    "channel": "=coerce.toString(json.get(coerce.toObject($flow.stringValue), \"channel\"))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://OrderParsed"
                },
                "output": {
                  "output": "schema://OrderParsed"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LookupCustomer",
            "name": "LookupCustomer",
            "description": "Enrich: look up customer",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://0caa1154-f964-485c-8948-60153b8702c1",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT customer_id, name, email, tier, region, account_status, credit_limit FROM customers WHERE customer_id = ?customerId;",
                "manualmode": false,
                "fetchMetadata": "",
                "Fields": [
                  {
                    "FieldName": "customerId",
                    "Type": "INTEGER",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "customer_id",
                    "Type": "INTEGER",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "name",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "email",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "tier",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "region",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "account_status",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "credit_limit",
                    "Type": "NUMERIC",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "503e6ead-de12-4662-82a9-f7a7d8e1e1c7SELECT customer_id, name, email, tier, region, account_status, credit_limit FROM customers WHERE customer_id = ?customerId;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "customerId": "=$activity[ParseOrder].output.customerId"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"customerId\":{\"type\":\"integer\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"customerId\":{\"type\":\"integer\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"customer_id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"tier\":{\"type\":\"string\"},\"region\":{\"type\":\"string\"},\"account_status\":{\"type\":\"string\"},\"credit_limit\":{\"type\":\"number\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"customer_id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"tier\":{\"type\":\"string\"},\"region\":{\"type\":\"string\"},\"account_status\":{\"type\":\"string\"},\"credit_limit\":{\"type\":\"number\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "EnrichCustomer",
            "name": "EnrichCustomer",
            "description": "Extract customer fields",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "customerName": "=coerce.toString(json.get(array.get($activity[LookupCustomer].Output.records, 0), \"name\"))",
                    "tier": "=coerce.toString(json.get(array.get($activity[LookupCustomer].Output.records, 0), \"tier\"))",
                    "region": "=coerce.toString(json.get(array.get($activity[LookupCustomer].Output.records, 0), \"region\"))",
                    "accountStatus": "=coerce.toString(json.get(array.get($activity[LookupCustomer].Output.records, 0), \"account_status\"))",
                    "creditLimit": "=json.get(array.get($activity[LookupCustomer].Output.records, 0), \"credit_limit\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://CustomerEnriched"
                },
                "output": {
                  "output": "schema://CustomerEnriched"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogNormal",
            "name": "LogNormal",
            "description": "Log normal order",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\"Order \"+$activity[ParseOrder].output.orderId+\" processed normally for \"+$activity[EnrichCustomer].output.customerName+\" (tier=\"+$activity[EnrichCustomer].output.tier+\", status=\"+$activity[EnrichCustomer].output.accountStatus+\")\"",
                "logLevel": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "PublishFlagged",
            "name": "PublishFlagged",
            "description": "Publish flagged order to orders.flagged",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#producer",
              "input": {
                "kafkaConnection": "conn://ffc2b8fa-7d9f-4adb-809d-1db4abc8a085",
                "ackMode": "All",
                "ackTimeout": 10000,
                "partitioner": "Hash",
                "compressionType": "None",
                "valueType": "String",
                "subjects": "",
                "versions": 0,
                "maxRequestSize": 1048576,
                "maxMessages": 0,
                "frequency": 100,
                "topic": "=$property[\"FlaggedTopic\"]",
                "partition": 0,
                "key": "=$activity[ParseOrder].output.orderId",
                "stringValue": "=$flow.stringValue",
                "jsonValue": {
                  "mapping": {}
                },
                "avroData": {
                  "mapping": {}
                },
                "headers": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "PersistFlagged",
            "name": "PersistFlagged",
            "description": "Persist flagged order to audit table",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://0caa1154-f964-485c-8948-60153b8702c1",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO flagged_orders (order_id, customer_id, customer_name, amount, tier, account_status, flag_reason) VALUES (?order_id, ?customer_id, ?customer_name, ?amount, ?tier, ?account_status, ?flag_reason);",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "order_id",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "customer_id",
                    "Type": "INTEGER",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "customer_name",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "amount",
                    "Type": "NUMERIC",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "tier",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "account_status",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "flag_reason",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  }
                ],
                "RuntimeQuery": "",
