    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Requests bed cleaning / turnover",
      "settings": {
        "llmProviderConnection": "conn://defc954c-5abb-4a94-979c-7517dbe08f9d",
        "agentName": "bed_turnover_agent",
        "agentDescription": "Requests housekeeping for a vacated bed: sets the bed to CLEANING_REQUESTED with an estimated ready time.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"BedTurnover_A2AServer_PORT\"]",
        "agentUrl": "http://localhost:9103",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": false,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Bed Turnover Agent. When a patient vacates a bed, call your tool with bed_id and ward_id to request cleaning. Return the bed status and estimated ready time. Do not hand over to other agents. Complete within a maximum of 3 attempts."
