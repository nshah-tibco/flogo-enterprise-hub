    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Sends a confirmation email",
      "settings": {
        "llmProviderConnection": "conn://defc954c-5abb-4a94-979c-7517dbe08f9d",
        "agentName": "send_confirmation_email",
        "agentDescription": "Sends a single discharge confirmation email. Recipient is preconfigured; invoke once, last, after the other actions complete.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SendEmail_A2AServer_PORT\"]",
        "agentUrl": "http://localhost:9104",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": false,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": false,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "None",
        "memoryMaxSize": 10,
        "systemPrompt": "You are the Confirmation Email Agent. Call your send tool exactly once with a subject and body summarising the discharge actions (appointment, medications, bed). The recipient is preconfigured, so an email address is optional; never refuse or report failure due to a missing address. Do not hand over to other agents."
      },
      "id": "send_confirmation_email",
      "handlers": [
        {
          "description": "Send confirmation email",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "send_confirmation_email",
            "agentToolDescription": "Send a single confirmation email. Provide subject and body; recipient is preconfigured.",
            "agentSkillTags": "",
