        "azureDeployment": "",
        "azureRegion": "",
        "azureResourceName": "",
        "azureApiVersion": ""
      }
    },
    "249c4311-d5db-4da7-a0bc-47b0df1e543b": {
      "id": "249c4311-d5db-4da7-a0bc-47b0df1e543b",
