{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "HospitalAIOrchestrator",
  "description": "Hospital AI Orchestrator - WebSocket chat routing to MCP tools and A2A agents",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "WebSocket chat server",
      "settings": {
        "port": 8082,
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WS",
      "handlers": [
        {
          "description": "Route chat to MCP tools and A2A agents",
          "settings": {
            "method": "GET",
            "path": "/ws/chat",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "wsconnection": "=$.wsconnection",
              "content": "=$.content"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Key\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Version\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Upgrade\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator_Flow",
        "description": "Route chat to MCP tools and A2A agents",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WriteData",
            "type": "label",
            "label": "AIAgent to WriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "AI orchestrator agent",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://3ba48299-9dba-4f7a-855c-4edcf538d18c",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": false,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://88e28825-0888-4514-af34-922b70ac735b",
                  "conn://231fb637-148c-4358-8e9c-d14cdd8e261e",
                  "conn://7d66039b-eba5-492a-8fae-37ca9eddccda",
                  "conn://db0fa5bb-4188-4d85-b7ce-8764c8ee94b6"
                ],
                "mcpServers": [
                  "conn://249c4311-d5db-4da7-a0bc-47b0df1e543b"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Hospital Post-Discharge Orchestrator. Patients are identified by patient_id (format P-YYYY-NNNNN). Use the read-only MCP tools for lookups: GetDischargeSummary, GetPatientProfile, GetBedStatus, GetAppointments, GetMedicationCatalog, GetPharmacyOrders, GetSpecialties. Use the A2A agents for actions, always confirming before a write: book_appointment (only if follow_up_required; scheduled_date = discharge_date + 7 days, time 10:30, specialty from the discharge summary); create_pharmacy_order (once per prescribed medication; default pickup PHARMACY_A); request_bed_cleaning (bed_id + ward_id when a bed is vacated); send_confirmation_email (exactly once, last, only if requested, summarising the actions taken). For a full discharge, retrieve the discharge summary, then book the appointment, create pharmacy orders, request bed cleaning, and optionally email. Privacy: redact patient identifiers such as P-2024-XXXXX and never expose unnecessary PHI. Politely decline anything outside post-discharge coordination (diagnosis, treatment advice, billing, emergencies). Complete each sub-agent within a maximum of 3 attempts; on failure, report what completed and what failed."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": "",
                "filteredToolNames": {
                  "mapping": []
                }
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WriteData",
            "name": "WriteData",
            "description": "Write response to websocket",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkFJQWdlbnQiOnsieCI6MjUwLCJ5IjoxNTB9LCJXcml0ZURhdGEiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WS\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
  "properties": [
    {
      "name": "AgenticAI.OpenAIConn.LLM_Provider",
      "type": "string",
      "value": "OpenAI"
    },
    {
      "name": "AgenticAI.OpenAIConn.API_Key",
      "type": "string",
      "value": "SECRET:YlqkBiXx1DiuXYdYkmZyGHwKHf1tBDLLFEB+mHr2PKigsCn0I2NzT2WQ4mzUg1al1XY9YFb0TJi/HtMbiGELKs1Jaz4SuFCSjV+I3LBoMU0NS/aUoBmGf3H6k1XAvz/JZ4Lr2dyOmAR5OC/zopEoJpvOONJCgANQCC5AVmA2RKthYGv7Rtz3mErgHOxPKitwNZTHkf3LZkEPj1CIENDnS7CF2SNhKkfCC6bTcPR/i50IGw0I"
    },
    {
