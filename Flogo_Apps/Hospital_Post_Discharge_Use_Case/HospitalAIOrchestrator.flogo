      "type": "string",
      "value": "gpt-5.5"
    }
  ],
  "connections": {
    "3ba48299-9dba-4f7a-855c-4edcf538d18c": {
      "id": "3ba48299-9dba-4f7a-855c-4edcf538d18c",
      "name": "OpenAIConn",
