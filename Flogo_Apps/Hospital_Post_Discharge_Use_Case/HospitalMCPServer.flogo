  "resources": [
    {
      "id": "flow:getDischargeSummary",
      "data": {
        "name": "getDischargeSummary",
        "description": "Get discharge summary with medications",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Query",
            "type": "label",
            "label": "StartActivity to Query"
          },
          {
            "id": 2,
            "from": "Query",
            "to": "Return",
            "type": "label",
            "label": "Query to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Query",
            "name": "Query",
            "description": "Query discharge summary",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT p.patient_id, pd.discharge_id, pd.follow_up_required, pd.specialty_code, pd.discharge_date, pd.ward_id, pd.bed_id, dm.medication_code, dm.days_supply FROM patients p JOIN patient_discharges pd ON p.patient_id = pd.patient_id LEFT JOIN discharge_medications dm ON pd.discharge_id = dm.discharge_id ORDER BY p.patient_id, dm.id;",
                "manualmode": false,
                "fetchMetadata": "",
                "Fields": [],
                "RuntimeQuery": "",
                "State": "",
                "input": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=coerce.toString($activity[Query].Output)"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIlF1ZXJ5Ijp7IngiOjI1MCwieSI6MTUwfSwiUmV0dXJuIjp7IngiOjQ1MCwieSI6MjUwfX0=",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"MCP\",\"properties\":{\"arguments\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        }
      }
