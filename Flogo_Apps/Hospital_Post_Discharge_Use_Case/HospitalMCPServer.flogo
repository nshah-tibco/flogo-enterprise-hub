  "name": "HospitalMCPServer",
  "description": "Hospital BSS MCP Server - read-only lookup tools over PostgreSQL",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Hospital BSS MCP server",
      "settings": {
        "serverName": "HospitalBSS",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/hospital-bss",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "MCP",
      "handlers": [
        {
          "description": "Get discharge summary with medications",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetDischargeSummary",
            "handlerDescription": "Get a patient's discharge summary joined with prescribed medications by patient_id: follow_up_required, specialty_code, discharge_date, ward_id, bed_id, medication_code, days_supply.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getDischargeSummary"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "getDischargeSummary"
        },
