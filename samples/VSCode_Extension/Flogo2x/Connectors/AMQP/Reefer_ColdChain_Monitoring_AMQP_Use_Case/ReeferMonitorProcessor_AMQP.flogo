          {
            "id": "LogAlert",
            "name": "LogAlert",
            "description": "Log the breach alert",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\" [REEFER BREACH] \"+$activity[EnrichReading].output.priority+\" \"+$activity[EnrichReading].output.containerId+\" (\"+$activity[EnrichReading].output.cargoType+\") cust=\"+$activity[EnrichReading].output.customerName+\" dest=\"+$activity[EnrichReading].output.destinationPort+\" temp=\"+coerce.toString($activity[EnrichReading].output.temperatureC)+\"C setpoint=\"+coerce.toString($activity[EnrichReading].output.setPoint)+\"C allowed=[\"+coerce.toString($activity[EnrichReading].output.lowerLimit)+\",\"+coerce.toString($activity[EnrichReading].output.upperLimit)+\"]C power=\"+$activity[EnrichReading].output.powerStatus",
                "logLevel": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "AckBreach",
            "name": "AckBreach",
            "description": "Acknowledge the consumed message (breach path)",
            "activity": {
              "ref": "#acknowledge"
            }
          }
