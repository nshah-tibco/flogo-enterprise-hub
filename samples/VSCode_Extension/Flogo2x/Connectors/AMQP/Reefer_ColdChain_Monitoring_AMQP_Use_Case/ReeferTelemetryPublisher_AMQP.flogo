            "name": "Publish2",
            "description": "Publish RCON-1002 seafood reading (breach: too warm)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#sendmessage",
