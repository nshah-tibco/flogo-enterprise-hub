    "7c2f1a3e-4b5d-4c6e-8f90-1a2b3c4d5e6f": {
      "id": "7c2f1a3e-4b5d-4c6e-8f90-1a2b3c4d5e6f",
      "name": "amqp-1.0-connection",
      "ref": "#amqp",
      "isGlobal": false,
