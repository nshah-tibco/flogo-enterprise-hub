      "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"readings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}",
      "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"readings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}"
