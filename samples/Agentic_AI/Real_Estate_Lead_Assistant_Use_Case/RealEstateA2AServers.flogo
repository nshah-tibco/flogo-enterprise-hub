    {
      "id": "flow:send_confirmation_email_flow",
      "data": {
        "name": "send_confirmation_email_flow",
        "description": "Sends a confirmation or recommendation email to the prospect.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          },
