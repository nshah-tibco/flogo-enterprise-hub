        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "SearchListings",
            "handlerDescription": "Search the property catalog (MLS). Returns listings with address, city, state, zip, price, bedrooms, bathrooms, square footage, property type, status (Active/Pending/Sold), days on market, MLS id, and description. Filter results to the user's city, price range, and bed/bath needs.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
