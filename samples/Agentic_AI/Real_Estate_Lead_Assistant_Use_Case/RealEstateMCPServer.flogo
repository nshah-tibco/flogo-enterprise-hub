  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Real Estate MCP server",
      "settings": {
        "serverName": "RealEstateMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/realestate-mls",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "RealEstateMCPServer",
      "handlers": [
        {
          "description": "Look up a real estate lead&#39;s full CRM profile by lead id (LEAD-2026-NNNNN), email, or phone: name, contact, lead type (Buyer/Seller/Both), funnel stage, budget range, preferred city/zip/beds/baths, property type, timeline, source, and assigned agent id. Use this to recognize the prospect and recall their saved home-search criteria.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetLeadProfile",
            "handlerDescription": "Look up a real estate lead's full CRM profile by lead id (LEAD-2026-NNNNN), email, or phone: name, contact, lead type (Buyer/Seller/Both), funnel stage, budget range, preferred city/zip/beds/baths, property type, timeline, source, and assigned agent id. Use this to recognize the prospect and recall their saved home-search criteria.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getLeads"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://EmptyArgs"
            }
          },
          "name": "getLeads"
        },
        {
          "description": "Return a lead&#39;s engagement history: searches run, listings viewed and saved, emails opened, recommendations sent, and funnel stage changes. Use to understand what a prospect has been looking at.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetLeadActivity",
            "handlerDescription": "Return a lead's engagement history: searches run, listings viewed and saved, emails opened, recommendations sent, and funnel stage changes. Use to understand what a prospect has been looking at.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getLeadActivity"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://EmptyArgs"
            }
          },
          "name": "getLeadActivity"
        },
        {
          "description": "Search the property catalog (MLS). Returns listings with address, city, state, zip, price, bedrooms, bathrooms, square footage, property type, status (Active/Pending/Sold), days on market, MLS id, and description. Filter results to the user&#39;s city, price range, and bed/bath needs.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "SearchListings",
            "handlerDescription": "Search the property catalog (MLS). Returns listings with address, city, state, zip, price, bedrooms, bathrooms, square footage, property type, status (Active/Pending/Sold), days on market, MLS id, and description. Filter results to the user's city, price range, and bed/bath needs.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getListings"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://EmptyArgs"
            }
          },
          "name": "getListings"
        },
        {
          "description": "Return real estate agent details (name, email, phone, brokerage, service area, specialization). Use with a lead&#39;s assigned agent id to tell the prospect who their agent is or to route a follow-up.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetAssignedAgent",
            "handlerDescription": "Return real estate agent details (name, email, phone, brokerage, service area, specialization). Use with a lead's assigned agent id to tell the prospect who their agent is or to route a follow-up.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getAgents"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://EmptyArgs"
            }
          },
          "name": "getAgents"
        },
        {
          "description": "Return a lead&#39;s property showings (appointments): the listing, scheduled date/time, and status (Requested/Confirmed/Completed/Cancelled). Use to tell a prospect what tours they have scheduled.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetLeadAppointments",
            "handlerDescription": "Return a lead's property showings (appointments): the listing, scheduled date/time, and status (Requested/Confirmed/Completed/Cancelled). Use to tell a prospect what tours they have scheduled.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
