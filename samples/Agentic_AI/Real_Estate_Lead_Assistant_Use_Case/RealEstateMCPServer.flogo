            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "getLeadActivity",
          "description": "Return a lead's engagement history: searches run, listings viewed and saved, emails opened, recommendations sent, and funnel stage changes. Use to understand what a prospect has been looking at.",
