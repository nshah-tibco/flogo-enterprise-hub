            }
          },
          "name": "getAppointments"
        },
        {
          "description": "Return residential real-estate market statistics by city and zip: median price, average days on market, active inventory, median price per square foot, and year-over-year price change. Use to answer &#39;how&#39;s the market&#39; questions.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetAreaMarketInsights",
            "handlerDescription": "Return residential real-estate market statistics by city and zip: median price, average days on market, active inventory, median price per square foot, and year-over-year price change. Use to answer 'how's the market' questions.",
            "toolTitle": "",
            "readOnlyToolHint": false,
