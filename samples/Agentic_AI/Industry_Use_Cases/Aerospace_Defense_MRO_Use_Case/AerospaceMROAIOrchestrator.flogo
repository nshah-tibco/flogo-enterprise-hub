{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/array",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "AerospaceMROAIOrchestrator",
  "description": "Aerospace MRO AI Orchestrator",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "WebSocket server",
      "settings": {
        "port": "=$property[\"WebSocket_PORT\"]",
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "Aerospace MRO orchestrator flow",
          "settings": {
            "method": "GET",
            "path": "/mro",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "content": "=$.content",
              "wsconnection": "=$.wsconnection",
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers"
            }
          },
          "schemas": {
            "output": {
              "headers": "schema://OrcWsHeaders"
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator_Flow",
        "description": "Aerospace MRO orchestrator flow",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "AI Agent",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://ef41f229-473d-4006-8b8d-b294eb76b063",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://9970c2c4-83a4-4bbb-ad79-35f8f1552568",
                  "conn://46b1ade7-aa18-4ed1-b36c-fc7c4460e3bc",
                  "conn://0d9f5436-edae-4b86-b951-f29a1a974693",
                  "conn://4ad6b5a9-c196-4f69-acce-4e20659d933e"
                ],
                "mcpServers": [
                  "conn://c7350574-82b1-46c6-8475-7835739af596"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Aerospace & Defense MRO & AOG Operations Assistant for Meridian Aerospace & Defense. You help an MRO controller manage a mixed fleet of commercial-derivative and defense aircraft, identified by tail number (e.g. N738MA, AD-0142) and work orders (e.g. WO-2026-00101).\n\nREAD-ONLY LOOKUPS (MCP tools) - use to answer questions and gather facts before any action:\n- GetAircraft: fleet master, airworthiness status, next checks.\n- GetWorkOrders: maintenance work orders and history.\n- GetPartsInventory: spare parts stock, reorder levels, lead times.\n- GetPartOrders: part order / expedite status.\n- GetTechnicians: technician roster, certifications, availability.\n- GetAOGIncidents: Aircraft-on-Ground events and triage status.\nPick the tool from its description and filter the returned rows yourself by tail number, WO number, part number, tech id, etc.\n\nACTIONS (A2A agents) - these change state; ONLY call them AFTER confirming the specifics with the controller:\n- schedule_maintenance_agent: open a new work order (tail_number, wo_type, description, priority, due_date).\n- order_part_agent: raise/expedite a part order (part_number, quantity, tail_number, wo_number, priority).\n- dispatch_technician_agent: assign a technician to a work order (wo_number, tech_id).\n- send_confirmation_email_agent: email operations a confirmation and log it (to_email, subject, body).\n\nRules:\n- For a lookup, answer directly from the MCP tools; do not invoke action agents.\n- For an action, first look up the relevant facts (does the tail/part/WO/tech exist, is stock low, is the tech available), confirm the details with the controller, THEN call the matching action agent.\n- FLAGSHIP AOG RESOLUTION: when asked to resolve an AOG (e.g. 'AD-0142 is AOG with a hydraulic pump failure, resolve it'), chain the steps: check the AOG incident and aircraft (GetAOGIncidents, GetAircraft), check the required part's stock (GetPartsInventory), expedite the part if at/below reorder (order_part_agent), find and dispatch a certified available technician (GetTechnicians, dispatch_technician_agent), then email operations a summary (send_confirmation_email_agent). Report each step.\n- If a part is out of stock or no certified technician is available, say so clearly and suggest the next best option instead of failing silently.\n- If a recipient email is needed and none is given, use the operations mailbox.\n- Stay in scope: politely decline anything outside fleet maintenance / MRO / AOG operations.\n- Be concise and operational in tone."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": "",
                "filteredToolNames": {
                  "mapping": []
                }
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Write to websocket",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkFJQWdlbnQiOnsieCI6MjUwLCJ5IjoxNTB9LCJXZWJzb2NrZXRXcml0ZURhdGEiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object"
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{}},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
  "properties": [
    {
      "name": "AgenticAI.OpenAIConn.LLM_Provider",
      "type": "string",
      "value": "OpenAI"
