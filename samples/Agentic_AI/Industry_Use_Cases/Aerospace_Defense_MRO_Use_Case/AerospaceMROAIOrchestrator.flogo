    },
    {
      "name": "WebSocket_PORT",
      "type": "float64",
      "value": 8085
    }
  ],
  "schemas": {
    "OrcWsHeaders": {
      "type": "json",
      "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Accept\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Accept-Charset\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Accept-Encoding\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Content-Type\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Content-Length\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Connection\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Cookie\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Pragma\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Sec-Websocket-Key\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Sec-Websocket-Version\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Upgrade\": {\n      \"type\": \"string\",\n      \"visible\": false\n    }\n  },\n  \"required\": []\n}",
      "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Accept\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Accept-Charset\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Accept-Encoding\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Content-Type\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Content-Length\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Connection\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Cookie\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Pragma\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Sec-Websocket-Key\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Sec-Websocket-Version\": {\n      \"type\": \"string\",\n      \"visible\": false\n    },\n    \"Upgrade\": {\n      \"type\": \"string\",\n      \"visible\": false\n    }\n  },\n  \"required\": []\n}"
    }
  },
  "connections": {
