        {
          "description": "Get the fleet master list of all aircraft: tail number, model, platform type (Commercial/Defense), base location, flight hours, cycles, airworthiness status (IN_SERVICE/IN_MAINTENANCE/AOG/GROUNDED), next check type and due date. Use to answer questions about a tail&#39;s status/airworthiness, which aircraft are AOG or grounded, and upcoming checks.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetAircraft",
            "handlerDescription": "Get the fleet master list of all aircraft: tail number, model, platform type (Commercial/Defense), base location, flight hours, cycles, airworthiness status (IN_SERVICE/IN_MAINTENANCE/AOG/GROUNDED), next check type and due date. Use to answer questions about a tail's status/airworthiness, which aircraft are AOG or grounded, and upcoming checks.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getAircraft"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
