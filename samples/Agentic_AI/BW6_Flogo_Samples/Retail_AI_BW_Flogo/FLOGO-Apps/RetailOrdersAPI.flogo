          {
            "id": "FindOrder",
            "name": "FindOrder",
            "description": "Order with the requested id (BW for-each[orderId = $param])",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[ReferenceData].output.orders,o, $loop[o].orderId == $flow.pathParams.orderId)": {
                        "orderId": "=$loop[o].orderId",
                        "customerId": "=$loop[o].customerId",
                        "sku": "=$loop[o].sku",
                        "purchaseDate": "=$loop[o].purchaseDate",
                        "pricePaid": "=$loop[o].pricePaid",
                        "channel": "=$loop[o].channel",
                        "storeId": "=$loop[o].storeId"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
