          {
            "id": "ReturnWindow",
            "name": "ReturnWindow",
            "description": "BW xsl:variables ageDays (days from purchase to 2026-05-10) and returnWindowDays",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "ageDays": "=datetime.diff(datetime.parse($activity[FindOrder].output.matches[0].purchaseDate, \"UTC\"), datetime.parse(\"2026-05-10\", \"UTC\"), \"days\") < 0 ? coerce.toInt(0 - datetime.diff(datetime.parse($activity[FindOrder].output.matches[0].purchaseDate, \"UTC\"), datetime.parse(\"2026-05-10\", \"UTC\"), \"days\")) : coerce.toInt(datetime.diff(datetime.parse($activity[FindOrder].output.matches[0].purchaseDate, \"UTC\"), datetime.parse(\"2026-05-10\", \"UTC\"), \"days\"))",
                    "returnWindowDays": "=$activity[FindProduct].output.matches[0].attributes.returnWindowDays"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"ageDays\": {\n      \"type\": \"integer\"\n    },\n    \"returnWindowDays\": {\n      \"type\": \"integer\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"ageDays\": {\n      \"type\": \"integer\"\n    },\n    \"returnWindowDays\": {\n      \"type\": \"integer\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"ageDays\": {\n      \"type\": \"integer\"\n    },\n    \"returnWindowDays\": {\n      \"type\": \"integer\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"ageDays\": {\n      \"type\": \"integer\"\n    },\n    \"returnWindowDays\": {\n      \"type\": \"integer\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "order_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "orderId": "=$activity[FindOrder].output.matches[0].orderId",
                      "sku": "=$activity[FindOrder].output.matches[0].sku",
                      "productName": "=$activity[FindProduct].output.matches[0].name",
                      "purchaseDate": "=$activity[FindOrder].output.matches[0].purchaseDate",
                      "ageDays": "=$activity[ReturnWindow].output.ageDays",
                      "returnWindowDays": "=$activity[ReturnWindow].output.returnWindowDays",
                      "eligible": "=$activity[ReturnWindow].output.ageDays <= $activity[ReturnWindow].output.returnWindowDays",
                      "loyaltyTier": "=$activity[FindCustomer].output.matches[0].loyaltyTier",
                      "reason": "=$activity[ReturnWindow].output.ageDays <= $activity[ReturnWindow].output.returnWindowDays ? string.concat(\"The item is within the \", coerce.toString($activity[ReturnWindow].output.returnWindowDays), \" day return window.\") : string.concat(\"The item is \", coerce.toString($activity[ReturnWindow].output.ageDays - $activity[ReturnWindow].output.returnWindowDays), \" days past the \", coerce.toString($activity[ReturnWindow].output.returnWindowDays), \" day return window.\")"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ReturnEligibilityBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"orderId\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"productName\":{\"type\":\"string\"},\"purchaseDate\":{\"type\":\"string\"},\"ageDays\":{\"type\":\"integer\",\"format\":\"int32\"},\"returnWindowDays\":{\"type\":\"integer\",\"format\":\"int32\"},\"eligible\":{\"type\":\"boolean\"},\"loyaltyTier\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"orderId\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"productName\":{\"type\":\"string\"},\"purchaseDate\":{\"type\":\"string\"},\"ageDays\":{\"type\":\"integer\",\"format\":\"int32\"},\"returnWindowDays\":{\"type\":\"integer\",\"format\":\"int32\"},\"eligible\":{\"type\":\"boolean\"},\"loyaltyTier\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Reply to API Call for api/orders/returns/eligibility GET",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[ConfigureHTTPResponse].code",
                  "responseBody": "=$activity[ConfigureHTTPResponse].response"
                }
              }
            }
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[BadRequest].code",
                  "responseBody": "=$activity[BadRequest].response"
                }
              }
            },
            "id": "ReturnBadRequest",
            "name": "ReturnBadRequest",
            "description": "Reply with the branch response"
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[NotFound].code",
                  "responseBody": "=$activity[NotFound].response"
                }
              }
            },
            "id": "ReturnNotFound",
            "name": "ReturnNotFound",
            "description": "Reply with the branch response"
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "queryParams",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"orderId\":{\"type\":\"string\"}}"
