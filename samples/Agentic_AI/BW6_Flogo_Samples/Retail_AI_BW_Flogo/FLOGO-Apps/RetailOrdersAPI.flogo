                "input": {
                  "mapping": {
                    "body": {
                      "orderId": "=$activity[FindOrder].output.matches[0].orderId",
                      "customerId": "=$activity[FindOrder].output.matches[0].customerId",
                      "sku": "=$activity[FindOrder].output.matches[0].sku",
                      "purchaseDate": "=$activity[FindOrder].output.matches[0].purchaseDate",
                      "channel": "=$activity[FindOrder].output.matches[0].channel",
                      "storeId": "=$activity[FindOrder].output.matches[0].storeId",
                      "product": {
                        "sku": "=$activity[FindProduct].output.matches[0].sku",
                        "name": "=$activity[FindProduct].output.matches[0].name",
                        "brand": "=$activity[FindProduct].output.matches[0].brand",
                        "category": "=$activity[FindProduct].output.matches[0].category",
                        "price": "=$activity[FindProduct].output.matches[0].price",
                        "description": "=$activity[FindProduct].output.matches[0].description"
                      },
                      "customer": {
                        "customerId": "=$activity[FindCustomer].output.matches[0].customerId",
                        "loyaltyTier": "=$activity[FindCustomer].output.matches[0].loyaltyTier",
                        "preferredStoreId": "=$activity[FindCustomer].output.matches[0].preferredStoreId"
                      }
                    }
