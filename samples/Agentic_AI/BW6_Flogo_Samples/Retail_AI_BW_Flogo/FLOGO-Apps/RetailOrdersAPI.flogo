                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"orderId\":{\"type\":\"string\"},\"customerId\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"purchaseDate\":{\"type\":\"string\"},\"channel\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"product\":{\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"brand\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"},\"price\":{\"type\":\"integer\",\"format\":\"int32\"},\"description\":{\"type\":\"string\"}}},\"customer\":{\"type\":\"object\",\"properties\":{\"customerId\":{\"type\":\"string\"},\"loyaltyTier\":{\"type\":\"string\"},\"preferredStoreId\":{\"type\":\"string\"}}}}}}}"
                  }
