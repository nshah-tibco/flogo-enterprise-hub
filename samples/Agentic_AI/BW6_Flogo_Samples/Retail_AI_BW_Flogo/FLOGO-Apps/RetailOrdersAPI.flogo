      "id": "flow:lookup_order_GET",
      "data": {
        "name": "lookup_order_GET",
        "description": "Flow for api/orders/{orderId} GET",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.pathParams.orderId) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "ReferenceData",
            "type": "expression",
            "label": "Log_API to ReferenceData",
            "value": "coerce.toString($flow.pathParams.orderId) != \"\""
          },
          {
            "id": 4,
            "from": "ReferenceData",
            "to": "FindOrder",
            "type": "label",
            "label": "ReferenceData to FindOrder"
          },
          {
            "id": 5,
            "from": "FindOrder",
            "to": "NotFound",
            "type": "expression",
            "label": "FindOrder to NotFound",
            "value": "array.count($activity[FindOrder].output.matches) == 0"
          },
          {
            "id": 6,
            "from": "FindOrder",
            "to": "FindProduct",
            "type": "expression",
            "label": "FindOrder to FindProduct",
            "value": "array.count($activity[FindOrder].output.matches) > 0"
          },
          {
            "id": 7,
            "from": "FindProduct",
            "to": "FindCustomer",
            "type": "label",
            "label": "FindProduct to FindCustomer"
          },
          {
