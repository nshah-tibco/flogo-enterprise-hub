          {
            "id": "FilterDocuments",
            "name": "FilterDocuments",
            "description": "Documents of the requested documentTypes (BW Iterate over documentTypes)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[SeedDocuments].output.documents,d, array.contains(coerce.toArray($flow.body.documentTypes), $loop[d].documentType))": {
                        "documentId": "=$loop[d].documentId",
                        "title": "=$loop[d].title",
                        "documentType": "=$loop[d].documentType",
                        "source": "=$loop[d].source",
                        "uri": "=$loop[d].uri",
                        "category": "=$loop[d].category",
                        "tags": "=$loop[d].tags",
                        "text": "=$loop[d].text",
                        "fileName": "=$loop[d].fileName"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"fileName\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"fileName\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"fileName\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"fileName\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ResolveStore",
            "name": "ResolveStore",
            "description": "Find (or with resetCollection, recreate) the vector store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:ResolveStore",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "reset": "=$flow.body.resetCollection == true"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "AddDocuments",
            "name": "AddDocuments",
            "description": "Upload each document (once per document)",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[FilterDocuments].output.matches",
              "accumulate": true,
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AddDocument",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "storeId": "=$activity[ResolveStore].storeId",
                "fileName": "=$iteration[value].fileName",
                "text": "=$iteration[value].text",
                "documentId": "=$iteration[value].documentId",
                "title": "=$iteration[value].title",
                "documentType": "=$iteration[value].documentType",
                "category": "=$iteration[value].category",
                "uri": "=$iteration[value].uri",
                "source": "=$iteration[value].source"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}, \"fileName\": {\"type\": \"string\"}, \"text\": {\"type\": \"string\"}, \"documentId\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"documentType\": {\"type\": \"string\"}, \"category\": {\"type\": \"string\"}, \"uri\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}, \"fileName\": {\"type\": \"string\"}, \"text\": {\"type\": \"string\"}, \"documentId\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"documentType\": {\"type\": \"string\"}, \"category\": {\"type\": \"string\"}, \"uri\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"fileId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"fileId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "IngestionSummary",
            "name": "IngestionSummary",
            "description": "BW BuildIngestionSummary: one chunk entry per document",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "sampleChunks": {
                      "@foreach($activity[FilterDocuments].output.matches,c)": {
                        "chunkId": "=string.concat($loop[c].documentId, \"-\", utils.uuid())",
                        "title": "=$loop[c].title",
                        "documentType": "=$loop[c].documentType",
                        "tokenCount": 0,
                        "documentId": "=$loop[c].documentId"
                      }
                    },
                    "statusChunks": {
                      "@foreach($activity[FilterDocuments].output.matches,c)": {
                        "chunkId": "=string.concat($loop[c].documentId, \"-\", utils.uuid())",
                        "title": "=$loop[c].title",
                        "documentType": "=$loop[c].documentType",
                        "tokenCount": 0
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sampleChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"statusChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sampleChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"statusChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sampleChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"statusChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sampleChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"statusChunks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"tokenCount\": {\n            \"type\": \"integer\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "ingestion": {
                        "sourceCount": "=array.count($activity[FilterDocuments].output.matches)",
                        "chunkCount": "=array.count($activity[FilterDocuments].output.matches)",
                        "embedding": {
                          "provider": "openai-vector-store",
                          "model": "text-embedding-3-large"
                        },
                        "storage": {
                          "provider": "openai",
                          "collection": "=$property[\"VECTOR_STORE_NAME\"]"
                        },
                        "sampleChunks": "=$activity[IngestionSummary].output.sampleChunks"
                      },
                      "status": {
                        "dataset": {
                          "products": 10,
                          "inventory": 3,
                          "customers": 4,
                          "orders": 5,
                          "policies": 3
                        },
                        "ingestion": {
                          "sourceCount": "=array.count($activity[FilterDocuments].output.matches)",
                          "chunkCount": "=array.count($activity[FilterDocuments].output.matches)",
                          "sampleChunks": "=$activity[IngestionSummary].output.statusChunks"
                        }
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://IngestBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"ingestion\":{\"type\":\"object\",\"properties\":{\"sourceCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"embedding\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}}},\"storage\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"}}},\"sampleChunks\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"chunkId\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"documentType\":{\"type\":\"string\"},\"tokenCount\":{\"type\":\"integer\",\"format\":\"int32\"}}}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}},\"status\":{\"type\":\"object\",\"properties\":{\"dataset\":{\"type\":\"object\",\"properties\":{\"products\":{\"type\":\"integer\",\"format\":\"int32\"},\"inventory\":{\"type\":\"integer\",\"format\":\"int32\"},\"customers\":{\"type\":\"integer\",\"format\":\"int32\"},\"orders\":{\"type\":\"integer\",\"format\":\"int32\"},\"policies\":{\"type\":\"integer\",\"format\":\"int32\"}}},\"ingestion\":{\"type\":\"object\",\"properties\":{\"sourceCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"embedding\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}}},\"storage\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"}}},\"sampleChunks\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"chunkId\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"documentType\":{\"type\":\"string\"},\"tokenCount\":{\"type\":\"integer\",\"format\":\"int32\"}}}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}}}}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"ingestion\":{\"type\":\"object\",\"properties\":{\"sourceCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"embedding\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}}},\"storage\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"}}},\"sampleChunks\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"chunkId\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"documentType\":{\"type\":\"string\"},\"tokenCount\":{\"type\":\"integer\",\"format\":\"int32\"}}}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}},\"status\":{\"type\":\"object\",\"properties\":{\"dataset\":{\"type\":\"object\",\"properties\":{\"products\":{\"type\":\"integer\",\"format\":\"int32\"},\"inventory\":{\"type\":\"integer\",\"format\":\"int32\"},\"customers\":{\"type\":\"integer\",\"format\":\"int32\"},\"orders\":{\"type\":\"integer\",\"format\":\"int32\"},\"policies\":{\"type\":\"integer\",\"format\":\"int32\"}}},\"ingestion\":{\"type\":\"object\",\"properties\":{\"sourceCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"embedding\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}}},\"storage\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"}}},\"sampleChunks\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"chunkId\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"documentType\":{\"type\":\"string\"},\"tokenCount\":{\"type\":\"integer\",\"format\":\"int32\"}}}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}}}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
