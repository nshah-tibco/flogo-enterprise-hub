                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "uri": "=string.concat(\"retail://\", $activity[FindPolicy].output.matches[0].documentType, \"/\", $activity[FindPolicy].output.matches[0].id)",
                      "name": "=$flow.pathParams.id",
                      "title": "=$activity[FindPolicy].output.matches[0].title",
                      "description": "",
                      "mimeType": "text/plain",
                      "text": "=$activity[FindPolicy].output.matches[0].body"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://get_api_policy_resources_id_GET_Body"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"uri\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"mimeType\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"uri\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"mimeType\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}}}}}"
                  }
                }
