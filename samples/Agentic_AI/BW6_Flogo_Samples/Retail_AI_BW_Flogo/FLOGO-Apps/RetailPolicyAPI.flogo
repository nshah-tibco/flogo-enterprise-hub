          {
            "id": "SeedDocuments",
            "name": "SeedDocuments",
            "description": "Seed policy documents, normalized as BW does",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "documents": [
                      {
                        "documentId": "policy-returns-general",
                        "title": "General Return Policy",
                        "documentType": "policy",
                        "source": "seed-policy-json",
                        "uri": "policy://policy-returns-general",
                        "category": "returns",
                        "tags": [
                          "policy"
                        ],
                        "text": "Most footwear, apparel, bags, fitness, and accessories can be returned within 30 days of purchase when the item is clean, undamaged, and includes proof of purchase. Outerwear has an extended 45 day return window. Final sale items cannot be returned. Gold and Platinum loyalty members receive free return shipping.",
                        "fileName": "policy-returns-general.txt"
                      },
                      {
                        "documentId": "policy-electronics-returns",
                        "title": "Electronics Return Policy",
                        "documentType": "policy",
                        "source": "seed-policy-json",
                        "uri": "policy://policy-electronics-returns",
                        "category": "returns",
                        "tags": [
                          "policy"
                        ],
                        "text": "Electronics including sport watches and wireless earbuds can be returned within 14 days of purchase. The item must include the charging cable, case, manuals, and original packaging. Open-box electronics may be subject to inspection before a refund is issued.",
                        "fileName": "policy-electronics-returns.txt"
                      },
                      {
                        "documentId": "policy-warranty",
                        "title": "Warranty Policy",
                        "documentType": "policy",
                        "source": "seed-policy-json",
                        "uri": "policy://policy-warranty",
                        "category": "warranty",
                        "tags": [
                          "policy"
                        ],
                        "text": "Warranty coverage applies to manufacturing defects and does not cover normal wear, misuse, cosmetic damage, or accidental damage. Bags include a 24 month warranty. Outerwear and electronics include a 12 month warranty. Footwear and bottles include a 6 month warranty. Fitness mats include a 3 month warranty.",
                        "fileName": "policy-warranty.txt"
                      },
                      {
                        "documentId": "faq-inventory",
                        "title": "Inventory and Pickup FAQ",
                        "documentType": "faq",
                        "source": "seed-policy-json",
                        "uri": "policy://faq-inventory",
                        "category": "inventory",
                        "tags": [
                          "faq"
                        ],
                        "text": "In-stock items can usually be reserved for same-day store pickup. Low-stock items may require associate confirmation before reservation. Out-of-stock items can be shipped from another store when network inventory is available. Store locations are SFO-001 in San Francisco, OAK-002 in Oakland, and SJC-003 in San Jose.",
                        "fileName": "faq-inventory.txt"
                      },
                      {
                        "documentId": "promo-spring",
                        "title": "Spring Trail Promotion",
                        "documentType": "promotion",
                        "source": "seed-policy-json",
                        "uri": "policy://promo-spring",
                        "category": "promotions",
                        "tags": [
                          "promotion"
                        ],
                        "text": "Through May 31 2026, loyalty members receive 10 percent off trail running shoes, rain jackets, water bottles, and daypacks. Platinum members receive 15 percent off qualifying items. Electronics are excluded from the Spring Trail Promotion.",
                        "fileName": "promo-spring.txt"
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "input": {
