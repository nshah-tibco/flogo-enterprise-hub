          {
            "id": "Retrieval",
            "name": "Retrieval",
            "description": "BW BuildRetrieval + BuildCitations (metadata read from the file attributes)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "retrieval": {
                      "@foreach($activity[SearchRows].output.rows,r)": {
                        "chunkId": "=string.concat(\"rag-\", $loop[r].file_id)",
                        "documentId": "=$loop[r].attributes.documentId.OfString",
                        "title": "=$loop[r].attributes.title.OfString",
                        "documentType": "=$loop[r].attributes.documentType.OfString",
                        "category": "=$loop[r].attributes.category.OfString",
                        "uri": "=$loop[r].attributes.uri.OfString",
                        "score": "=$loop[r].score",
                        "text": "=$loop[r].content[0].text"
                      }
                    },
                    "citations": {
                      "@foreach($activity[SearchRows].output.rows,r)": {
                        "id": "=string.concat(\"rag-\", $loop[r].file_id)",
                        "title": "=$loop[r].attributes.title.OfString",
                        "documentType": "=$loop[r].attributes.documentType.OfString",
                        "uri": "=$loop[r].attributes.uri.OfString"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"retrieval\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"score\": {\n            \"type\": \"number\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"retrieval\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"score\": {\n            \"type\": \"number\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"retrieval\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"score\": {\n            \"type\": \"number\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"retrieval\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"chunkId\": {\n            \"type\": \"string\"\n          },\n          \"documentId\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          },\n          \"score\": {\n            \"type\": \"number\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"uri\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
