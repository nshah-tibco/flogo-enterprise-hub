                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "NotFound",
            "name": "NotFound",
            "description": "HTTP 404 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "404",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "policy_not_found",
                      "message": "=string.concat(\"No policy resource with id \", $flow.pathParams.id)"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
