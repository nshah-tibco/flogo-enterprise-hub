          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\"},\"topK\":{\"type\":\"number\"},\"minScore\":{\"type\":\"number\"},\"filters\":{\"type\":\"object\",\"properties\":{\"documentTypes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"category\":{\"type\":\"string\"}}}}},\"multipartFormData\":{\"type\":\"object\",\"properties\":{}},\"requestURI\":{\"type\":\"string\"},\"method\":{\"type\":\"string\"}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"responseBody\":{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{}},\"headers\":{\"type\":\"object\",\"properties\":{}}}}}}"
          }
        },
        "explicitReply": true
      }
    },
