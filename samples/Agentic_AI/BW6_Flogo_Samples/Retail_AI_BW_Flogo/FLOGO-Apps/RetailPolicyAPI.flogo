    {
      "id": "flow:post_api_policy_query_POST",
      "data": {
        "name": "post_api_policy_query_POST",
        "description": "Flow for api/policy/query POST",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.body.question) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "ResolveStore",
            "type": "expression",
            "label": "Log_API to ResolveStore",
            "value": "coerce.toString($flow.body.question) != \"\""
          },
          {
            "id": 4,
            "from": "ResolveStore",
            "to": "Search",
            "type": "label",
            "label": "ResolveStore to Search"
          },
          {
            "id": 5,
            "from": "Search",
            "to": "SearchRows",
            "type": "label",
            "label": "Search to SearchRows"
          },
          {
            "id": 6,
            "from": "SearchRows",
            "to": "Retrieval",
            "type": "label",
            "label": "SearchRows to Retrieval"
          },
          {
            "id": 7,
            "from": "Retrieval",
            "to": "Answer",
            "type": "label",
            "label": "Retrieval to Answer"
          },
          {
            "id": 8,
            "from": "Answer",
            "to": "ConfigureHTTPResponse",
            "type": "label",
            "label": "Answer to ConfigureHTTPResponse"
          },
          {
            "id": 9,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 10,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/policy/query POST",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Log API call for post_api_policy_query_POST",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "question is required"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ResolveStore",
            "name": "ResolveStore",
            "description": "Find (or create) the vector store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:ResolveStore",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "reset": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Search",
            "name": "Search",
            "description": "Semantic search (BW RAG query retrieval, maxResult 5)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorSearch",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "vectorStoreID": "=$activity[ResolveStore].storeId",
                "searchString": "=$flow.body.question",
                "maxNumberOfResults": 5,
                "rewriteQuery": false,
                "scoreThreshold": 0,
                "ranker": ""
              },
              "schemas": {
                "output": {
                  "searchResultRows": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"attributes\": {\"type\": \"object\", \"properties\": {\"documentId\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"title\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"documentType\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"category\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"uri\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"source\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}}}, \"content\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"text\": {\"type\": \"string\"}, \"type\": {\"type\": \"string\"}}}}, \"file_id\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"score\": {\"type\": \"number\"}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"attributes\": {\"type\": \"object\", \"properties\": {\"documentId\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"title\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"documentType\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"category\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"uri\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}, \"source\": {\"type\": \"object\", \"properties\": {\"OfString\": {\"type\": \"string\"}}}}}, \"content\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"text\": {\"type\": \"string\"}, \"type\": {\"type\": \"string\"}}}}, \"file_id\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"score\": {\"type\": \"number\"}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "SearchRows",
            "name": "SearchRows",
            "description": "Search results as plain JSON",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "rows": "=coerce.toArray(coerce.toString($activity[Search].searchResultRows))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"rows\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"attributes\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"documentId\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OfString\": {\n                    \"type\": \"string\"\n                  }\n                }\n              },\n              \"title\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OfString\": {\n                    \"type\": \"string\"\n                  }\n                }\n              },\n              \"documentType\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OfString\": {\n                    \"type\": \"string\"\n                  }\n                }\n              },\n              \"category\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OfString\": {\n                    \"type\": \"string\"\n                  }\n                }\n              },\n              \"uri\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OfString\": {\n                    \"type\": \"string\"\n                  }\n                }\n              },\n              \"source\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OfString\": {\n                    \"type\": \"string\"\n                  }\n                }\n              }\n            }\n          },\n          \"content\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"text\": {\n                  \"type\": \"string\"\n                },\n                \"type\": {\n                  \"type\": \"string\"\n                }\n              }\n            }\n          },\n          \"file_id\": {\n            \"type\": \"string\"\n          },\n          \"filename\": {\n            \"type\": \"string\"\n          },\n          \"score\": {\n            \"type\": \"number\"\n          }\n        }\n      }\n    }\n  }\n}",
