    {
      "id": "flow:post_api_upload_POST",
      "data": {
        "name": "post_api_upload_POST",
        "description": "Flow for api/upload POST",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.body.fileName) == \"\" || coerce.toString($flow.body.contentBase64) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "UploadInfo",
            "type": "expression",
            "label": "Log_API to UploadInfo",
            "value": "coerce.toString($flow.body.fileName) != \"\" && coerce.toString($flow.body.contentBase64) != \"\""
          },
          {
            "id": 4,
            "from": "UploadInfo",
            "to": "ResolveStore",
            "type": "label",
            "label": "UploadInfo to ResolveStore"
          },
          {
            "id": 5,
            "from": "ResolveStore",
            "to": "AddUpload",
            "type": "label",
            "label": "ResolveStore to AddUpload"
          },
          {
            "id": 6,
            "from": "AddUpload",
            "to": "ConfigureHTTPResponse",
            "type": "label",
            "label": "AddUpload to ConfigureHTTPResponse"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 8,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/upload POST",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Log API call for post_api_upload_POST",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "fileName, contentBase64 are required"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "UploadInfo",
            "name": "UploadInfo",
            "description": "BW DecodeBase64Content + NormalizePolicyDocument2",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "documentId": "=string.concat(\"upload-\", datetime.currentDate())",
                    "text": "=string.base64ToString($flow.body.contentBase64)",
                    "category": "=string.contains($flow.body.fileName, \"return\") ? \"returns\" : (string.contains($flow.body.fileName, \"warranty\") ? \"warranty\" : ((string.contains($flow.body.fileName, \"inventory\") || string.contains($flow.body.fileName, \"pickup\")) ? \"inventory\" : ((string.contains($flow.body.fileName, \"promotion\") || string.contains($flow.body.fileName, \"promo\")) ? \"promotions\" : \"uploaded\")))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"text\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"text\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"text\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"text\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ResolveStore",
            "name": "ResolveStore",
            "description": "Find (or create) the vector store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:ResolveStore",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "reset": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "AddUpload",
            "name": "AddUpload",
            "description": "Upload the document into the store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AddDocument",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "storeId": "=$activity[ResolveStore].storeId",
                "fileName": "=$flow.body.fileName",
                "text": "=$activity[UploadInfo].output.text",
                "documentId": "=$activity[UploadInfo].output.documentId",
                "title": "=$flow.body.fileName",
                "documentType": "document",
                "category": "=$activity[UploadInfo].output.category",
                "uri": "=string.concat(\"upload://\", $flow.body.fileName)",
                "source": "upload"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}, \"fileName\": {\"type\": \"string\"}, \"text\": {\"type\": \"string\"}, \"documentId\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"documentType\": {\"type\": \"string\"}, \"category\": {\"type\": \"string\"}, \"uri\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}, \"fileName\": {\"type\": \"string\"}, \"text\": {\"type\": \"string\"}, \"documentId\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"documentType\": {\"type\": \"string\"}, \"category\": {\"type\": \"string\"}, \"uri\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"fileId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"fileId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "upload": {
                        "uploadId": "=$activity[UploadInfo].output.documentId",
                        "fileName": "=$flow.body.fileName",
                        "status": "completed",
                        "documentCount": 1,
                        "productCount": 0,
                        "chunkCount": 1,
                        "uploadedAt": "=datetime.currentDatetime()"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://UploadBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"upload\":{\"type\":\"object\",\"properties\":{\"uploadId\":{\"type\":\"string\"},\"fileName\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"documentCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"productCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}},\"uploadedAt\":{\"type\":\"string\"}}},\"status\":{\"type\":\"object\",\"properties\":{\"dataset\":{\"type\":\"object\",\"properties\":{\"products\":{\"type\":\"integer\",\"format\":\"int32\"},\"inventory\":{\"type\":\"integer\",\"format\":\"int32\"},\"customers\":{\"type\":\"integer\",\"format\":\"int32\"},\"orders\":{\"type\":\"integer\",\"format\":\"int32\"},\"policies\":{\"type\":\"integer\",\"format\":\"int32\"}}},\"ingestion\":{\"type\":\"object\",\"properties\":{\"sourceCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"embedding\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}}},\"storage\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"}}},\"sampleChunks\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"chunkId\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"documentType\":{\"type\":\"string\"},\"tokenCount\":{\"type\":\"integer\",\"format\":\"int32\"}}}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}}}}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"upload\":{\"type\":\"object\",\"properties\":{\"uploadId\":{\"type\":\"string\"},\"fileName\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"documentCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"productCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}},\"uploadedAt\":{\"type\":\"string\"}}},\"status\":{\"type\":\"object\",\"properties\":{\"dataset\":{\"type\":\"object\",\"properties\":{\"products\":{\"type\":\"integer\",\"format\":\"int32\"},\"inventory\":{\"type\":\"integer\",\"format\":\"int32\"},\"customers\":{\"type\":\"integer\",\"format\":\"int32\"},\"orders\":{\"type\":\"integer\",\"format\":\"int32\"},\"policies\":{\"type\":\"integer\",\"format\":\"int32\"}}},\"ingestion\":{\"type\":\"object\",\"properties\":{\"sourceCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"chunkCount\":{\"type\":\"integer\",\"format\":\"int32\"},\"embedding\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}}},\"storage\":{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"}}},\"sampleChunks\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"chunkId\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"documentType\":{\"type\":\"string\"},\"tokenCount\":{\"type\":\"integer\",\"format\":\"int32\"}}}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}}}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Reply to API Call for api/upload POST",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
