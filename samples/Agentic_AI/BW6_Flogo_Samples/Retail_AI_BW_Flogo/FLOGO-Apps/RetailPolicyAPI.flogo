    {
      "id": "flow:get_api_policy_resources_id_GET",
      "data": {
        "name": "get_api_policy_resources_id_GET",
        "description": "Flow for api/policy/resources/{id} GET",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.pathParams.id) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "PolicyData",
            "type": "expression",
            "label": "Log_API to PolicyData",
            "value": "coerce.toString($flow.pathParams.id) != \"\""
          },
          {
            "id": 4,
            "from": "PolicyData",
            "to": "FindPolicy",
            "type": "label",
            "label": "PolicyData to FindPolicy"
          },
          {
            "id": 5,
            "from": "FindPolicy",
            "to": "NotFound",
            "type": "expression",
            "label": "FindPolicy to NotFound",
            "value": "array.count($activity[FindPolicy].output.matches) == 0"
          },
          {
            "id": 6,
            "from": "FindPolicy",
            "to": "ConfigureHTTPResponse",
            "type": "expression",
            "label": "FindPolicy to ConfigureHTTPResponse",
            "value": "array.count($activity[FindPolicy].output.matches) > 0"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 8,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 9,
            "from": "NotFound",
            "to": "ReturnNotFound",
            "type": "label",
            "label": "NotFound to ReturnNotFound"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/policy/resources/{id} GET",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Log API call for get_api_policy_resources_id_GET",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "Policy_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "id is required"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "PolicyData",
            "name": "PolicyData",
            "description": "Policy documents (BW ParseJSON1 literal)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "policies": [
                      {
                        "id": "policy-returns-general",
                        "title": "General Return Policy",
                        "documentType": "policy",
                        "body": "Most footwear, apparel, bags, fitness, and accessories can be returned within 30 days of purchase when the item is clean, undamaged, and includes proof of purchase. Outerwear has an extended 45 day return window. Final sale items cannot be returned. Gold and Platinum loyalty members receive free return shipping."
                      },
                      {
                        "id": "policy-electronics-returns",
                        "title": "Electronics Return Policy",
                        "documentType": "policy",
                        "body": "Electronics including sport watches and wireless earbuds can be returned within 14 days of purchase. The item must include the charging cable, case, manuals, and original packaging. Open-box electronics may be subject to inspection before a refund is issued."
                      },
                      {
                        "id": "policy-warranty",
                        "title": "Warranty Policy",
                        "documentType": "policy",
                        "body": "Warranty coverage applies to manufacturing defects and does not cover normal wear, misuse, cosmetic damage, or accidental damage. Bags include a 24 month warranty. Outerwear and electronics include a 12 month warranty. Footwear and bottles include a 6 month warranty. Fitness mats include a 3 month warranty."
                      },
                      {
                        "id": "faq-inventory",
                        "title": "Inventory and Pickup FAQ",
                        "documentType": "faq",
                        "body": "In-stock items can usually be reserved for same-day store pickup. Low-stock items may require associate confirmation before reservation. Out-of-stock items can be shipped from another store when network inventory is available. Store locations are SFO-001 in San Francisco, OAK-002 in Oakland, and SJC-003 in San Jose."
                      },
                      {
                        "id": "promo-spring",
                        "title": "Spring Trail Promotion",
                        "documentType": "promotion",
                        "body": "Through May 31 2026, loyalty members receive 10 percent off trail running shoes, rain jackets, water bottles, and daypacks. Platinum members receive 15 percent off qualifying items. Electronics are excluded from the Spring Trail Promotion."
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"policies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"policies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"policies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"policies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "FindPolicy",
            "name": "FindPolicy",
            "description": "Policy with the requested id",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[PolicyData].output.policies,p, $loop[p].id == $flow.pathParams.id)": {
                        "id": "=$loop[p].id",
                        "title": "=$loop[p].title",
                        "documentType": "=$loop[p].documentType",
                        "body": "=$loop[p].body"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"documentType\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
