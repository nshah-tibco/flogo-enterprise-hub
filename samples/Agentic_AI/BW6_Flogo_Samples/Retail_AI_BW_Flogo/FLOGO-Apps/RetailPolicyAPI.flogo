    {
      "id": "flow:ResolveStore",
      "data": {
        "name": "ResolveStore",
        "description": "Vector store named $property[VECTOR_STORE_NAME]: reuse, recreate (reset) or create it",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ListStores",
            "type": "label",
            "label": "StartActivity to ListStores"
          },
          {
            "id": 2,
            "from": "ListStores",
            "to": "FindStore",
            "type": "label",
            "label": "ListStores to FindStore"
          },
          {
            "id": 3,
            "from": "FindStore",
            "to": "ReturnExisting",
            "type": "expression",
            "label": "FindStore to ReturnExisting",
            "value": "array.count($activity[FindStore].output.matches) > 0 && $flow.reset == false"
          },
          {
            "id": 4,
            "from": "FindStore",
            "to": "DeleteStore",
            "type": "expression",
            "label": "FindStore to DeleteStore",
            "value": "array.count($activity[FindStore].output.matches) > 0 && $flow.reset == true"
          },
          {
            "id": 5,
            "from": "DeleteStore",
            "to": "RecreateStore",
            "type": "label",
            "label": "DeleteStore to RecreateStore"
          },
          {
            "id": 6,
            "from": "RecreateStore",
            "to": "ReturnRecreated",
            "type": "label",
            "label": "RecreateStore to ReturnRecreated"
          },
          {
            "id": 7,
            "from": "FindStore",
            "to": "CreateStore",
            "type": "expression",
            "label": "FindStore to CreateStore",
            "value": "array.count($activity[FindStore].output.matches) == 0"
          },
          {
            "id": 8,
            "from": "CreateStore",
            "to": "ReturnCreated",
            "type": "label",
            "label": "CreateStore to ReturnCreated"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ListStores",
            "name": "ListStores",
            "description": "List the account's vector stores",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorStoreList",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "limit": 100,
                "order": "",
                "after": "",
                "before": "",
                "timeoutSeconds": 60
              },
              "schemas": {
                "output": {
                  "vectorStores": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "FindStore",
            "name": "FindStore",
            "description": "The store with the configured name",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[ListStores].vectorStores,s, $loop[s].name == $property[\"VECTOR_STORE_NAME\"])": {
                        "id": "=$loop[s].id",
                        "name": "=$loop[s].name"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnExisting",
            "name": "ReturnExisting",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "storeId": "=$activity[FindStore].output.matches[0].id"
                }
              }
            }
          },
          {
            "id": "DeleteStore",
            "name": "DeleteStore",
            "description": "resetCollection: drop the existing store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorStoreDelete",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "vectorStoreId": "=$activity[FindStore].output.matches[0].id",
                "timeoutSeconds": 60
              }
            }
          },
          {
            "id": "RecreateStore",
            "name": "RecreateStore",
            "description": "resetCollection: create it again",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorStoreCreate",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "name": "=$property[\"VECTOR_STORE_NAME\"]",
                "description": "Retail policy, FAQ and promotion knowledge (BW RetailKnowledge)",
                "expiresAfterDays": 0,
                "maxChunkSizeTokens": 800,
                "chunkOverlapTokens": 400,
                "timeoutSeconds": 60,
                "fileIds": {
                  "mapping": []
                },
                "metadata": {
                  "mapping": []
                }
              }
            }
          },
          {
            "id": "ReturnRecreated",
            "name": "ReturnRecreated",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "storeId": "=$activity[RecreateStore].id"
                }
              }
            }
          },
          {
            "id": "CreateStore",
            "name": "CreateStore",
            "description": "First use: create the store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorStoreCreate",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "name": "=$property[\"VECTOR_STORE_NAME\"]",
                "description": "Retail policy, FAQ and promotion knowledge (BW RetailKnowledge)",
                "expiresAfterDays": 0,
                "maxChunkSizeTokens": 800,
                "chunkOverlapTokens": 400,
                "timeoutSeconds": 60,
                "fileIds": {
                  "mapping": []
                },
                "metadata": {
                  "mapping": []
                }
              }
            }
          },
          {
            "id": "ReturnCreated",
            "name": "ReturnCreated",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "storeId": "=$activity[CreateStore].id"
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "reset",
              "type": "boolean"
            }
          ],
          "output": [
            {
              "name": "storeId",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\": \"object\", \"properties\": {\"reset\": {\"type\": \"boolean\"}}}",
            "output": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}"
          }
        }
      }
    },
    {
      "id": "flow:AddDocument",
      "data": {
        "name": "AddDocument",
        "description": "Write one document to a file and upload it into the vector store with its metadata",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "WriteDoc",
            "type": "label",
            "label": "StartActivity to WriteDoc"
          },
          {
            "id": 2,
            "from": "WriteDoc",
            "to": "DocAttributes",
            "type": "label",
            "label": "WriteDoc to DocAttributes"
          },
          {
            "id": 3,
            "from": "DocAttributes",
            "to": "UploadDoc",
            "type": "label",
            "label": "DocAttributes to UploadDoc"
          },
          {
            "id": 4,
            "from": "UploadDoc",
            "to": "ReturnFile",
            "type": "label",
            "label": "UploadDoc to ReturnFile"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "WriteDoc",
            "name": "WriteDoc",
            "description": "Write the document text to a file (fileUpload takes a path)",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"POLICY_DOCS_DIR\"], \"/\", $flow.fileName)",
                    "overwrite": true,
                    "textContent": "=$flow.text"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "DocAttributes",
            "name": "DocAttributes",
            "description": "Document metadata to attach as file attributes",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "documentId": "=$flow.documentId",
                    "title": "=$flow.title",
                    "documentType": "=$flow.documentType",
                    "category": "=$flow.category",
                    "uri": "=$flow.uri",
                    "source": "=$flow.source"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"documentType\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"uri\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"documentType\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"uri\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"documentType\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"uri\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documentId\": {\n      \"type\": \"string\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"documentType\": {\n      \"type\": \"string\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"uri\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "UploadDoc",
            "name": "UploadDoc",
            "description": "Upload the file into the store (OpenAI chunks and embeds it); metadata as file attributes",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#fileUpload",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]",
                "operation": "Upload new file",
                "purpose": "assistants",
                "maxChunkSizeTokens": 800,
                "chunkOverlapTokens": 400,
                "timeoutSeconds": 300
              },
              "input": {
                "filename": "=string.concat($property[\"POLICY_DOCS_DIR\"], \"/\", $flow.fileName)",
                "fileId": "",
                "vectorStoreID": "=$flow.storeId",
                "fileAttributes": "=json.jq($activity[DocAttributes].output, \"to_entries | map({key: .key, value: (.value | tostring)}) | .[]\")"
              }
            }
          },
          {
            "id": "ReturnFile",
            "name": "ReturnFile",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "fileId": "=$activity[UploadDoc].id"
                }
              }
            }
          }
        ],
