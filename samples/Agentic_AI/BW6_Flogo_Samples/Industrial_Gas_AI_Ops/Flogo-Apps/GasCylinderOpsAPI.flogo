      "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"body\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"cylinderId\",\n        \"gasType\",\n        \"purityGrade\",\n        \"pressureBar\",\n        \"location\",\n        \"status\"\n      ],\n      \"properties\": {\n        \"cylinderId\": {\n          \"type\": \"string\",\n          \"description\": \"Barcode/Serial number\"\n        },\n        \"gasType\": {\n          \"type\": \"string\",\n          \"description\": \"Industrial gas classification\"\n        },\n        \"purityGrade\": {\n          \"type\": \"string\",\n          \"description\": \"Gas purity spec level (e.g. 5.0 for semiconductor grade)\"\n        },\n        \"pressureBar\": {\n          \"type\": \"integer\",\n          \"description\": \"Current fill pressure in bars\"\n        },\n        \"volumeLiters\": {\n          \"type\": \"integer\",\n          \"description\": \"Tank water volume capacity\"\n        },\n        \"location\": {\n          \"type\": \"string\",\n          \"description\": \"Current depot or yard identifier\"\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"Available\",\n            \"Reserved\",\n            \"In-Transit\",\n            \"Maintenance\"\n          ],\n          \"description\": \"Operational status\"\n        },\n        \"certExpiryDate\": {\n          \"type\": \"string\",\n          \"format\": \"date\",\n          \"description\": \"Safety inspection expiration date\"\n        }\n      }\n    }\n  }\n}",
