{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/flogo-general/src/app/General/activity/httpresponse",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/flow/activity/subflow",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/TIBCOSoftware/flogo-enterprise-hub/extensions/openAI/activity/vectorStoreList",
    "github.com/TIBCOSoftware/flogo-enterprise-hub/extensions/openAI/activity/vectorStoreCreate",
    "github.com/tibco/flogo-files/src/app/File/activity/write",
    "github.com/TIBCOSoftware/flogo-enterprise-hub/extensions/openAI/activity/fileUpload",
    "github.com/tibco/flogo-general/src/app/General/trigger/rest",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/array",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/string",
    "git.tibco.com/git/product/ipaas/wi-contrib.git/function/utility",
    "github.com/project-flogo/contrib/function/json"
  ],
  "name": "GasDocsIngestionAPI",
  "description": "Flogo modernization of BW6 RAG_Industrial_Gas_Ingestion: REST API + MCP server for the same operations",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#rest",
      "name": "tibco-wi-rest",
      "description": "upload service",
      "settings": {
        "port": "=$property[\"REST_PORT\"]",
        "APISpecUpdate": true,
        "swagger": "spec://09eac7fa-6fcb-4617-9ea0-41b9b8a57b6d",
        "swaggerVersion": "v3",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": "",
        "readHeaderTimeout": 0,
        "readTimeout": 0,
        "maxRequestBodySize": 15
      },
      "id": "upload_service",
      "handlers": [
        {
          "description": "Flow for upload POST",
          "settings": {
            "APISpecPath": "/upload",
            "Method": "POST",
            "reqType": "multipart/form-data",
            "Path": "/upload",
            "OutputValidation": false
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:post_upload_POST"
            },
            "input": {
              "body": "=$.body",
              "multipartFormData": "=$.multipartFormData"
            },
            "output": {
              "code": "=$.code",
              "responseBody": "=$.responseBody"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": true,
            "message": ""
          },
          "schemas": {
            "reply": {
              "responseBody": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}"
              },
              "responseCodesSchema": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"responseType\":{\"type\":\"string\"},\"responseSchema\":{\"type\":\"string\"}},\"required\":[\"code\",\"responseType\",\"responseSchema\"]}}",
                "fe_metadata": "[{\"code\":200,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"required\\\":[\\\"filePath\\\"],\\\"properties\\\":{\\\"filePath\\\":{\\\"type\\\":\\\"string\\\"}}}\"},{\"code\":400,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"error\\\":{\\\"type\\\":\\\"string\\\"},\\\"message\\\":{\\\"type\\\":\\\"string\\\"}}}\"},{\"code\":403,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"error\\\":{\\\"type\\\":\\\"string\\\"},\\\"message\\\":{\\\"type\\\":\\\"string\\\"}}}\"},{\"code\":404,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"error\\\":{\\\"type\\\":\\\"string\\\"},\\\"message\\\":{\\\"type\\\":\\\"string\\\"}}}\"},{\"code\":409,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"error\\\":{\\\"type\\\":\\\"string\\\"},\\\"message\\\":{\\\"type\\\":\\\"string\\\"}}}\"},{\"code\":422,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"error\\\":{\\\"type\\\":\\\"string\\\"},\\\"message\\\":{\\\"type\\\":\\\"string\\\"}}}\"},{\"code\":500,\"responseType\":\"object\",\"responseSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"error\\\":{\\\"type\\\":\\\"string\\\"},\\\"message\\\":{\\\"type\\\":\\\"string\\\"}}}\"}]"
              }
            },
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "[]"
              },
              "multipartFormData": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"files\":{\"type\":\"any\"},\"fileNames\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"files\":{\"type\":\"any\"},\"fileNames\":{\"type\":\"string\"}}}"
              },
              "multipartForm": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}}}}",
                "fe_metadata": "[{\"name\":\"files\",\"type\":\"string\"}]"
              }
            }
          },
          "name": "post_upload_POST"
        }
      ]
    },
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "MCP server for RAG_Industrial_Gas_Ingestion",
      "settings": {
        "serverName": "RAG_Industrial_Gas_Ingestion",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "mcp_server",
      "handlers": [
        {
          "description": "MCP tool post-upload: calls post_upload_POST and returns its body",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "post-upload",
            "handlerDescription": "postUpload",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:mcp_post_upload"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"required\": [\"files\"], \"properties\": {\"files\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"file contents, base64-encoded\"}, \"fileNames\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"original file names, same order\"}}}",
                "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"required\": [\"files\"], \"properties\": {\"files\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"file contents, base64-encoded\"}, \"fileNames\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"original file names, same order\"}}}"
              }
            }
          },
          "name": "mcp_post_upload"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:post_upload_POST",
      "data": {
        "name": "post_upload_POST",
        "description": "Flow for upload POST",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "array.count($flow.multipartFormData.files) == 0"
          },
          {
            "id": 3,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 4,
            "from": "Log_API",
            "to": "GetStore",
            "type": "expression",
            "label": "Log_API to GetStore",
            "value": "array.count($flow.multipartFormData.files) > 0"
          },
          {
            "id": 5,
            "from": "GetStore",
            "to": "AddFiles",
            "type": "label",
            "label": "GetStore to AddFiles"
          },
          {
            "id": 6,
            "from": "AddFiles",
            "to": "ConfigureHTTPResponse",
            "type": "label",
            "label": "AddFiles to ConfigureHTTPResponse"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for upload POST",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"upload files=\", coerce.toString(array.count($flow.multipartFormData.files)))",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "upload_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "files is required (multipart form field 'files')"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnBadRequest",
            "name": "ReturnBadRequest",
            "description": "Reply 400",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[BadRequest].code",
                  "responseBody": "=$activity[BadRequest].response"
                }
              }
            }
          },
          {
            "id": "GetStore",
            "name": "GetStore",
            "description": "Resolve the vector store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:ResolveStore",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "AddFiles",
            "name": "AddFiles",
            "description": "Write + upload each file",
            "type": "iterator",
            "settings": {
              "iterate": "=$flow.multipartFormData.files",
              "accumulate": true,
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AddFile",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "content": "=$iteration[value]",
                "index": "=$iteration[index]",
                "names": "=$flow.multipartFormData.fileNames",
                "storeId": "=$activity[GetStore].storeId"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"content\": {\"type\": \"any\"}, \"index\": {\"type\": \"integer\"}, \"names\": {\"type\": \"string\"}, \"storeId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"content\": {\"type\": \"any\"}, \"index\": {\"type\": \"integer\"}, \"names\": {\"type\": \"string\"}, \"storeId\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"fileName\": {\"type\": \"string\"}, \"fileId\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"fileName\": {\"type\": \"string\"}, \"fileId\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "upload_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "filePath": "=string.concat(\"Files uploaded to vector store successfully from the location : \", $property[\"DOCS_DIR\"])"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://FileDataBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"required\":[\"filePath\"],\"properties\":{\"filePath\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"required\":[\"filePath\"],\"properties\":{\"filePath\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Reply to API Call for upload POST",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[ConfigureHTTPResponse].code",
                  "responseBody": "=$activity[ConfigureHTTPResponse].response"
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "multipartFormData",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"files\":{\"type\":\"any\"},\"fileNames\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "requestURI",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\":{\"type\":\"object\",\"properties\":{}},\"headers\":{\"type\":\"object\",\"properties\":{}}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\": \"object\", \"properties\": {\"multipartFormData\": {\"type\": \"object\", \"properties\": {\"files\": {\"type\": \"any\"}, \"fileNames\": {\"type\": \"string\"}}}, \"requestURI\": {\"type\": \"string\"}, \"method\": {\"type\": \"string\"}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"responseBody\":{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{}},\"headers\":{\"type\":\"object\",\"properties\":{}}}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:mcp_post_upload",
      "data": {
        "name": "mcp_post_upload",
        "description": "MCP tool post-upload: calls post_upload_POST and returns its body",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Form",
            "type": "label",
            "label": "StartActivity to Form"
          },
          {
            "id": 2,
            "from": "Form",
            "to": "CallOperation",
            "type": "label",
            "label": "Form to CallOperation"
          },
          {
            "id": 3,
            "from": "CallOperation",
            "to": "Return",
            "type": "label",
            "label": "CallOperation to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Form",
            "name": "Form",
            "description": "Tool arguments -> the operation's multipart form",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "files": "=$flow.arguments.files",
                    "fileNames": "=coerce.toString($flow.arguments.fileNames) != \"\" ? utility.renderJSON($flow.arguments.fileNames, false) : \"\""
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"files\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"fileNames\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"files\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"fileNames\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"files\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"fileNames\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"files\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"fileNames\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "CallOperation",
            "name": "CallOperation",
            "description": "Run post_upload_POST (the REST operation)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:post_upload_POST",
                "detached": false,
                "execTimeout": 0,
                "transactional": false,
                "transactionConnection": ""
              },
              "input": {
                "input": {
                  "mapping": {}
                },
                "multipartFormData": "=$activity[Form].output"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"multipartFormData\": {\"type\": \"object\", \"properties\": {\"files\": {\"type\": \"any\"}, \"fileNames\": {\"type\": \"string\"}}}, \"requestURI\": {\"type\": \"string\"}, \"method\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"multipartFormData\": {\"type\": \"object\", \"properties\": {\"files\": {\"type\": \"any\"}, \"fileNames\": {\"type\": \"string\"}}}, \"requestURI\": {\"type\": \"string\"}, \"method\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
