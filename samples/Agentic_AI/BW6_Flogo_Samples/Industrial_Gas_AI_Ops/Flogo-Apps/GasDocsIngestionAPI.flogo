    {
      "id": "flow:ResolveStore",
      "data": {
        "name": "ResolveStore",
        "description": "The vector store named $property[VECTOR_STORE_NAME] (created on first use)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ListStores",
            "type": "label",
            "label": "StartActivity to ListStores"
          },
          {
            "id": 2,
            "from": "ListStores",
            "to": "FindStore",
            "type": "label",
            "label": "ListStores to FindStore"
          },
          {
            "id": 3,
            "from": "FindStore",
            "to": "ReturnExisting",
            "type": "expression",
            "label": "FindStore to ReturnExisting",
            "value": "array.count($activity[FindStore].output.matches) > 0"
          },
          {
            "id": 4,
            "from": "FindStore",
            "to": "CreateStore",
            "type": "expression",
            "label": "FindStore to CreateStore",
            "value": "array.count($activity[FindStore].output.matches) == 0"
          },
          {
            "id": 5,
            "from": "CreateStore",
            "to": "ReturnCreated",
            "type": "label",
            "label": "CreateStore to ReturnCreated"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ListStores",
            "name": "ListStores",
            "description": "List the account's vector stores",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorStoreList",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "limit": 100,
                "order": "",
                "after": "",
                "before": "",
                "timeoutSeconds": 60
              },
              "schemas": {
                "output": {
                  "vectorStores": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "FindStore",
            "name": "FindStore",
            "description": "The store with the configured name",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[ListStores].vectorStores,s, $loop[s].name == $property[\"VECTOR_STORE_NAME\"])": {
                        "id": "=$loop[s].id",
                        "name": "=$loop[s].name"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnExisting",
            "name": "ReturnExisting",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "storeId": "=$activity[FindStore].output.matches[0].id"
                }
              }
            }
          },
          {
            "id": "CreateStore",
            "name": "CreateStore",
            "description": "First use: create the store",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorStoreCreate",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "name": "=$property[\"VECTOR_STORE_NAME\"]",
                "description": "Industrial gas safety data sheets, manuals and certificates",
                "expiresAfterDays": 0,
                "maxChunkSizeTokens": 800,
                "chunkOverlapTokens": 400,
                "timeoutSeconds": 60,
                "fileIds": {
                  "mapping": []
                },
                "metadata": {
                  "mapping": []
                }
              }
            }
          },
          {
            "id": "ReturnCreated",
            "name": "ReturnCreated",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "storeId": "=$activity[CreateStore].id"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6NTl9LCJMaXN0U3RvcmVzIjp7IngiOjM1MCwieSI6NTB9LCJGaW5kU3RvcmUiOnsieCI6NjAwLCJ5Ijo1MH0sIlJldHVybkV4aXN0aW5nIjp7IngiOjg1MCwieSI6NTB9LCJDcmVhdGVTdG9yZSI6eyJ4Ijo4NTAsInkiOjIwMH0sIlJldHVybkNyZWF0ZWQiOnsieCI6MTEwMCwieSI6MjAwfX0=",
        "metadata": {
          "input": [],
          "output": [
            {
              "name": "storeId",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\": \"object\", \"properties\": {}}",
            "output": "{\"type\": \"object\", \"properties\": {\"storeId\": {\"type\": \"string\"}}}"
          }
        }
      }
    },
    {
      "id": "flow:AddFile",
      "data": {
        "name": "AddFile",
        "description": "Write one uploaded file and upload it into the vector store",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Name",
            "type": "label",
            "label": "StartActivity to Name"
          },
          {
            "id": 2,
            "from": "Name",
            "to": "WriteFile",
            "type": "label",
            "label": "Name to WriteFile"
          },
          {
            "id": 3,
            "from": "WriteFile",
            "to": "FileAttributes",
            "type": "label",
            "label": "WriteFile to FileAttributes"
          },
          {
            "id": 4,
            "from": "FileAttributes",
            "to": "UploadFile",
            "type": "label",
            "label": "FileAttributes to UploadFile"
          },
          {
            "id": 5,
            "from": "UploadFile",
            "to": "ReturnFile",
            "type": "label",
            "label": "UploadFile to ReturnFile"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Name",
            "name": "Name",
            "description": "Original file name from fileNames (the trigger drops it), else upload-<n>.txt",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "fileName": "=coerce.toString($flow.names) != \"\" && array.count(coerce.toArray($flow.names)) > $flow.index ? coerce.toString(array.get(coerce.toArray($flow.names), $flow.index)) : string.concat(\"upload-\", coerce.toString($flow.index + 1), \".txt\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WriteFile",
            "name": "WriteFile",
            "description": "Write the uploaded bytes (fileUpload reads a path)",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Binary",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"DOCS_DIR\"], \"/\", $activity[Name].output.fileName)",
                    "overwrite": true,
                    "binaryContent": "=string.replaceAll(utility.renderJSON($flow.content, false), \"\\\"\", \"\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"binaryContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"binaryContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"binaryContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"binaryContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "FileAttributes",
            "name": "FileAttributes",
            "description": "Metadata stored with the file (search returns it)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "fileName": "=$activity[Name].output.fileName",
                    "source": "upload"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fileName\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "UploadFile",
            "name": "UploadFile",
            "description": "Upload into the store (OpenAI chunks and embeds it)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#fileUpload",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]",
                "operation": "Upload new file",
                "purpose": "assistants",
                "maxChunkSizeTokens": 800,
                "chunkOverlapTokens": 400,
                "timeoutSeconds": 300
              },
              "input": {
                "filename": "=string.concat($property[\"DOCS_DIR\"], \"/\", $activity[Name].output.fileName)",
                "fileId": "",
                "vectorStoreID": "=$flow.storeId",
                "fileAttributes": "=json.jq($activity[FileAttributes].output, \"to_entries | map({key: .key, value: (.value | tostring)}) | .[]\")"
              }
            }
          },
          {
            "id": "ReturnFile",
            "name": "ReturnFile",
            "description": "Return the subflow outputs",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "fileName": "=$activity[Name].output.fileName",
                  "fileId": "=$activity[UploadFile].id"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIk5hbWUiOnsieCI6MjUwLCJ5Ijo0NX0sIldyaXRlRmlsZSI6eyJ4Ijo0NTAsInkiOjQ1fSwiRmlsZUF0dHJpYnV0ZXMiOnsieCI6NjUwLCJ5Ijo0NX0sIlVwbG9hZEZpbGUiOnsieCI6MjUwLCJ5IjoxOTV9LCJSZXR1cm5GaWxlIjp7IngiOjQ1MCwieSI6MTk1fX0=",
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "index",
              "type": "integer"
            },
            {
              "name": "names",
              "type": "string"
            },
            {
              "name": "storeId",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "fileName",
              "type": "string"
            },
            {
              "name": "fileId",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\": \"object\", \"properties\": {\"content\": {\"type\": \"any\"}, \"index\": {\"type\": \"integer\"}, \"names\": {\"type\": \"string\"}, \"storeId\": {\"type\": \"string\"}}}",
            "output": "{\"type\": \"object\", \"properties\": {\"fileName\": {\"type\": \"string\"}, \"fileId\": {\"type\": \"string\"}}}"
          }
        }
      }
    }
  ],
