          {
            "id": "ImageAnswer",
            "name": "ImageAnswer",
            "description": "HTTP 200 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "RAGImgQuery_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "answer": "=$activity[AskWithImages].responseBody.choices[0].message.content"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://AnswerBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"required\":[\"answer\"],\"properties\":{\"answer\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"required\":[\"answer\"],\"properties\":{\"answer\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnImageAnswer",
            "name": "ReturnImageAnswer",
            "description": "Reply 200",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[ImageAnswer].code",
