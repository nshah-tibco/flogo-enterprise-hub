                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"choices\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"object\", \"properties\": {\"content\": {\"type\": \"string\"}}}}}}}}"
                  },
