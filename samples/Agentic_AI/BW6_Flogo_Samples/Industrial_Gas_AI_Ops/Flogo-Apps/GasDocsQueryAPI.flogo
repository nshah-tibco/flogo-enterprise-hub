                "input": {
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Authorization\":{\"type\":\"string\",\"visible\":true}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\": \"Authorization\", \"type\": \"string\", \"repeating\": \"false\", \"required\": \"false\", \"visible\": true}]"
                  },
                  "dynamicRequestHeaders": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"Header\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"Header\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  },
                  "body": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\"}, \"max_completion_tokens\": {\"type\": \"integer\"}, \"messages\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\"}, \"max_completion_tokens\": {\"type\": \"integer\"}, \"messages\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}}}}"
                  }
