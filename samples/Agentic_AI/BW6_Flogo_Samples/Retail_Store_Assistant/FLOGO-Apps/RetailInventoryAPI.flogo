    {
      "id": "flow:check_inventory_GET",
      "data": {
        "name": "check_inventory_GET",
        "description": "Flow for api/inventory/availability GET",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.queryParams.sku) == \"\" || coerce.toString($flow.queryParams.storeId) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "ReferenceData",
            "type": "expression",
            "label": "Log_API to ReferenceData",
            "value": "coerce.toString($flow.queryParams.sku) != \"\" && coerce.toString($flow.queryParams.storeId) != \"\""
          },
          {
            "id": 4,
            "from": "ReferenceData",
            "to": "FindStock",
            "type": "label",
            "label": "ReferenceData to FindStock"
          },
          {
            "id": 5,
            "from": "FindStock",
            "to": "AnyStock",
            "type": "label",
            "label": "FindStock to AnyStock"
          },
          {
            "id": 6,
            "from": "AnyStock",
            "to": "FindProduct",
            "type": "label",
            "label": "AnyStock to FindProduct"
          },
          {
            "id": 7,
            "from": "FindProduct",
            "to": "ConfigureHTTPResponse",
            "type": "expression",
            "label": "FindProduct to ConfigureHTTPResponse",
            "value": "array.count($activity[FindProduct].output.matches) > 0 && array.count($activity[FindStock].output.matches) > 0"
          },
          {
            "id": 8,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 9,
            "from": "FindProduct",
            "to": "UnknownStockNamed",
            "type": "expression",
            "label": "FindProduct to UnknownStockNamed",
            "value": "array.count($activity[FindProduct].output.matches) > 0 && array.count($activity[AnyStock].output.matches) > 0 && array.count($activity[FindStock].output.matches) == 0"
          },
          {
            "id": 10,
            "from": "FindProduct",
            "to": "UnknownStock",
            "type": "expression",
            "label": "FindProduct to UnknownStock",
            "value": "array.count($activity[FindProduct].output.matches) == 0 || array.count($activity[AnyStock].output.matches) == 0"
          },
          {
            "id": 11,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 12,
            "from": "UnknownStockNamed",
            "to": "ReturnUnknownStockNamed",
            "type": "label",
            "label": "UnknownStockNamed to ReturnUnknownStockNamed"
          },
          {
            "id": 13,
            "from": "UnknownStock",
            "to": "ReturnUnknownStock",
            "type": "label",
            "label": "UnknownStock to ReturnUnknownStock"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/inventory/availability GET",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Log API call for check_inventory_GET",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
