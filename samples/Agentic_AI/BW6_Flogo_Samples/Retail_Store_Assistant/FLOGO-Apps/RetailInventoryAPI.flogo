          {
            "id": "FindProduct",
            "name": "FindProduct",
            "description": "Product with the requested sku",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[ProductData].output.products,p, $loop[p].sku == $flow.body.sku)": {
                        "sku": "=$loop[p].sku",
                        "name": "=$loop[p].name",
                        "brand": "=$loop[p].brand",
                        "category": "=$loop[p].category",
                        "price": "=$loop[p].price",
                        "description": "=$loop[p].description",
                        "attributes": "=$loop[p].attributes"
                      }
                    }
                  }
                }
