          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "inventory_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "sku": "=$activity[FindProduct].output.matches[0].sku",
                      "name": "=$activity[FindProduct].output.matches[0].name",
                      "brand": "=$activity[FindProduct].output.matches[0].brand",
                      "category": "=$activity[FindProduct].output.matches[0].category",
                      "price": "=$activity[FindProduct].output.matches[0].price",
                      "description": "=$activity[FindProduct].output.matches[0].description",
                      "attributes": {
                        "color": "=$activity[FindProduct].output.matches[0].attributes.color",
                        "gender": "=$activity[FindProduct].output.matches[0].attributes.gender",
                        "use": "=$activity[FindProduct].output.matches[0].attributes.use",
                        "returnWindowDays": "=$activity[FindProduct].output.matches[0].attributes.returnWindowDays",
                        "warrantyMonths": "=$activity[FindProduct].output.matches[0].attributes.warrantyMonths",
