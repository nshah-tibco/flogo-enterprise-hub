          {
            "id": "FindStock",
            "name": "FindStock",
            "description": "Inventory record for sku + store",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[ReferenceData].output.inventory,i, $loop[i].sku == $flow.body.sku && $loop[i].storeId == $flow.body.storeId)": {
                        "sku": "=$loop[i].sku",
                        "storeId": "=$loop[i].storeId",
                        "quantity": "=$loop[i].quantity",
                        "aisle": "=$loop[i].aisle",
                        "status": "=$loop[i].status"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
