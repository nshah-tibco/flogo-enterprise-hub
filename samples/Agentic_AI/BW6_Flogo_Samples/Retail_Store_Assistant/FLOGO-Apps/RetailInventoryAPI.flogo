    {
      "id": "flow:post_api_inventory_tools_get_product_POST",
      "data": {
        "name": "post_api_inventory_tools_get_product_POST",
        "description": "Flow for api/inventory/tools/get_product POST",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.body.sku) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "ProductData",
            "type": "expression",
            "label": "Log_API to ProductData",
            "value": "coerce.toString($flow.body.sku) != \"\""
          },
          {
            "id": 4,
            "from": "ProductData",
            "to": "FindProduct",
            "type": "label",
            "label": "ProductData to FindProduct"
          },
          {
            "id": 5,
            "from": "FindProduct",
            "to": "NotFound",
            "type": "expression",
            "label": "FindProduct to NotFound",
            "value": "array.count($activity[FindProduct].output.matches) == 0"
          },
          {
            "id": 6,
            "from": "FindProduct",
            "to": "ConfigureHTTPResponse",
            "type": "expression",
            "label": "FindProduct to ConfigureHTTPResponse",
            "value": "array.count($activity[FindProduct].output.matches) > 0"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 8,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 9,
            "from": "NotFound",
            "to": "ReturnNotFound",
            "type": "label",
            "label": "NotFound to ReturnNotFound"
          }
        ],
