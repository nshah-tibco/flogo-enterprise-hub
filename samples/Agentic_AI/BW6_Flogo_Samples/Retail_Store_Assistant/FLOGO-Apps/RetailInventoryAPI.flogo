    {
      "id": "flow:get_product_GET",
      "data": {
        "name": "get_product_GET",
        "description": "Flow for api/inventory/products/{sku} GET",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.pathParams.sku) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "ProductData",
            "type": "expression",
            "label": "Log_API to ProductData",
            "value": "coerce.toString($flow.pathParams.sku) != \"\""
          },
          {
            "id": 4,
            "from": "ProductData",
            "to": "FindProduct",
            "type": "label",
            "label": "ProductData to FindProduct"
          },
          {
            "id": 5,
            "from": "FindProduct",
            "to": "NotFound",
            "type": "expression",
            "label": "FindProduct to NotFound",
            "value": "array.count($activity[FindProduct].output.matches) == 0"
          },
          {
            "id": 6,
            "from": "FindProduct",
            "to": "ConfigureHTTPResponse",
            "type": "expression",
            "label": "FindProduct to ConfigureHTTPResponse",
            "value": "array.count($activity[FindProduct].output.matches) > 0"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 8,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 9,
            "from": "NotFound",
            "to": "ReturnNotFound",
            "type": "label",
            "label": "NotFound to ReturnNotFound"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/inventory/products/{sku} GET",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Log API call for get_product_GET",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "inventory_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "sku is required"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
