          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "inventory_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "sku": "=$activity[FindStock].output.matches[0].sku",
                      "storeId": "=$activity[FindStock].output.matches[0].storeId",
                      "quantity": "=$activity[FindStock].output.matches[0].quantity",
                      "aisle": "=$activity[FindStock].output.matches[0].aisle",
                      "status": "=$activity[FindStock].output.matches[0].status",
                      "productName": "=$activity[FindProduct].output.matches[0].name"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ToolAvailabilityBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"productName\":{\"type\":\"string\"},\"quantity\":{\"type\":\"integer\",\"format\":\"int32\"},\"aisle\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"productName\":{\"type\":\"string\"},\"quantity\":{\"type\":\"integer\",\"format\":\"int32\"},\"aisle\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Reply to API Call for api/inventory/tools/check_inventory POST",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[ConfigureHTTPResponse].code",
                  "responseBody": "=$activity[ConfigureHTTPResponse].response"
                }
              }
            }
          },
          {
            "id": "StockWithoutProduct",
            "name": "StockWithoutProduct",
            "description": "HTTP 200 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "inventory_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "sku": "=$activity[FindStock].output.matches[0].sku",
                      "storeId": "=$activity[FindStock].output.matches[0].storeId",
                      "quantity": "=$activity[FindStock].output.matches[0].quantity",
                      "aisle": "=$activity[FindStock].output.matches[0].aisle",
                      "status": "=$activity[FindStock].output.matches[0].status"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ToolAvailabilityBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"productName\":{\"type\":\"string\"},\"quantity\":{\"type\":\"integer\",\"format\":\"int32\"},\"aisle\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"productName\":{\"type\":\"string\"},\"quantity\":{\"type\":\"integer\",\"format\":\"int32\"},\"aisle\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "NotFound",
            "name": "NotFound",
            "description": "HTTP 404 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "inventory_service",
                "responsecode": "404",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "inventory_not_found",
                      "message": "=string.concat(\"No inventory record for sku \", $flow.body.sku, \" at store \", $flow.body.storeId)"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "activity": {
              "input": {
                "mappings": []
