            "type": "expression",
            "label": "Log_API to ReferenceData",
            "value": "coerce.toString($flow.body.sku) != \"\" && coerce.toString($flow.body.storeId) != \"\""
          },
          {
            "id": 4,
            "from": "ReferenceData",
            "to": "FindStock",
            "type": "label",
            "label": "ReferenceData to FindStock"
          },
          {
            "id": 5,
            "from": "FindStock",
            "to": "FindProduct",
            "type": "label",
            "label": "FindStock to FindProduct"
          },
          {
            "id": 6,
            "from": "FindProduct",
            "to": "ConfigureHTTPResponse",
            "type": "expression",
            "label": "FindProduct to ConfigureHTTPResponse",
            "value": "array.count($activity[FindStock].output.matches) > 0 && array.count($activity[FindProduct].output.matches) > 0"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 8,
            "from": "FindProduct",
            "to": "StockWithoutProduct",
            "type": "expression",
            "label": "FindProduct to StockWithoutProduct",
            "value": "array.count($activity[FindStock].output.matches) > 0 && array.count($activity[FindProduct].output.matches) == 0"
          },
          {
            "id": 9,
            "from": "FindProduct",
            "to": "NotFound",
            "type": "expression",
            "label": "FindProduct to NotFound",
            "value": "array.count($activity[FindStock].output.matches) == 0"
          },
          {
            "id": 10,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 11,
            "from": "StockWithoutProduct",
            "to": "ReturnStockWithoutProduct",
            "type": "label",
            "label": "StockWithoutProduct to ReturnStockWithoutProduct"
          },
          {
            "id": 12,
            "from": "NotFound",
            "to": "ReturnNotFound",
            "type": "label",
            "label": "NotFound to ReturnNotFound"
          }
        ],
