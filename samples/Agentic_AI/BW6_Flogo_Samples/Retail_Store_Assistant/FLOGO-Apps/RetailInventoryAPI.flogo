              "ref": "#httpresponse",
              "input": {
                "trigger": "inventory_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "tools": [
                        {
                          "name": "get_product",
                          "description": "Look up product details by SKU.",
                          "inputSchema": {
                            "type": "object",
                            "required": [
                              "sku"
                            ]
                          }
                        },
                        {
                          "name": "check_inventory",
                          "description": "Check inventory for a product at a store.",
                          "inputSchema": {
                            "type": "object",
                            "required": [
                              "sku",
                              "storeId"
                            ]
                          }
                        },
                        {
                          "name": "reserve_inventory",
                          "description": "Reserve one unit of inventory for a customer at a store. Requires human approval.",
                          "safety": "write_requires_approval",
                          "inputSchema": {
                            "type": "object",
                            "required": [
                              "sku",
                              "storeId",
                              "customerId"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              },
