    {
      "id": "flow:get_api_inventory_tools_GET",
      "data": {
        "name": "get_api_inventory_tools_GET",
        "description": "Flow for api/inventory/tools GET",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
