                "State": "f23b3ca3-14b6-4477-b8a6-9a612cf88951SELECT TOP 25 CONVERT(nvarchar(36), c.conversation_id) AS conversation_id, c.user_id, c.customer_id, c.store_id, c.title, COUNT(m.message_id) AS message_count FROM retail_conversations c LEFT JOIN retail_conversation_messages m ON m.conversation_id = c.conversation_id GROUP BY c.conversation_id, c.user_id, c.customer_id, c.store_id, c.title, c.created_at, c.updated_at ORDER BY c.updated_at DESC;"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
