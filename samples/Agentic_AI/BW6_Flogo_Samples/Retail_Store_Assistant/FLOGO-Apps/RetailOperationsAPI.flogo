          {
            "id": "RecentConversations",
            "name": "RecentConversations",
            "description": "Latest conversations with message counts",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://69d27528-b7a0-4604-8591-de5039176d3f",
                "querytimeout": 0,
                "Schema": "dbo",
                "QueryName": "",
                "Query": "SELECT TOP 25 CONVERT(nvarchar(36), c.conversation_id) AS conversation_id, c.user_id, c.customer_id, c.store_id, c.title, COUNT(m.message_id) AS message_count FROM retail_conversations c LEFT JOIN retail_conversation_messages m ON m.conversation_id = c.conversation_id GROUP BY c.conversation_id, c.user_id, c.customer_id, c.store_id, c.title, c.created_at, c.updated_at ORDER BY c.updated_at DESC;",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "conversation_id",
                    "Type": "WVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "user_id",
                    "Type": "WVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "customer_id",
                    "Type": "WVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "store_id",
                    "Type": "WVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false,
                    "Value": true
