                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ConfigureHTTPResponse",
            "name": "ConfigureHTTPResponse",
            "description": "Configure HTTP Response Activity",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "operations_service",
                "responsecode": "200",
                "input": {
                  "mapping": {
                    "body": {
                      "scenarios": [
                        {
                          "id": "policy-grounding",
                          "title": "Policy Grounding",
                          "goal": "Show RAG retrieval and citation-backed answer generation.",
                          "question": "What is the electronics return policy?",
                          "userId": "USR-ASSOCIATE-001",
                          "customerId": "CUST-001",
                          "storeId": "SFO-001",
                          "expected": [
                            "retrieval",
                            "citations",
                            "no approval"
                          ]
                        },
                        {
                          "id": "inventory-tools",
                          "title": "Inventory Lookup",
                          "goal": "Show entity extraction plus inventory and product tools.",
                          "question": "Is RUN-PEG-001 available at SFO-001?",
                          "userId": "USR-ASSOCIATE-001",
                          "customerId": "CUST-001",
                          "storeId": "SFO-001",
                          "expected": [
                            "product tool",
                            "inventory tool",
                            "aisle result"
                          ]
                        },
                        {
                          "id": "return-flow",
                          "title": "Return Eligibility",
                          "goal": "Show order lookup, policy retrieval, and return eligibility.",
                          "question": "Can I return order ORD-1001?",
                          "userId": "USR-ASSOCIATE-001",
                          "customerId": "CUST-001",
                          "storeId": "SFO-001",
                          "expected": [
                            "order tool",
                            "return tool",
                            "policy citation"
                          ]
                        },
                        {
                          "id": "approval-reservation",
                          "title": "Approval Gate",
                          "goal": "Show the agent pausing before a state-changing reservation.",
                          "question": "Reserve RUN-PEG-001 at SFO-001 for CUST-001.",
                          "userId": "USR-MANAGER-001",
                          "customerId": "CUST-001",
                          "storeId": "SFO-001",
                          "expected": [
                            "approval required",
                            "manager approval",
                            "persisted reservation"
                          ]
                        },
                        {
                          "id": "promotion-agent",
                          "title": "Recommendation + Promotion",
                          "goal": "Show recommendation reasoning, promotion lookup, and approval safety.",
                          "question": "Find a rain jacket under $150 in SFO-001 and apply any promotion.",
                          "userId": "USR-MANAGER-001",
                          "customerId": "CUST-001",
                          "storeId": "SFO-001",
                          "expected": [
                            "recommendation",
                            "promotion tool",
                            "approval required"
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ScenariosBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"scenarios\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"goal\":{\"type\":\"string\"},\"question\":{\"type\":\"string\"},\"userId\":{\"type\":\"string\"},\"customerId\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"expected\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}}}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"scenarios\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"goal\":{\"type\":\"string\"},\"question\":{\"type\":\"string\"},\"userId\":{\"type\":\"string\"},\"customerId\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"},\"expected\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueItems\":false}}}}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
