                      {
                        "userId": "USR-CUSTOMER-001",
                        "name": "Casey Customer",
                        "role": "customer",
                        "customerId": "CUST-001",
                        "storeId": "SFO-001"
                      },
                      {
                        "userId": "USR-ASSOCIATE-001",
                        "name": "Avery Associate",
                        "role": "store_associate",
                        "customerId": "CUST-001",
                        "storeId": "SFO-001"
                      },
                      {
                        "userId": "USR-MANAGER-001",
