            "name": "Return",
            "description": "Reply to API Call for api/demo/scenarios GET",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[ConfigureHTTPResponse].code",
                  "responseBody": "=$activity[ConfigureHTTPResponse].response"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIkNvbmZpZ3VyZUhUVFBSZXNwb25zZSI6eyJ4Ijo0NTAsInkiOjQ1fSwiUmV0dXJuIjp7IngiOjY1MCwieSI6NDV9fQ==",
