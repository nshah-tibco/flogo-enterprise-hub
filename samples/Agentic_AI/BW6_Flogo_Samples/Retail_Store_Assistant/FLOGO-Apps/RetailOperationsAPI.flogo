    {
      "id": "flow:post_api_approve_POST",
      "data": {
        "name": "post_api_approve_POST",
        "description": "Flow for api/approve POST",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.body.userId) == \"\" || (string.matchRegEx(\"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$\", coerce.toString($flow.body.approvalId))) == false || (coerce.toString($flow.body.conversationId) != \"\" && (string.matchRegEx(\"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$\", coerce.toString($flow.body.conversationId))) == false)"
          },
          {
            "id": 3,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 4,
            "from": "Log_API",
            "to": "UserData",
            "type": "expression",
            "label": "Log_API to UserData",
            "value": "(coerce.toString($flow.body.userId) == \"\" || (string.matchRegEx(\"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$\", coerce.toString($flow.body.approvalId))) == false || (coerce.toString($flow.body.conversationId) != \"\" && (string.matchRegEx(\"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$\", coerce.toString($flow.body.conversationId))) == false)) == false"
          },
          {
            "id": 5,
            "from": "UserData",
            "to": "FindUser",
            "type": "label",
            "label": "UserData to FindUser"
          },
          {
            "id": 6,
            "from": "FindUser",
            "to": "Forbidden",
            "type": "expression",
            "label": "FindUser to Forbidden",
            "value": "(array.count($activity[FindUser].output.matches) > 0 && ($activity[FindUser].output.matches[0].role == \"store_manager\" || $activity[FindUser].output.matches[0].role == \"admin\")) == false"
          },
          {
            "id": 7,
            "from": "Forbidden",
            "to": "ReturnForbidden",
            "type": "label",
            "label": "Forbidden to ReturnForbidden"
          },
          {
            "id": 8,
            "from": "FindUser",
            "to": "GetPendingApproval",
            "type": "expression",
            "label": "FindUser to GetPendingApproval",
            "value": "array.count($activity[FindUser].output.matches) > 0 && ($activity[FindUser].output.matches[0].role == \"store_manager\" || $activity[FindUser].output.matches[0].role == \"admin\")"
          },
          {
            "id": 9,
            "from": "GetPendingApproval",
            "to": "NotFound",
            "type": "expression",
            "label": "GetPendingApproval to NotFound",
            "value": "array.count($activity[GetPendingApproval].Output.records) == 0"
          },
          {
            "id": 10,
            "from": "NotFound",
            "to": "ReturnNotFound",
            "type": "label",
            "label": "NotFound to ReturnNotFound"
          },
          {
            "id": 11,
            "from": "GetPendingApproval",
            "to": "InsertReservation",
            "type": "expression",
            "label": "GetPendingApproval to InsertReservation",
            "value": "array.count($activity[GetPendingApproval].Output.records) > 0 && $activity[GetPendingApproval].Output.records[0].tool_name == \"reserve_inventory\""
          },
          {
            "id": 12,
            "from": "InsertReservation",
            "to": "ApprovedBy",
            "type": "label",
            "label": "InsertReservation to ApprovedBy"
          },
          {
            "id": 13,
            "from": "ApprovedBy",
            "to": "ApprovalResult",
            "type": "label",
            "label": "ApprovedBy to ApprovalResult"
          },
          {
            "id": 14,
            "from": "ApprovalResult",
            "to": "CompleteApproval",
            "type": "label",
            "label": "ApprovalResult to CompleteApproval"
          },
          {
            "id": 15,
            "from": "CompleteApproval",
            "to": "TouchConversation",
            "type": "expression",
            "label": "CompleteApproval to TouchConversation",
            "value": "coerce.toString($flow.body.conversationId) != \"\""
          },
          {
            "id": 16,
            "from": "TouchConversation",
            "to": "AppendSystemMessage",
            "type": "label",
            "label": "TouchConversation to AppendSystemMessage"
          },
          {
            "id": 17,
            "from": "AppendSystemMessage",
            "to": "ConfigureHTTPResponse",
            "type": "label",
            "label": "AppendSystemMessage to ConfigureHTTPResponse"
          },
          {
            "id": 18,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 19,
            "from": "CompleteApproval",
            "to": "ApprovedNoConversation",
            "type": "expression",
            "label": "CompleteApproval to ApprovedNoConversation",
            "value": "(coerce.toString($flow.body.conversationId) != \"\") == false"
          },
          {
            "id": 20,
            "from": "ApprovedNoConversation",
            "to": "ReturnApprovedNoConversation",
            "type": "label",
            "label": "ApprovedNoConversation to ReturnApprovedNoConversation"
          },
          {
            "id": 21,
            "from": "GetPendingApproval",
            "to": "InsertReturnAuthorization",
            "type": "expression",
            "label": "GetPendingApproval to InsertReturnAuthorization",
            "value": "array.count($activity[GetPendingApproval].Output.records) > 0 && $activity[GetPendingApproval].Output.records[0].tool_name == \"create_return_authorization\""
          },
          {
            "id": 22,
            "from": "InsertReturnAuthorization",
            "to": "ApprovedBy",
            "type": "label",
            "label": "InsertReturnAuthorization to ApprovedBy"
          },
          {
            "id": 23,
            "from": "GetPendingApproval",
            "to": "InsertPromotionApplication",
            "type": "expression",
            "label": "GetPendingApproval to InsertPromotionApplication",
            "value": "array.count($activity[GetPendingApproval].Output.records) > 0 && $activity[GetPendingApproval].Output.records[0].tool_name == \"apply_promotion\""
          },
          {
            "id": 24,
            "from": "InsertPromotionApplication",
            "to": "ApprovedBy",
            "type": "label",
            "label": "InsertPromotionApplication to ApprovedBy"
          },
          {
            "id": 25,
            "from": "GetPendingApproval",
            "to": "UnsupportedTool",
            "type": "expression",
            "label": "GetPendingApproval to UnsupportedTool",
            "value": "array.count($activity[GetPendingApproval].Output.records) > 0 && $activity[GetPendingApproval].Output.records[0].tool_name != \"reserve_inventory\" && $activity[GetPendingApproval].Output.records[0].tool_name != \"create_return_authorization\" && $activity[GetPendingApproval].Output.records[0].tool_name != \"apply_promotion\""
          },
          {
            "id": 26,
            "from": "UnsupportedTool",
            "to": "ReturnUnsupportedTool",
            "type": "label",
            "label": "UnsupportedTool to ReturnUnsupportedTool"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/approve POST",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Log API call for post_api_approve_POST",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "operations_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "approvalId (a GUID) and userId are required; conversationId must be a GUID when given"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnBadRequest",
            "name": "ReturnBadRequest",
            "description": "Reply with the branch response",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[BadRequest].code",
                  "responseBody": "=$activity[BadRequest].response"
                }
              }
            }
          },
          {
            "id": "UserData",
