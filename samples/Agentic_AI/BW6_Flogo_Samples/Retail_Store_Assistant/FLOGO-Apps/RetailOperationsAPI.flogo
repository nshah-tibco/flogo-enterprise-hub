                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"users\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"userId\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"},\"customerId\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"}}}}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"users\":{\"type\":\"array\",\"items\":{\"uniqueItems\":false,\"type\":\"object\",\"properties\":{\"userId\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"},\"customerId\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"}}}}}}}}"
