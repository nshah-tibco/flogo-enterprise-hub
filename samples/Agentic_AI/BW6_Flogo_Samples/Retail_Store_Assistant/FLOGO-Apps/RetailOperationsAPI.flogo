                        "role": "store_manager",
                        "customerId": "CUST-001",
                        "storeId": "SFO-001"
                      },
                      {
                        "userId": "USR-ADMIN-001",
                        "name": "Alex Admin",
                        "role": "admin",
                        "customerId": "CUST-001",
                        "storeId": "SFO-001"
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
