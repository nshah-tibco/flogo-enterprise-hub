                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"conversation_id\":{\"type\":\"string\"},\"user_id\":{\"type\":\"string\"},\"customer_id\":{\"type\":\"string\"},\"store_id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"message_count\":{\"type\":\"integer\"}}}}}}"
