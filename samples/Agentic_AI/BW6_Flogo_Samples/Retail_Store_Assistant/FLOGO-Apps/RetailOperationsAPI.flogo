            "description": "Approving user (BW ResolveUser)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[UserData].output.users,u, $loop[u].userId == $flow.body.userId)": {
                        "userId": "=$loop[u].userId",
                        "name": "=$loop[u].name",
                        "role": "=$loop[u].role",
                        "customerId": "=$loop[u].customerId",
