                "InsertStatement": "INSERT INTO retail_reservations ( reservation_id, approval_id, sku, product_name, store_id, customer_id, quantity_reserved, expires_in_minutes ) VALUES (?reservation_id, ?approval_id, ?sku, ?product_name, ?store_id, ?customer_id, 1, 90);",
