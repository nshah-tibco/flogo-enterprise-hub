                "QueryName": "",
                "Query": "SELECT CONVERT(nvarchar(36), c.conversation_id) AS conversation_id, c.user_id, c.customer_id, c.store_id, c.title, COUNT(m.message_id) AS message_count FROM retail_conversations c LEFT JOIN retail_conversation_messages m ON m.conversation_id = c.conversation_id WHERE c.conversation_id = ?conversation_id GROUP BY c.conversation_id, c.user_id, c.customer_id, c.store_id, c.title, c.created_at, c.updated_at;",
