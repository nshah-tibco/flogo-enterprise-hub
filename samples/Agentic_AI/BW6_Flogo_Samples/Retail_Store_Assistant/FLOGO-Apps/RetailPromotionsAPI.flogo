          {
            "id": "NotFound",
            "name": "NotFound",
            "description": "HTTP 404 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "promotions_service",
                "responsecode": "404",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "customer_not_found",
                      "message": "=string.concat(\"No customer found with id \", $flow.queryParams.customerId)"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
