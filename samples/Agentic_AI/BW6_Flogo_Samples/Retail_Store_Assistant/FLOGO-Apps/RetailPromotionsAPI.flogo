  "resources": [
    {
      "id": "flow:find_promotions_GET",
      "data": {
        "name": "find_promotions_GET",
        "description": "Flow for api/promotions GET",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "BadRequest",
            "type": "expression",
            "label": "Log_API to BadRequest",
            "value": "coerce.toString($flow.queryParams.customerId) == \"\" || coerce.toString($flow.queryParams.category) == \"\""
          },
          {
            "id": 3,
            "from": "Log_API",
            "to": "CustomerData",
            "type": "expression",
            "label": "Log_API to CustomerData",
            "value": "coerce.toString($flow.queryParams.customerId) != \"\" && coerce.toString($flow.queryParams.category) != \"\""
          },
          {
            "id": 4,
            "from": "CustomerData",
            "to": "FindCustomer",
            "type": "label",
            "label": "CustomerData to FindCustomer"
          },
          {
            "id": 5,
            "from": "FindCustomer",
            "to": "NotFound",
            "type": "expression",
            "label": "FindCustomer to NotFound",
            "value": "array.count($activity[FindCustomer].output.matches) == 0"
          },
          {
            "id": 6,
            "from": "FindCustomer",
            "to": "ConfigureHTTPResponse",
            "type": "expression",
            "label": "FindCustomer to ConfigureHTTPResponse",
            "value": "array.count($activity[FindCustomer].output.matches) > 0"
          },
          {
            "id": 7,
            "from": "ConfigureHTTPResponse",
            "to": "Return",
            "type": "label",
            "label": "ConfigureHTTPResponse to Return"
          },
          {
            "id": 8,
            "from": "BadRequest",
            "to": "ReturnBadRequest",
            "type": "label",
            "label": "BadRequest to ReturnBadRequest"
          },
          {
            "id": 9,
            "from": "NotFound",
            "to": "ReturnNotFound",
            "type": "label",
            "label": "NotFound to ReturnNotFound"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Log API Call for api/promotions GET",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"find_promotions queryParams=\", coerce.toString($flow.queryParams))",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": "",
                "dynamicLogFields": {
                  "mapping": {}
                }
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"value\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BadRequest",
            "name": "BadRequest",
            "description": "HTTP 400 response",
            "activity": {
              "ref": "#httpresponse",
              "input": {
                "trigger": "promotions_service",
                "responsecode": "400",
                "input": {
                  "mapping": {
                    "body": {
                      "error": "invalid_request",
                      "message": "customerId, category are required"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ErrorBody"
                },
                "output": {
                  "response": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "CustomerData",
            "name": "CustomerData",
            "description": "Embedded customer list (BW ParseCustomerJSON literal)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "customers": [
                      {
                        "customerId": "CUST-001",
                        "name": "Avery Chen",
                        "loyaltyTier": "Gold",
                        "preferredStoreId": "SFO-001",
                        "preferences": [
                          "running",
                          "lightweight gear",
                          "blue"
                        ]
                      },
                      {
                        "customerId": "CUST-002",
                        "name": "Jordan Lee",
                        "loyaltyTier": "Silver",
                        "preferredStoreId": "OAK-002",
                        "preferences": [
                          "hiking",
                          "waterproof outerwear"
                        ]
                      },
                      {
                        "customerId": "CUST-003",
                        "name": "Priya Shah",
                        "loyaltyTier": "Member",
                        "preferredStoreId": "SFO-001",
                        "preferences": [
                          "fitness electronics",
                          "commuting"
                        ]
                      },
                      {
                        "customerId": "CUST-004",
                        "name": "Marcus Reed",
                        "loyaltyTier": "Platinum",
                        "preferredStoreId": "SJC-003",
                        "preferences": [
                          "travel",
                          "bags",
                          "hydration"
                        ]
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customerId\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"loyaltyTier\": {\n            \"type\": \"string\"\n          },\n          \"preferredStoreId\": {\n            \"type\": \"string\"\n          },\n          \"preferences\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customerId\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"loyaltyTier\": {\n            \"type\": \"string\"\n          },\n          \"preferredStoreId\": {\n            \"type\": \"string\"\n          },\n          \"preferences\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customerId\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"loyaltyTier\": {\n            \"type\": \"string\"\n          },\n          \"preferredStoreId\": {\n            \"type\": \"string\"\n          },\n          \"preferences\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customerId\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"loyaltyTier\": {\n            \"type\": \"string\"\n          },\n          \"preferredStoreId\": {\n            \"type\": \"string\"\n          },\n          \"preferences\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "FindCustomer",
            "name": "FindCustomer",
            "description": "Select matching items (BW for-each with predicate)",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[CustomerData].output.customers,c, $loop[c].customerId == $flow.queryParams.customerId)": {
                        "customerId": "=$loop[c].customerId",
                        "name": "=$loop[c].name",
                        "loyaltyTier": "=$loop[c].loyaltyTier",
                        "preferredStoreId": "=$loop[c].preferredStoreId",
                        "preferences": "=$loop[c].preferences"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customerId\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"loyaltyTier\": {\n            \"type\": \"string\"\n          },\n          \"preferredStoreId\": {\n            \"type\": \"string\"\n          },\n          \"preferences\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  }\n}",
