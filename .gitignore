.DS_Store
.vscode
.mcp.json
bin

# --- Build artifacts ---
# Windows executables / libraries
*.exe
*.dll
# macOS / Linux shared libraries
*.dylib
*.so

# Flogo compiled app binaries.
# flogobuild produces a Windows .exe (covered above) or an EXTENSION-LESS
# executable on Linux/macOS (darwin/linux GOOS). Since those have no extension,
# ignore everything under Flogo_Apps/ except the .flogo source and subfolders.
Flogo_Apps/*
!Flogo_Apps/*/
!Flogo_Apps/*.flogo
!Flogo_Apps/.gitignore

# Flogo build output: any "builds/" directory holds packaged artifacts
# (flogo-engine binaries, .zip bundles, values.yaml, deploy payloads).
builds/
# Extension-less Flogo engine binaries wherever they land.
flogo-engine
*_linux
*_darwin
# Runtime / build logs.
*.log
# Packaged archives (build outputs, backups).
*.zip
# Test run output.
test-results/

# Local skills config holds real credentials (API keys, tokens, passwords).
# Track config.example.md instead; each user copies it to config.md locally.
skills-library/.claude/skills/config.md
