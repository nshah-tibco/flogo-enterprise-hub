.DS_Store
.vscode
.mcp.json
bin

# --- Node.js ---
# Installed dependencies for the demo chatbots / mcp-proxy. Never commit these;
# they are restored with `npm install`.
node_modules/
npm-debug.log*

# --- Build artifacts ---
# Windows executables / libraries
*.exe
*.dll
# macOS / Linux shared libraries
*.dylib
*.so

# Flogo compiled app binaries.
# flogobuild produces a Windows .exe (covered above) or an EXTENSION-LESS
# executable on Linux/macOS (darwin/linux GOOS). Since those have no extension,
# ignore everything under Flogo_Apps/ except the .flogo source and subfolders.
Flogo_Apps/*
!Flogo_Apps/*/
!Flogo_Apps/*.flogo
!Flogo_Apps/.gitignore

# Flogo build output: any "builds/" directory holds packaged artifacts
# (flogo-engine binaries, .zip bundles, values.yaml, deploy payloads).
builds/
# Extension-less Flogo engine binaries wherever they land.
flogo-engine
*_linux
*_darwin
# Runtime / build logs.
*.log
# Packaged archives (build outputs, backups).
*.zip
# Architecture decks / slide exports are kept local (large binaries, not runnable content).
*.pptx
*.ppt
# Test run output.
test-results/

# --- Python ---
# Byte-compiled / cache files from the demo build/helper scripts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Secrets & environment files ---
# Never commit real credentials. Environment files are ignored by default;
# the tracked *.env.example templates (safe placeholders) are re-included.
.env
*.env
!*.env.example
!.env.example
# Defensive: keys / certs / keystores should not be committed. (Any demo certs
# already tracked upstream are unaffected; this only blocks NEW accidental adds.)
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# --- Local scratch / generated artifacts (not shipped) ---
# Generated architecture PNG exports.
demos/Agentic_AI/_deck_png/
# Generated report artifacts.
reports/
# Local conversation dumps (may contain PII / PHI).
conversations/

# Local skills config holds real credentials (API keys, tokens, passwords).
# Track config.example.md instead; each user copies it to config.md locally.
skills-library/.claude/skills/config.md

# FDA-rebuilt Hospital apps: local verification copies whose .flogo files have
# live secrets (OpenAI key, SMTP app password, DB password) baked in as property
# values. Kept out of the repo so they can't be committed by accident.
demos/Agentic_AI/Hospital_FDA_Rebuild/

# Air Liquide demo (BW6 stack): kept local — carries obfuscated provider creds
# and third-party fixture docs not cleared for redistribution.
demos/Agentic_AI/air_liquide_demo/

# Local scratch / scaffold projects at the repo root (throwaway experiments,
# not demo content). Root-anchored so real demo .flogo files are unaffected.
/flogo-project.flogo
/flogo3.flogo
/testflogo3/
