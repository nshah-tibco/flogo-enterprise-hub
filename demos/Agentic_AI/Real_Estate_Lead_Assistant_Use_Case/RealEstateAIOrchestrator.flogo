      "name": "AgenticAI.OpenAIConn.API_Key",
      "type": "string",
      "value": "SET_YOUR_OPENAI_API_KEY"
    },
    {
      "name": "AgenticAI.OpenAIConn.LLM_Base_URL",
      "type": "string",
      "value": "https://api.openai.com/v1"
    },
    {
      "name": "LLM_Model",
      "type": "string",
      "value": "gpt-5.5"
    },
    {
      "name": "WebSocket_PORT",
      "type": "float64",
      "value": 9590
    }
  ],
