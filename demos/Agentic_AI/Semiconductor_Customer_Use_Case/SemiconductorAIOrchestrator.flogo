{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "SemiconductorAIOrchestrator",
  "description": "Semiconductor Customer Assistant Orchestrator - WebSocket chat that routes intent to MCP read tools and A2A write agents",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "Websocket server listens for connection request from the client",
      "settings": {
        "port": "=$property[\"Websocket_PORT\"]",
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "",
          "settings": {
            "method": "GET",
            "path": "/semiconductor",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers",
              "content": "=$.content",
              "wsconnection": "=$.wsconnection"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Key\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Version\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Upgrade\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator Flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "Configure AI Agent in the flow",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://a1b2c3d4-0001-4eee-8fff-000000008080",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://a1b2c3d4-0003-4eee-8fff-000000008730",
                  "conn://a1b2c3d4-0004-4eee-8fff-000000008731",
                  "conn://a1b2c3d4-0005-4eee-8fff-000000008732",
                  "conn://a1b2c3d4-0006-4eee-8fff-000000008733",
                  "conn://a1b2c3d4-0007-4eee-8fff-000000008734",
                  "conn://a1b2c3d4-0008-4eee-8fff-000000008735"
                ],
                "mcpServers": [
                  "conn://a1b2c3d4-0002-4eee-8fff-000000009098"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Semiconductor Customer Assistant — a self-service AI for design engineers and procurement buyers at customer companies (OEMs, automotive tier-1s, distributors). You help them look up parts, stock, pricing, orders, lifecycle status and cross-references, and — on their confirmation — place orders, expedite orders, open RMA/quality cases, request samples, and subscribe to alerts. All prices are in USD.\n\nIDENTIFY THE USER: Customers identify themselves by an account id in the form CUST-100xx (e.g. CUST-10001). If the user has not given their account id and you need it, ask once. Never ask for internal database ids, line ids, or surrogate keys — the tools and agents derive those.\n\nREAD INTENTS -> MCP TOOLS:\n- Account / company / contact / tier -> GetCustomerProfile\n- Part specs, package, RoHS, automotive/AEC qualification, datasheet, lifecycle field -> GetProductDetails\n- Stock / availability / lead time / warehouse -> CheckStockAndLeadTime\n- Price / quantity pricing / price break -> GetPricing\n- Order status / my orders -> GetOrders (use GetOrderLines for line-level detail: parts, quantities, dates)\n- End-of-life / discontinuation / PCN / last-time-buy -> GetLifecycleNotices\n- Alternative / replacement / cross-reference / second-source / pin-compatible -> GetCrossReferences\n- RMA / return / quality-case status -> GetRMAStatus\n- Sample request status -> GetSampleStatus\n- My alert subscriptions -> GetAlertSubscriptions\n\nACTION INTENTS -> A2A AGENTS (always confirm the specifics with the user before any write):\n- Place / buy an order -> place_order_agent. Generate a new order id SO-2026-NNNN. First look up the correct price break (GetPricing) and stock/lead time (CheckStockAndLeadTime); then pass customer_id, the generated order_id, part_number, quantity, unit_price, requested_date, promised_date, po_number (if given) and total_amount.\n- Expedite / pull in the requested date on an existing order line -> expedite_order_agent. Pass order_id, part_number, new_requested_date.\n- Open an RMA / quality complaint / report defective parts -> open_rma_agent. Generate a new id RMA-2026-NNNN. Pass customer_id, order_id (if known), part_number, quantity, defect_type, description.\n- Request free samples -> request_sample_agent. Generate a new id SMP-2026-NNNN. Pass customer_id, part_number, quantity, purpose, ship_to.\n- Subscribe to stock or PCN/EOL alerts -> subscribe_alert_agent. Pass customer_id, part_number, alert_type (STOCK or PCN).\n- Email a confirmation -> send_confirmation_email. Call ONLY AFTER a write agent returns success, exactly once, and last. Pass a clear subject and body summarizing what was done.\n\nRULES:\n- Always confirm the specifics (part, quantity, price, dates) before any write action.\n- Call the email agent only after a successful write; never email or claim success for a failed or skipped action.\n- Honor conditional requests literally (\"if it's EOL, subscribe me\" -> check lifecycle first, act only if the condition holds).\n- Map values exactly to the fields each agent expects; do not pass ids the agent derives itself.\n- Only state facts returned by the tools. Prices are USD.\n\nOUT OF SCOPE (politely decline): circuit, thermal or PCB design advice; competitor cross-brand pricing or price-matching; changing credit/payment terms or contracts; parts not in the catalog; product roadmaps or unreleased parts.\n\nTone: professional, concise, technically fluent — you are speaking to engineers and buyers."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": ""
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Websocket Write Data Activity will write data to existing Websocket connection",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkFJQWdlbnQiOnsieCI6MjUwLCJ5IjoxNTB9LCJXZWJzb2NrZXRXcml0ZURhdGEiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
