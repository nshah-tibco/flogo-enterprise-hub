                "fe_metadata": "{\"customer_id\":\"CUST-10005\",\"part_number\":\"ESD1CANQ\",\"quantity\":25,\"purpose\":\"Design-in evaluation\",\"ship_to\":\"Meridian Medical Devices, Boston MA, USA\",\"sample_id\":\"SMP-2026-1001\"}"
