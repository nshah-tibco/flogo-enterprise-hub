                "Query": "INSERT INTO alert_subscriptions (customer_id, part_number, alert_type, email, status, created_date) SELECT c.customer_id, ?part_number1, ?alert_type1, c.email, 'Active', CURRENT_DATE FROM customers c WHERE c.customer_id = ?customer_id1;",
