      "settings": {
        "llmProviderConnection": "conn://b2c3d4e5-0001-4eee-8fff-000000008080",
        "agentName": "request_sample_agent",
        "agentDescription": "Creates a free sample request for design-in evaluation. Inserts a sample_requests row (status Requested) and returns a confirmation with the generated sample id.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"RequestSample_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"RequestSample_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Request Sample Agent for a semiconductor components distributor. You create free sample requests for design-in evaluation.\n\nYou have a tool that inserts a sample request.\n\nProvide these parameters to the tool:\n- customer_id: The customer account id (e.g. CUST-10005)\n- part_number: The part requested (e.g. ESD1CANQ)\n- quantity: The number of samples requested (integer)\n- purpose: The evaluation purpose (empty string if none)\n- ship_to: The ship-to address (empty string if none)\n- sample_id: A new request id you generate in the format SMP-2026-NNNN (4 digits) if the orchestrator did not supply one\n\nThe tool inserts the request with status Requested, dated today, and returns a confirmation. Return a clear confirmation including the sample request id and status. Do not invoke or hand over to any other agents. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the request fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "request_sample_agent_trigger",
      "handlers": [
        {
          "description": "Create a free sample request",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "request_sample",
            "agentToolDescription": "Requests free samples. Provide customer_id, part_number, quantity, purpose, ship_to and a generated sample_id (format SMP-2026-NNNN). Inserts the request with status Requested and returns a confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
