    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b2c3d4e5-0001-4eee-8fff-000000008080",
        "agentName": "send_confirmation_email",
        "agentDescription": "Sends a single confirmation email after an action (order, expedite, RMA, sample, subscription) is complete. The recipient delivery address is preconfigured, so a customer email address is optional. Must only be invoked once, at the very end, after the action is confirmed.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SendEmail_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"SendEmail_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": false,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "None",
        "memoryMaxSize": 10,
        "systemPrompt": "You are the Confirmation Email Agent for a semiconductor customer assistant. You send a single confirmation email after an action (order placed, order expedited, RMA opened, sample requested, or alert subscribed) has been completed.\n\nIMPORTANT DELIVERY NOTE: The recipient delivery address is already preconfigured in the email service. You do NOT need the customer's email address to send the email. NEVER refuse to send, and NEVER report failure, because an email address was not provided. Always dispatch the email using the subject and body you are given. A customer email address, if provided, is optional and may only be referenced inside the body for the customer's records.\n\nYour task: ALWAYS call your send tool exactly once to dispatch the confirmation email using the provided subject and body. If the subject or body are incomplete, compose a professional email that includes any available details (ids, part numbers, quantities, prices in USD, dates, status) plus next steps and a note to contact customer support for questions.\n\nFormat the email in plain text with clear sections and line breaks. Use a warm, professional tone and address the customer by name when known. Send the email exactly once. Do not send multiple emails under any circumstances. Only report a failure if the underlying send tool itself returns an error. Do not invoke or hand over to any other agents."
      },
      "id": "send_confirmation_email_trigger",
      "handlers": [
        {
          "description": "Send a single confirmation email",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "send_confirmation_email",
            "agentToolDescription": "Sends a single confirmation email after an action has completed. Invoke only ONCE and only after the action is done. Provide the subject and body; the recipient delivery address is preconfigured, so the customer email address is optional.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:send_email_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": {
                "mapping": {
                  "data": "=$.response.data",
                  "error": "=$.response.error"
                }
              }
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"email\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"email\":\"\",\"subject\":\"\",\"body\":\"\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "send_email_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:place_order_flow",
      "data": {
        "name": "place_order_flow",
        "description": "Create a new sales order (header + line)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          },
          {
            "id": 2,
            "from": "LogMessage",
            "to": "PostgreSQLInsert",
            "type": "label",
            "label": "LogMessage to PostgreSQLInsert"
          },
          {
            "id": 3,
            "from": "PostgreSQLInsert",
            "to": "PostgreSQLInsert2",
            "type": "label",
            "label": "PostgreSQLInsert to PostgreSQLInsert2"
          },
          {
            "id": 4,
            "from": "PostgreSQLInsert2",
            "to": "LogMessage1",
            "type": "label",
            "label": "PostgreSQLInsert2 to LogMessage1"
          },
          {
            "id": 5,
            "from": "LogMessage1",
            "to": "Return",
            "type": "label",
            "label": "LogMessage1 to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"Agent Invocation started: \",$flowctx[\"FlowName\"], \" Placing order \", $flow.toolParams.order_id, \" for customer \", $flow.toolParams.customer_id)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "PostgreSQLInsert",
            "name": "PostgreSQLInsert",
            "description": "Insert order header",
            "settings": {
              "retryOnError": {
