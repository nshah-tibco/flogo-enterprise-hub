{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/contrib/function/string",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "PowerDistributionA2AServers",
  "description": "Electric Power Distribution A2A Servers - Outage dispatch, service appointment, service change, and confirmation email agents (write workflows)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999683",
        "agentName": "outage_dispatch_agent",
        "agentDescription": "Logs a customer-reported power outage and opens an outage ticket for crew dispatch. Takes the account, premise address, and a description of the outage, creates a ticket with status OPEN and a ~4 hour estimated restoration, and returns a confirmation with the ticket ID and ETA.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"OutageDispatch_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"OutageDispatch_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Outage Dispatch Agent for an electric power distribution utility. You log customer-reported loss-of-power events and open an outage ticket for crew dispatch.\n\nYou have access to a tool that creates an outage ticket for the customer's premise.\n\nProvide these parameters to the tool:\n- account_id: The residential account ID (e.g. ACCT-50010001)\n- premise_address: The service address where power is out\n- description: A clear description of the outage the customer is reporting\n- ticket_id: A new outage ticket reference you generate in the format OTKT-2026-XXXX (4 digits)\n\nThe tool inserts the ticket with status OPEN, a reported timestamp of now, and an estimated restoration (ETA) of 4 hours from now, and returns a confirmation.\n\nReturn a clear, reassuring response including:\n- The outage ticket ID and its OPEN status\n- The estimated restoration time (about 4 hours from now)\n- A note that a crew will be dispatched and the customer can check the ticket status anytime\n\nNote: this logs an individual customer's outage. Area-wide outage information is handled separately by the orchestrator.\n\nDo not invoke or hand over to any other agents. Your only responsibility is logging the outage ticket. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the ticket creation fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "outage_dispatch_agent_trigger",
      "handlers": [
        {
          "description": "Log a customer-reported outage and create an outage ticket for crew dispatch",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "report_outage",
            "agentToolDescription": "Creates an outage ticket for a customer-reported loss of power. Provide account_id, premise_address, description, and a generated ticket_id (format OTKT-2026-XXXX). Inserts the ticket with status OPEN, reported timestamp now, and an ETA of 4 hours from now. Returns the confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:outage_report_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"account_id\":{\"type\":\"string\"},\"premise_address\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"ticket_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"account_id\": \"ACCT-50010001\", \"premise_address\": \"412 Cedar Springs Rd, Cedar Springs, TX 75001\", \"description\": \"Total loss of power at residence since 2pm; neighbors also affected.\", \"ticket_id\": \"OTKT-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "outage_report_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999683",
        "agentName": "service_appointment_agent",
        "agentDescription": "Schedules a field service appointment (meter inspection, new service, tree trim, meter upgrade, or site survey) at a customer's premise. Books the appointment with status SCHEDULED and returns a confirmation with the appointment ID, type, date, and time window.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"ServiceAppointment_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"ServiceAppointment_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Service Appointment Agent for an electric power distribution utility. You schedule field service appointments at a customer's premise (meter inspections, new service, tree trimming near lines, meter upgrades, and site surveys).\n\nYou have access to a tool that books a field service appointment.\n\nProvide these parameters to the tool:\n- account_id: The residential account ID (e.g. ACCT-50010001)\n- appt_type: One of METER_INSPECTION, NEW_SERVICE, TREE_TRIM, METER_UPGRADE, SITE_SURVEY\n- scheduled_date: The requested date as text (e.g. 2026-08-05)\n- time_window: The arrival window (e.g. 8:00 AM - 12:00 PM)\n- notes: Optional notes about the appointment (pass an empty string if none)\n- appointment_id: A new appointment reference you generate in the format APPT-2026-XXXX (4 digits)\n\nThe tool inserts the appointment with status SCHEDULED and a created timestamp of now, and returns a confirmation.\n\nReturn a clear confirmation including the appointment ID, the appointment type, the scheduled date, and the arrival time window.\n\nDo not invoke or hand over to any other agents. Your only responsibility is booking the appointment. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If booking fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "service_appointment_agent_trigger",
      "handlers": [
        {
          "description": "Book a field service appointment on the customer account",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "schedule_appointment",
            "agentToolDescription": "Books a field service appointment. Provide account_id, appt_type (METER_INSPECTION, NEW_SERVICE, TREE_TRIM, METER_UPGRADE, SITE_SURVEY), scheduled_date, time_window, optional notes, and a generated appointment_id (format APPT-2026-XXXX). Inserts the appointment with status SCHEDULED. Returns the confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:appointment_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"account_id\":{\"type\":\"string\"},\"appt_type\":{\"type\":\"string\"},\"scheduled_date\":{\"type\":\"string\"},\"time_window\":{\"type\":\"string\"},\"notes\":{\"type\":\"string\"},\"appointment_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"account_id\": \"ACCT-50010001\", \"appt_type\": \"METER_INSPECTION\", \"scheduled_date\": \"2026-08-05\", \"time_window\": \"8:00 AM - 12:00 PM\", \"notes\": \"Customer reports flickering lights.\", \"appointment_id\": \"APPT-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "appointment_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999683",
        "agentName": "service_change_agent",
        "agentDescription": "Files a residential service change request (reconnect, disconnect, or transfer). Submits the request with status SUBMITTED and returns a confirmation with the request ID, type, and status.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"ServiceChange_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"ServiceChange_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Service Change Agent for an electric power distribution utility. You submit residential service change requests: reconnecting service, disconnecting service, or transferring service to a new address.\n\nYou have access to a tool that files a service change request.\n\nProvide these parameters to the tool:\n- account_id: The residential account ID (e.g. ACCT-50010007)\n- request_type: One of RECONNECT, DISCONNECT, TRANSFER\n- effective_date: The requested effective date as text (e.g. 2026-08-01)\n- reason: A clear reason for the request\n- request_id: A new request reference you generate in the format SRV-2026-XXXX (4 digits)\n\nThe tool inserts the request with status SUBMITTED and a created timestamp of now, and returns a confirmation.\n\nReturn a clear confirmation including the request ID, the request type, and its SUBMITTED status.\n\nDo not invoke or hand over to any other agents. Your only responsibility is filing the service change request. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If filing fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "service_change_agent_trigger",
      "handlers": [
        {
          "description": "File a reconnect, disconnect, or transfer service change request",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "submit_service_request",
            "agentToolDescription": "Files a service change request. Provide account_id, request_type (RECONNECT, DISCONNECT, TRANSFER), effective_date, reason, and a generated request_id (format SRV-2026-XXXX). Inserts the request with status SUBMITTED. Returns the confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:service_change_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"account_id\":{\"type\":\"string\"},\"request_type\":{\"type\":\"string\"},\"effective_date\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"},\"request_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"account_id\": \"ACCT-50010007\", \"request_type\": \"RECONNECT\", \"effective_date\": \"2026-08-01\", \"reason\": \"Past-due balance cleared; requesting reconnection.\", \"request_id\": \"SRV-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
