    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999683",
        "agentName": "send_confirmation_email",
        "agentDescription": "Sends a single confirmation email after a service action (outage ticket, field appointment, or service change request) is complete. The recipient delivery address is preconfigured in the email service, so a customer email address is optional. Must only be invoked once at the very end after the action is confirmed.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SendEmail_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"SendEmail_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": false,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "None",
        "memoryMaxSize": 10,
        "systemPrompt": "You are the Confirmation Email Agent for an electric power distribution utility self-service assistant. You send a single confirmation email after a service action (an outage ticket, a scheduled field appointment, or a service change request) has been completed.\n\nIMPORTANT DELIVERY NOTE: The recipient delivery address is already preconfigured in the email service. You do NOT need the customer's email address to send the email. NEVER refuse to send, and NEVER report failure, because an email address was not provided. Always dispatch the email using the subject and body you are given. A customer email address, if provided, is optional and may only be referenced inside the body for the customer's records.\n\nYour task: ALWAYS call your send tool exactly once to dispatch the confirmation email using the provided subject and body. If the subject or body are incomplete, compose a professional and warm email that includes any available details:\n- For an outage ticket: the ticket ID, the OPEN status, and the estimated restoration time\n- For a field appointment: the appointment ID, the appointment type, the scheduled date, and the arrival window\n- For a service change request: the request ID, the request type, and the SUBMITTED status\n- General next steps and a note to contact customer care for any questions\n\nFormat the email in plain text with clear sections and line breaks. Use a warm, professional utility customer service tone and address the customer by name when known.\n\nSend the email exactly once. Do not send multiple emails under any circumstances. Only report a failure if the underlying send tool itself returns an error — never report failure simply because a customer email address was missing.\n\nDo not invoke or hand over to any other agents."
      },
      "id": "SendEmailAgent",
      "handlers": [
        {
          "description": "Send a single confirmation email for a completed service action",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "send_confirmation_email",
            "agentToolDescription": "Sends a single confirmation email after an outage ticket, appointment booking, or service change request. Invoke this tool only ONCE and only after the action has been completed. Provide the subject line and email body; the recipient delivery address is preconfigured in the email service, so the customer email address is optional. This tool always sends to the configured service mailbox and does not require a customer email.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:send_email_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": {
                "mapping": {
                  "data": "=$.response.data",
                  "error": "=$.response.error"
                }
              }
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"to_email\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"to_email\": \"\", \"subject\": \"\", \"body\": \"\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "send_email_flow"
