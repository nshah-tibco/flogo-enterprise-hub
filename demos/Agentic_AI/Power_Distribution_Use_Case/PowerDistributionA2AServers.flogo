                "Query": "INSERT INTO outage_tickets (ticket_id, account_id, premise_address, description, status, reported_at, eta) VALUES (?ticket_id1, ?account_id1, ?premise_address1, ?description1, 'OPEN', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP + INTERVAL '4 hours');",
                "manualmode": false,
                "Fields": [
