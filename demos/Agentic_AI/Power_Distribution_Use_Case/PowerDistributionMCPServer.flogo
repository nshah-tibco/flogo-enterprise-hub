{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "PowerDistributionMCPServer",
  "description": "Electric Power Distribution MCP Server - Exposes read-only residential self-service lookup tools (accounts, invoices, usage, payments, rate plans, outages, tickets, appointments, service requests) as AI tools via PostgreSQL",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Electric Power Distribution MCP server for Agentic AI - Residential Self-Service",
      "settings": {
        "serverName": "PowerDistributionSelfService",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/grid-bss",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "PowerDistributionMCPServer",
      "handlers": [
        {
          "description": "Retrieve all residential customer account records",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetCustomerAccounts",
            "handlerDescription": "Get all residential electric account records including account_id (ACCT-XXXXXXXX), phone on file, first and last name, email, service_address, city, state, zip, segment (Residential, Residential-EV, Residential-Solar-NetMeter, Residential-Medical-Baseline, Residential-Budget-Billing), account_status (ACTIVE, PAST_DUE, FINAL), meter_number, meter_type (SMART, ANALOG), connection_status (CONNECTED, DISCONNECTED, PENDING), rate_plan_id, feeder_id, and enrolled_date. Use this FIRST to identify a customer by their account number, phone number, or service address, and to read their connection status, meter, feeder, and rate plan.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getCustomerAccounts"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "getCustomerAccounts"
        },
        {
          "description": "Retrieve all invoices with their line items",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetInvoiceDetails",
            "handlerDescription": "Get all electric invoices joined with their itemized line items. Each row has the invoice header (invoice_id INV-2026-06-XXXX, account_id, billing_month, period_start, period_end, subtotal, taxes_fees, total_amount, currency USD, due_date, status Unpaid/Paid/Overdue) and one line item (category such as BASE_CHARGE, DELIVERY, TOU_ON_PEAK, TOU_OFF_PEAK, RIDER, SOLAR_CREDIT, MEDICAL_BASELINE_CREDIT, BUDGET_BILLING, ESTIMATED_READ, TAXES_FEES; a description; and line_amount). Use this to explain a bill line by line, find an unpaid invoice to pay, or locate a specific invoice for an account.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getInvoiceDetails"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "getInvoiceDetails"
        },
        {
          "description": "Retrieve all metered usage records",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetUsageRecords",
            "handlerDescription": "Get all metered kWh usage records including account_id, billing_period, kwh_used, peak_demand_kw, on_peak_kwh, off_peak_kwh, solar_export_kwh, avg_daily_kwh, days_in_period, prior_year_kwh, and read_type (ACTUAL or ESTIMATED). Use this to explain WHY a bill is high or low: compare kwh_used against prior_year_kwh, split on-peak vs off-peak for time-of-use/EV plans, show solar export, and detect ESTIMATED reads (analog meters not read this cycle).",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getUsageRecords"
            },
