        {
          "description": "Retrieve all residential rate plans",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetRatePlans",
            "handlerDescription": "Get the residential delivery rate plan catalog including plan_id (RP-STD, RP-TOU, RP-EV, RP-SOLAR), plan_name, description, base_service_charge (fixed monthly $), delivery_per_kwh (flat plans), tou_enabled, on_peak_per_kwh and off_peak_per_kwh (time-of-use / EV plans). Use this to explain what rate plan a customer is on, break down the $/kWh rates behind their charges, or compare plans (e.g. whether an EV owner would save on the EV overnight rate).",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
