        {
          "description": "Retrieve all active area-level outages",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetOutages",
            "handlerDescription": "Get all active AREA-level outages including outage_id (OUT-2026-XXXX), feeder_id, zip, area, cause (STORM, EQUIPMENT, VEGETATION, PLANNED), status (INVESTIGATING, CREW_ASSIGNED, RESTORING, RESTORED), start_time, estimated_restoration, and customers_affected. Use this to answer 'is there an outage near me?' by matching the customer's zip or feeder_id (from GetCustomerAccounts) to an outage, and to give the estimated restoration time. This is area-wide outage info; to log a customer's individual loss of power, use the outage_dispatch_agent instead.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
