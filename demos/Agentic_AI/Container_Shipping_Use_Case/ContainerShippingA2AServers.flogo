    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999983",
        "agentName": "submit_claim_agent",
        "agentDescription": "Submits a protection claim against a member's policy. Validates the policy, then inserts the claim with status Submitted dated today. Returns the policy context and a confirmation with the new claim ID.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SubmitClaim_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"SubmitClaim_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Submit Claim Agent for a life & pensions provider. Your single responsibility is to submit a protection claim against a member's policy by inserting a claim record. You do nothing else.\n\nYou have access to one tool that validates the policy and then inserts the claim.\n\nCollect and provide these parameters to the tool:\n- policy_id: The policy the claim is made against (e.g. POL-2026-1001)\n- member_id: The member ID (e.g. MBR-100001)\n- claim_type: The type of claim. Must be exactly one of: Life, CriticalIllness, IncomeProtection, Disability\n- amount: The claim amount in USD (numeric)\n- description: A short description of the claim\n- claim_id: A new claim reference you generate in the format CLM-2026-XXX (3 digits)\n\nThe tool first returns the policy details for validation context, then inserts the claim with status Submitted, dated today, and confirms.\n\nReturn a clear confirmation including the new claim ID, the policy, the claim type, and the amount, plus a note that the claim is now Submitted and under review.\n\nDo not invoke or hand over to any other agents. Your only responsibility is this single action. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the action fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "submit_claim_agent_trigger",
      "handlers": [
        {
          "description": "Validate the policy and insert a submitted claim record",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "submit_claim",
            "agentToolDescription": "Submits a protection claim. Provide policy_id, member_id, claim_type (Life/CriticalIllness/IncomeProtection/Disability), amount (USD), description, and a generated claim_id (format CLM-2026-XXX). Validates the policy and inserts the claim. Returns validation context and confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:submit_claim_flow"
            },
            "input": {
