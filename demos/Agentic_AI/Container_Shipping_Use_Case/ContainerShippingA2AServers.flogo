                "fe_metadata": "{\"policy_id\": \"POL-2026-1001\", \"member_id\": \"MBR-100001\", \"claim_type\": \"Life\", \"amount\": 500000, \"description\": \"Life protection claim\", \"claim_id\": \"CLM-2026-101\"}"
