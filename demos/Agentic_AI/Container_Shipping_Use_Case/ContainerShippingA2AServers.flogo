{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "LifePensionsA2AServers",
  "description": "A2A write-action agents for the Life & Pensions Member Assistant: update beneficiary, change contribution, fund switch, submit claim, book adviser callback, send confirmation email.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999983",
        "agentName": "update_beneficiary_agent",
        "agentDescription": "Updates the nominated beneficiary on a member's policy. Validates the policy's existing beneficiaries, then inserts the new beneficiary record (primary, effective today). Returns the previous beneficiary context and a confirmation with the new beneficiary ID.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"UpdateBeneficiary_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"UpdateBeneficiary_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Update Beneficiary Agent for a life & pensions provider. Your single responsibility is to update the nominated beneficiary on a member's policy by inserting a new beneficiary record. You do nothing else.\n\nYou have access to one tool that validates the policy's existing beneficiaries and then inserts the new beneficiary record.\n\nCollect and provide these parameters to the tool:\n- policy_id: The policy the beneficiary belongs to (e.g. POL-2026-1001)\n- beneficiary_id: A new beneficiary reference you generate in the format BEN-2026-XXXX (4 digits)\n- beneficiary_name: The full name of the beneficiary\n- relationship: The beneficiary's relationship to the member. Must be exactly one of: Spouse, Child, Parent, Sibling, Trust, Other\n- share_pct: The percentage share of the benefit (numeric, e.g. 100)\n\nThe tool first returns the current beneficiaries on the policy for validation context, then inserts the new beneficiary (marked primary, effective today) and confirms.\n\nReturn a clear confirmation including the new beneficiary ID, name, relationship, and share percentage, plus a short note of the previous beneficiary arrangement.\n\nDo not invoke or hand over to any other agents. Your only responsibility is this single action. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the action fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "update_beneficiary_agent_trigger",
      "handlers": [
        {
          "description": "Validate policy beneficiaries and insert an updated beneficiary record",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "update_beneficiary",
            "agentToolDescription": "Updates a policy beneficiary. Provide policy_id, a generated beneficiary_id (format BEN-2026-XXXX), beneficiary_name, relationship (Spouse/Child/Parent/Sibling/Trust/Other), and share_pct. Validates existing beneficiaries and inserts the new record. Returns validation context and confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:update_beneficiary_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"policy_id\":{\"type\":\"string\"},\"beneficiary_id\":{\"type\":\"string\"},\"beneficiary_name\":{\"type\":\"string\"},\"relationship\":{\"type\":\"string\"},\"share_pct\":{\"type\":\"number\"}}}",
                "fe_metadata": "{\"policy_id\": \"POL-2026-1001\", \"beneficiary_id\": \"BEN-2026-1001\", \"beneficiary_name\": \"Sarah Carter\", \"relationship\": \"Spouse\", \"share_pct\": 100}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "update_beneficiary_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999983",
        "agentName": "change_contribution_agent",
        "agentDescription": "Records a change to a member's retirement account contribution. Validates the retirement account, then inserts a new Employee Monthly contribution effective today. Returns the account context and a confirmation with the new contribution ID.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"ChangeContribution_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"ChangeContribution_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Change Contribution Agent for a life & pensions provider. Your single responsibility is to record a change to a member's retirement account contribution by inserting a new contribution record. You do nothing else.\n\nYou have access to one tool that validates the retirement account and then inserts the new contribution.\n\nCollect and provide these parameters to the tool:\n- member_id: The member ID (e.g. MBR-100001)\n- account_id: The retirement account ID being contributed to (e.g. RET-5001)\n- amount: The new monthly contribution amount in USD (numeric)\n- contribution_id: A new contribution reference you generate in the format CON-2026-XXXX (4 digits)\n\nThe contribution is recorded as an Employee, Monthly contribution effective today.\n\nReturn a clear confirmation including the new contribution ID, the account, and the amount, and explain that the new monthly contribution takes effect from the next pay cycle.\n\nDo not invoke or hand over to any other agents. Your only responsibility is this single action. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the action fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "change_contribution_agent_trigger",
      "handlers": [
        {
          "description": "Validate the retirement account and insert a new contribution record",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "change_contribution",
            "agentToolDescription": "Changes a retirement account contribution. Provide member_id, account_id, amount (USD), and a generated contribution_id (format CON-2026-XXXX). Validates the account and inserts the new contribution. Returns validation context and confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:change_contribution_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"member_id\":{\"type\":\"string\"},\"account_id\":{\"type\":\"string\"},\"amount\":{\"type\":\"number\"},\"contribution_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"member_id\": \"MBR-100001\", \"account_id\": \"RET-5001\", \"amount\": 766.66, \"contribution_id\": \"CON-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "change_contribution_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899999983",
        "agentName": "fund_switch_agent",
        "agentDescription": "Requests a fund switch within a member's retirement account. Validates the account's current fund holdings, then inserts a fund switch request with status Requested. Returns the holdings context and a confirmation with the new switch ID.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"FundSwitch_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"FundSwitch_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Fund Switch Agent for a life & pensions provider. Your single responsibility is to request a fund switch within a member's retirement account by inserting a fund switch record. You do nothing else.\n\nYou have access to one tool that validates the account's current fund holdings and then inserts the fund switch request.\n\nCollect and provide these parameters to the tool:\n- account_id: The retirement account ID (e.g. RET-5001)\n- from_fund_id: The fund to switch out of (e.g. FND-001)\n- to_fund_id: The fund to switch into (e.g. FND-005)\n- amount: The amount to switch in USD (numeric)\n- switch_id: A new switch reference you generate in the format SWT-2026-XXXX (4 digits)\n\nThe tool first returns the account's current holdings (fund, risk level, value, allocation) for validation context, then inserts the switch request with status Requested and confirms.\n\nReturn a clear confirmation including the new switch ID, the from/to funds, and the amount, plus a short note on the account's current allocation.\n\nDo not invoke or hand over to any other agents. Your only responsibility is this single action. The orchestrator will coordinate a confirmation email if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the action fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "fund_switch_agent_trigger",
      "handlers": [
        {
          "description": "Validate account holdings and insert a fund switch request",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "switch_fund",
            "agentToolDescription": "Requests a fund switch. Provide account_id, from_fund_id, to_fund_id, amount (USD), and a generated switch_id (format SWT-2026-XXXX). Validates current holdings and inserts the switch request. Returns validation context and confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:fund_switch_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"account_id\":{\"type\":\"string\"},\"from_fund_id\":{\"type\":\"string\"},\"to_fund_id\":{\"type\":\"string\"},\"amount\":{\"type\":\"number\"},\"switch_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"account_id\": \"RET-5001\", \"from_fund_id\": \"FND-001\", \"to_fund_id\": \"FND-005\", \"amount\": 30000, \"switch_id\": \"SWT-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
