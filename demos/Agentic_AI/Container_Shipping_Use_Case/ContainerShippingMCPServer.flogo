  "name": "ContainerShippingMCPServer",
  "description": "MCP Server exposing read-only customer, booking, container, tracking, vessel-schedule, rate, charge and claim lookups for the Maritime Container Shipping Customer Assistant.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Container Shipping MCP server for Agentic AI - Customer Assistant",
      "settings": {
        "serverName": "ContainerShippingCustomerAssistant",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/shipping-bss",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "ContainerShippingMCPServer",
      "handlers": [
        {
          "description": "Retrieve all shipping customer profile records",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetCustomerProfile",
            "handlerDescription": "Get all shipping customer (Beneficial Cargo Owner) profile records including customer_code, company_name, account_type (BCO, Forwarder, Enterprise), loyalty_tier (Gold, Silver, Bronze), contact_name, contact_email, contact_phone, country, credit_terms, and active_since. Use this to identify a customer by their customer_code (e.g. CUST-SHIP-1001) and retrieve their account and contact details.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getCustomerProfile"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
