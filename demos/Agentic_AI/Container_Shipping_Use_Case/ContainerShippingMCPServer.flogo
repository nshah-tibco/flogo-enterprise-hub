            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "getCustomerProfile"
        },
        {
          "description": "Retrieve all bookings",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetBookings",
            "handlerDescription": "Get every container booking including booking_ref, customer_code, voyage_id, origin_port and destination_port (UN/LOCODEs), container_type, quantity, cargo_description, total_amount_usd, currency, status (Confirmed, In Transit, Delayed, Discharged, Delivered, Amendment Requested, Cancelled), and booking_date. Use this for questions about a customer's bookings, their lane, cargo, amount, and status.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
