        {
          "description": "Retrieve container tracking events",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "TrackContainer",
            "handlerDescription": "Get the scan-by-scan movement history for containers including event_id, container_no, event_time, location_port, event_type (Gate In, Loaded, Vessel Departed, Vessel Arrived, Transshipment, Discharged, Delivered, Hold, In Transit), and description. Results let you trace a container_no (e.g. MSKU7000001) end to end and explain where it currently is and why it may be delayed.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
