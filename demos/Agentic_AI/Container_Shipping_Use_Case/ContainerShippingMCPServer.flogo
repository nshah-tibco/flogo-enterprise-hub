    {
      "id": "flow:getVesselSchedule",
      "data": {
        "name": "getVesselSchedule",
        "description": "Retrieve the sailing schedule",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "PostgreSQLQuery",
            "type": "label",
            "label": "StartActivity to PostgreSQLQuery"
          },
          {
            "id": 2,
            "from": "PostgreSQLQuery",
            "to": "Return",
            "type": "label",
            "label": "PostgreSQLQuery to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "PostgreSQLQuery",
            "name": "PostgreSQLQuery",
            "description": "This activity executes query on a PostgreSQL database",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://c0000001-9720-4a10-b001-000000000001",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT v.voyage_id, v.service_name, v.vessel_id, ve.vessel_name, v.origin_port, po.port_name AS origin_port_name, v.destination_port, pd.port_name AS destination_port_name, v.etd, v.eta, v.transit_days, v.status FROM public.voyages v JOIN public.vessels ve ON v.vessel_id = ve.vessel_id JOIN public.ports po ON v.origin_port = po.port_code JOIN public.ports pd ON v.destination_port = pd.port_code ORDER BY v.etd ASC;",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "voyage_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "service_name",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "vessel_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "vessel_name",
                    "Type": "VARCHAR",
