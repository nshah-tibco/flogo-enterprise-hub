  ],
  "connections": {
    "0bca1111-2222-4eee-8fff-000000008084": {
      "id": "0bca1111-2222-4eee-8fff-000000008084",
      "name": "OpenAIConn",
      "ref": "#llmprovider",
      "isGlobal": false,
      "settings": {
        "name": "OpenAIConn",
        "description": "",
