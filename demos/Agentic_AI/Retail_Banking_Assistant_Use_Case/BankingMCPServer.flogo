          "description": "Retrieve customer profile records",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetCustomerProfile",
            "handlerDescription": "Get customer profile records: customer_id, first_name, last_name, phone_number, and email. Use to identify a customer and to obtain their contact details (e.g. email for confirmations). Filter by customer_id.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
