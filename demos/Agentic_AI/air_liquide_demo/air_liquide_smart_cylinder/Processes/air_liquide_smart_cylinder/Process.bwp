                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/schemas/airliquide/cylinder&quot; xmlns:tns7=&quot;http://xmlns.example.com/Cylinders-id/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Cylinders>&#xa;            &lt;xsl:for-each select=&quot;$ParseXml/tns6:Cylinder[(tns6:gasType = $get1.parameters/tns7:gasType) and ( tns6:location = $get1.parameters/tns7:location) ]&quot;>&#xa;                &lt;tns6:Cylinder>&#xa;                    &lt;tns6:cylinderId>&#xa;                        &lt;xsl:value-of select=&quot;tns6:cylinderId&quot;/>&#xa;                    &lt;/tns6:cylinderId>&#xa;                    &lt;tns6:gasType>&#xa;                        &lt;xsl:value-of select=&quot;tns6:gasType&quot;/>&#xa;                    &lt;/tns6:gasType>&#xa;                    &lt;tns6:purityGrade>&#xa;                        &lt;xsl:value-of select=&quot;tns6:purityGrade&quot;/>&#xa;                    &lt;/tns6:purityGrade>&#xa;                    &lt;tns6:pressureBar>&#xa;                        &lt;xsl:value-of select=&quot;tns6:pressureBar&quot;/>&#xa;                    &lt;/tns6:pressureBar>&#xa;                    &lt;tns6:volumeLiters>&#xa;                        &lt;xsl:value-of select=&quot;tns6:volumeLiters&quot;/>&#xa;                    &lt;/tns6:volumeLiters>&#xa;                    &lt;tns6:location>&#xa;                        &lt;xsl:value-of select=&quot;tns6:location&quot;/>&#xa;                    &lt;/tns6:location>&#xa;                    &lt;tns6:status>&#xa;                        &lt;xsl:value-of select=&quot;tns6:status&quot;/>&#xa;                    &lt;/tns6:status>&#xa;                    &lt;tns6:certExpiryDate>&#xa;                        &lt;xsl:value-of select=&quot;tns6:certExpiryDate&quot;/>&#xa;                    &lt;/tns6:certExpiryDate>&#xa;                &lt;/tns6:Cylinder>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns6:Cylinders>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:cylinder="http://www.tibco.com/schemas/airliquide/cylinder"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="cylinder:Cylinders" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
