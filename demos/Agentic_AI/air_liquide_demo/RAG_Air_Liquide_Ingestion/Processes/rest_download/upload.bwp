    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="37586b14-1fb2-4878-99b6-2e332749bf27">
                <bpws:onMessage operation="post" partnerLink="upload"
                    portType="ns:upload"
                    tibex:xpdlId="724d456a-15e8-45cf-8ce0-0e4fff47b268" variable="post">
                    <bpws:scope name="scope1">
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="OnMessageStartToIterate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="IterateTopostOut" tibex:linkType="SUCCESS"/>
