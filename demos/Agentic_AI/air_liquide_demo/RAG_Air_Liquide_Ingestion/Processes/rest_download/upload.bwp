                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20250707171427PLT&quot; xmlns:tns3=&quot;http://www.example.org/FileDetailsSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:FileData>&#xa;            &lt;tns3:filePath>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Files uploaded to AS DataGrid successfully from the location : &amp;quot;, $WriteFile/fileInfo/location)&quot;/>&#xa;            &lt;/tns3:filePath>&#xa;        &lt;/tns3:FileData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20250707171427PLT" xmlns:tns3="http://www.example.org/FileDetailsSchema" version="2.0"&gt;&lt;xsl:param name="WriteFile"/&gt;&lt;xsl:template name="postOut-input" match="/"&gt;&lt;tns:postResponse&gt;&lt;item&gt;&lt;tns3:FileData&gt;&lt;tns3:filePath&gt;&lt;xsl:value-of select="concat(&amp;quot;Files uploaded to AS DataGrid successfully from the location : &amp;quot;, $WriteFile/fileInfo/location)"/&gt;&lt;/tns3:filePath&gt;&lt;/tns3:FileData&gt;&lt;/item&gt;&lt;/tns:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="IngestTopostOut"/>
                                </bpws:targets>
