                            <bpws:scope name="Iterate"
                                tibex:group="iterate" tibex:xpdlId="52ba963d-93ce-4053-87a9-2471210ee6b4">
                                <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToIterate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="IterateTopostOut"/>
                                </bpws:sources>
                                <bpws:sequence name="sequence" tibex:group="iterate">
                                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                                    <bpws:forEach counterName="index"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$post/form/tns:uploadPostForm/tns:files[*]" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($post.form/tns:files[*])]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="tns:Iterate_Current_Element_files"
                                    name="currentFile" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToWriteFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="WriteFileToGroupEnd" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="809ff189-c882-407a-b670-e1a853638c33" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToWriteFile"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($post.form/tns:files[*])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentFile"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:empty
                                    name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="5d374aa6-db22-4093-9ae4-2d06aa19338d">
                                    <bpws:targets>
                                    <bpws:target linkName="WriteFileToGroupEnd"/>
                                    </bpws:targets>
                                    </bpws:empty>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="WriteFile-input"
                                    name="WriteFile"
                                    outputVariable="WriteFile"
                                    tibex:xpdlId="9decdd66-3577-477c-b140-65c8cca843e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToWriteFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="WriteFileToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://xmlns.example.com/upload/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentFile&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns2:WriteActivityInputBinaryClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat(&amp;quot;C:\tmp\air_liquide_demo&amp;quot;, $currentFile/tns1:filename)&quot;/>&lt;/fileName>&lt;binaryContent>&lt;xsl:value-of select=&quot;$currentFile/tns1:content&quot;/>&lt;/binaryContent>&lt;/tns2:WriteActivityInputBinaryClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.file.write"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>

                                    <value
                                    compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="binary" xsi:type="file:WriteFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Chunk-input"
                                    name="Chunk" outputVariable="Chunk"
                                    tibex:xpdlId="b54e7c8a-1c0a-4936-9f86-c5890de8d439" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateTopostOut"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ChunkTopostOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/RAG/chunk&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;WriteFile&quot;/>&lt;xsl:template name=&quot;Chunk-input&quot; match=&quot;/&quot;>&lt;tns6:chunkInput>&lt;fileDirectory>&lt;xsl:value-of select=&quot;$WriteFile/fileInfo/location&quot;/>&lt;/fileDirectory>&lt;/tns6:chunkInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.rag.chunk"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:rag="http://ns.tibco.com/bw/palette/rag" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/rag#//Chunk"/>
                                    <value
                                    ragConnection="ragConnectorResource"
                                    strategy="Paragraph-Based Chunking" xsi:type="rag:Chunk"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Ingest-input"
                                    name="Ingest"
                                    outputVariable="Ingest"
                                    tibex:xpdlId="97c2bae3-4794-46f9-aaaa-d34bb1524eb1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ChunkTopostOut"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="IngestTopostOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/RAG/ingest&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Chunk&quot;/>&lt;xsl:template name=&quot;Ingest-input&quot; match=&quot;/&quot;>&lt;tns4:ingestInput>&lt;xsl:for-each select=&quot;$Chunk/chunk&quot;>&lt;chunkedText>&lt;chunkedText>&lt;xsl:value-of select=&quot;text&quot;/>&lt;/chunkedText>&lt;xsl:copy-of select=&quot;metadata&quot;/>&lt;/chunkedText>&lt;/xsl:for-each>&lt;/tns4:ingestInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.rag.ingest"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:rag="http://ns.tibco.com/bw/palette/rag" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/rag#//Ingest"/>
                                    <value
                                    outputEmbedding="true"
                                    ragConnection="ragConnectorResource" xsi:type="rag:Ingest"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
