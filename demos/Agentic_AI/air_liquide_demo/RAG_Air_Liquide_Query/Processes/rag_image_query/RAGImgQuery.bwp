                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://xmlns.example.com/RAGImgQuery/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentFile&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns3:WriteActivityInputBinaryClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat(&amp;quot;/Users/mustafa.tavawala/workspace_tibco/imageData/&amp;quot;, $currentFile/tns1:filename)&quot;/>&lt;/fileName>&lt;binaryContent>&lt;xsl:value-of select=&quot;$currentFile/tns1:content&quot;/>&lt;/binaryContent>&lt;/tns3:WriteActivityInputBinaryClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.file.write"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>

                                    <value
                                    compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="binary" xsi:type="file:WriteFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ListFiles-input"
                                    name="ListFiles"
                                    outputVariable="ListFiles"
                                    tibex:xpdlId="48f92836-3051-48cb-b520-3694124727da" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateToListFiles"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListFilesToQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;WriteFile&quot;/>&lt;xsl:template name=&quot;ListFiles-input&quot; match=&quot;/&quot;>&lt;tns3:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;concat($WriteFile/fileInfo/location, &amp;quot;\*.*&amp;quot;)&quot;/>&lt;/fileName>&lt;/tns3:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.list"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value
                                    mode="only-files" xsi:type="file:ListFiles"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/RAG/query&quot; xmlns:tns1=&quot;http://xmlns.example.com/RAGImgQuery/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;ListFiles&quot;/>&lt;xsl:template name=&quot;Query-input&quot; match=&quot;/&quot;>&lt;tns:queryInput>&lt;question>&lt;xsl:value-of select=&quot;$post/form/tns1:ragimgqueryPostForm/tns1:question&quot;/>&lt;/question>&lt;xsl:for-each select=&quot;$ListFiles/files/fileInfo&quot;>&lt;imageFilePath>&lt;xsl:value-of select=&quot;fullName&quot;/>&lt;/imageFilePath>&lt;/xsl:for-each>&lt;systemPrompt>&lt;xsl:value-of select=&quot;'You are a helpful assistant providing grounded answers based ONLY on the provided retrieved context documents. &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Strict Rules:&amp;#xD;&amp;#xA;1. Grounding: Answer the user query using ONLY the provided context. If the context does not contain enough information to answer the question, state clearly: &amp;quot;I cannot answer this based on the provided documents.&amp;quot; Do NOT use outside knowledge or make assumptions.&amp;#xD;&amp;#xA;2. Inline Citations: Cite your sources inline directly after the statement using numeric markers like [1], [2], etc., corresponding to the metadata (e.g., filename, page/section) of the retrieved document.&amp;#xD;&amp;#xA;3. Citation Accuracy: Every paragraph and claim must contain inline citations. Never invent or hallucinate source names, page numbers, or citation markers.&amp;#xD;&amp;#xA;4. Sources Section: End your response with a &amp;quot;Sources&amp;quot; section listing every cited reference in numerical order with its metadata (e.g., [1] AirLiquide_Safety_SDS_Argon.txt - Section 1).&amp;#xD;&amp;#xA;5. Consistency: Ensure strict 1-to-1 matching between the inline markers [X] and the numbered list in the Sources section.'&quot;/>&lt;/systemPrompt>&lt;maxResult>&lt;xsl:value-of select=&quot;10&quot;/>&lt;/maxResult>&lt;minScore>&lt;xsl:value-of select=&quot;0.5&quot;/>&lt;/minScore>&lt;/tns:queryInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Query-input"
                                    name="Query" outputVariable="Query"
                                    tibex:xpdlId="6272f0f3-d947-4b91-a819-6d25a3fa3d30" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartTopostOut"/>
                                    <bpws:target linkName="ListFilesToQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="QueryTopostOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/RAG/query&quot; xmlns:tns1=&quot;http://xmlns.example.com/RAGImgQuery/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.form&quot;/>&#xa;    &lt;xsl:param name=&quot;ListFiles&quot;/>&#xa;    &lt;xsl:template name=&quot;Query-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:queryInput>&#xa;            &lt;question>&#xa;                &lt;xsl:value-of select=&quot;$post.form/tns1:question&quot;/>&#xa;            &lt;/question>&#xa;            &lt;xsl:for-each select=&quot;$ListFiles/files/fileInfo&quot;>&#xa;                &lt;imageFilePath>&#xa;                    &lt;xsl:value-of select=&quot;fullName&quot;/>&#xa;                &lt;/imageFilePath>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;systemPrompt>&#xa;                &lt;xsl:value-of select=&quot;'You are a helpful assistant providing grounded answers based ONLY on the provided retrieved context documents. &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Strict Rules:&amp;#xD;&amp;#xA;1. Grounding: Answer the user query using ONLY the provided context. If the context does not contain enough information to answer the question, state clearly: &amp;quot;I cannot answer this based on the provided documents.&amp;quot; Do NOT use outside knowledge or make assumptions.&amp;#xD;&amp;#xA;2. Inline Citations: Cite your sources inline directly after the statement using numeric markers like [1], [2], etc., corresponding to the metadata (e.g., filename, page/section) of the retrieved document.&amp;#xD;&amp;#xA;3. Citation Accuracy: Every paragraph and claim must contain inline citations. Never invent or hallucinate source names, page numbers, or citation markers.&amp;#xD;&amp;#xA;4. Sources Section: End your response with a &amp;quot;Sources&amp;quot; section listing every cited reference in numerical order with its metadata (e.g., [1] AirLiquide_Safety_SDS_Argon.txt - Section 1).&amp;#xD;&amp;#xA;5. Consistency: Ensure strict 1-to-1 matching between the inline markers [X] and the numbered list in the Sources section.'&quot;/>&#xa;            &lt;/systemPrompt>&#xa;            &lt;maxResult>&#xa;                &lt;xsl:value-of select=&quot;10&quot;/>&#xa;            &lt;/maxResult>&#xa;            &lt;minScore>&#xa;                &lt;xsl:value-of select=&quot;0.5&quot;/>&#xa;            &lt;/minScore>&#xa;        &lt;/tns:queryInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.rag.query"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:rag="http://ns.tibco.com/bw/palette/rag" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/rag#//Query"/>
                                    <value
                                    ragConnection="ragConnectorResource" xsi:type="rag:Query"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
