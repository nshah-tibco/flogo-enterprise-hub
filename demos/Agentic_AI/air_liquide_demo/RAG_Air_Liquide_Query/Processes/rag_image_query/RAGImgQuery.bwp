&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20250821212024PLT" xmlns:tns4="http://www.example.org/QuerySchema" version="2.0"&gt;&lt;xsl:param name="Query"/&gt;&lt;xsl:template name="postOut-input" match="/"&gt;&lt;tns2:postResponse&gt;&lt;item&gt;&lt;tns4:ResponseElement&gt;&lt;tns4:answer&gt;&lt;xsl:value-of select="$Query/answer"/&gt;&lt;/tns4:answer&gt;&lt;/tns4:ResponseElement&gt;&lt;/item&gt;&lt;/tns2:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
