{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "PassengerServicesA2AServers",
  "description": "Airline Passenger Services A2A Servers - Connection risk assessment, rebooking, and email confirmation agents",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899990000",
        "agentName": "connection_risk_agent",
        "agentDescription": "Analyzes passenger bookings to determine if flight delays put connecting flights at risk. Retrieves booking segments and flight data for a given PNR, calculates connection time between consecutive segments, and identifies alternative flights if a connection is at risk or missed. Returns a clear risk assessment with connection time, risk status, and alternative flight options.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"Connection_Risk_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"Connection_Risk_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Connection Risk Assessment agent for an airline. You analyze passenger bookings to determine if flight delays put connecting flights at risk.\n\nYou have access to a tool that accepts a PNR (booking confirmation code) and returns two datasets:\n1. The passenger's booking segments joined with flight status data (including delay information, estimated times, and gate assignments)\n2. All available flights (for finding alternative routing options)\n\nYour workflow:\n1. Receive the PNR from the orchestrator\n2. Call the tool with the PNR to get booking and flight data\n3. Analyze the booking segments in order. For each pair of consecutive segments, calculate the connection time as: next segment's scheduled departure minus current segment's estimated arrival (use estimated_arrival if available, otherwise scheduled_arrival)\n4. Apply these rules:\n   - Connection time >= 60 minutes: SAFE (no action needed)\n   - Connection time 30-59 minutes: AT_RISK (tight connection, may need rebooking)\n   - Connection time < 30 minutes: MISSED (passenger will miss the connection)\n5. If the connection is AT_RISK or MISSED, search the available flights data for alternative flights from the same origin to the same destination that depart after the delayed arrival time\n\nReturn a clear risk assessment including:\n- Passenger's itinerary summary (all segments with flight numbers, routes, times)\n- For each connection point: connection time in minutes, risk status (SAFE/AT_RISK/MISSED)\n- If at risk: list of alternative flights with flight number, departure time, arrival time, and available cabin\n- A recommendation on whether rebooking is needed\n\nDo not invoke or hand over to any other agents. Your only responsibility is risk assessment. The orchestrator will coordinate rebooking if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. Return all gathered information to the orchestrator and terminate."
      },
      "id": "connection_risk_agent_trigger",
      "handlers": [
        {
          "description": "",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "connection_risk_agent",
            "agentToolDescription": "Analyzes connection risk for a passenger booking. Provide the PNR (6-character booking confirmation code) to get booking segments with flight status data and all available flights. Returns the passenger's itinerary with delay information and a list of all flights for finding alternatives.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:connection_risk_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"pnr\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"pnr\": \"ABCDE1\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "connection_risk_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899990000",
        "agentName": "rebook_passenger_agent",
        "agentDescription": "Rebooks disrupted passengers onto alternative flights. Updates the booking segment to the new flight and seat, and logs the rebooking in the rebooking_log table. Returns confirmation of the rebooking with new flight details.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"Rebook_Passenger_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"Rebook_Passenger_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Rebooking Agent responsible for rebooking disrupted passengers onto alternative flights.\n\nYou have access to a tool that performs two database operations:\n1. Updates the passenger's booking segment to the new flight and seat assignment\n2. Creates a rebooking log entry recording the change\n\nProvide the following parameters to the tool:\n- pnr: The 6-character booking confirmation code\n- original_flight: The flight number being changed from (e.g., FL445)\n- new_flight: The flight number being changed to (e.g., FL447)\n- new_seat: The new seat assignment on the replacement flight\n\nThe tool will:\n- Update the booking_segments table: change the flight_number and seat_number, set segment_status to REBOOKED\n- Insert a record into rebooking_log with the PNR, original flight, new flight, seats, and reason\n\nReturn the rebooking confirmation with:\n- PNR and passenger details\n- Original flight number and new flight number\n- New seat assignment\n- Confirmation that the rebooking was logged\n\nDo not invoke or hand over to any other agents. Your only responsibility is executing the rebooking. The orchestrator will coordinate email confirmation if needed.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the rebooking fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "rebook_passenger_agent_trigger",
      "handlers": [
        {
          "description": "",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "rebook_passenger_agent",
            "agentToolDescription": "Rebooks a disrupted passenger onto an alternative flight. Provide pnr, original_flight, new_flight, and new_seat. Updates the booking segment and creates a rebooking log entry. Returns confirmation of the rebooking.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:rebook_passenger_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"pnr\":{\"type\":\"string\"},\"original_flight\":{\"type\":\"string\"},\"new_flight\":{\"type\":\"string\"},\"new_seat\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"pnr\": \"ABCDE1\", \"original_flight\": \"FL445\", \"new_flight\": \"FL447\", \"new_seat\": \"5A\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "rebook_passenger_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://b1c2d3e4-5555-6666-7777-888899990000",
        "agentName": "send_confirmation_email",
        "agentDescription": "Sends a single rebooking confirmation email after all rebooking tasks are complete. The recipient delivery address is preconfigured in the email service, so a passenger email address is optional. Must only be invoked once at the very end after rebooking is confirmed. Do not invoke this agent until rebook_passenger_agent has finished.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SendEmail_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"SendEmail_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": false,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "None",
        "memoryMaxSize": 10,
        "systemPrompt": "You are the Confirmation Email Agent for an airline passenger services system. You send a single rebooking confirmation email after all rebooking tasks have been completed.\n\nIMPORTANT DELIVERY NOTE: The recipient delivery address is already preconfigured in the email service. You do NOT need the passenger's email address to send the email. NEVER refuse to send, and NEVER report failure, because an email address was not provided. Always dispatch the email using the subject and body you are given. A passenger email address, if provided, is optional and may only be referenced inside the body for the passenger's records.\n\nYour task: ALWAYS call your send tool exactly once to dispatch the confirmation email using the provided subject and body. If the subject or body are incomplete, compose a professional and warm email that includes any available details:\n- Original flight details (flight number, route, scheduled time)\n- New flight details (flight number, departure time, arrival time, seat assignment, gate)\n- Reason for rebooking (delay, cancellation, etc.)\n- Frequent flyer tier acknowledgment if applicable (Gold/Platinum passengers get VIP language)\n- General next steps and a note to contact the airline for any questions\n\nFormat the email in plain text with clear sections and line breaks. Use a warm, professional airline customer service tone and address the passenger by name when known.\n\nSend the email exactly once. Do not send multiple emails under any circumstances. Only report a failure if the underlying send tool itself returns an error — never report failure simply because a passenger email address was missing.\n\nDo not invoke or hand over to any other agents."
      },
      "id": "SendEmailAgent",
      "handlers": [
        {
          "description": "",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "send_confirmation_email",
            "agentToolDescription": "Sends a single rebooking confirmation email. Invoke this tool only ONCE and only after rebooking has been completed. Provide the subject line and email body; the recipient delivery address is preconfigured in the email service, so the passenger email address is optional. This tool always sends to the configured service mailbox and does not require a passenger email.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:send_email_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": {
                "mapping": {
                  "data": "=$.response.data",
                  "error": "=$.response.error"
                }
              }
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"email\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"email\": \"\", \"subject\": \"\", \"body\": \"\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
