                "logLevel": ""
              }
            }
          },
          {
            "id": "PostgreSQLUpdate",
            "name": "PostgreSQLUpdate",
            "description": "Update booking segment to new flight and seat",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://c2d3e4f5-aaaa-bbbb-cccc-ddddeeeeffff",
                "QueryName": "",
                "Schema": "public",
                "Query": "UPDATE booking_segments SET flight_number = ?new_flight, seat_number = ?new_seat, segment_status = 'REBOOKED' FROM bookings WHERE booking_segments.booking_id = bookings.id AND bookings.pnr = ?pnr AND booking_segments.flight_number = ?original_flight;",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "new_flight",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "new_seat",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
