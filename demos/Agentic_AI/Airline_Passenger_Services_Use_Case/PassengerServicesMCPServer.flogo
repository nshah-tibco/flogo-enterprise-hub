  "name": "PassengerServicesMCPServer",
  "description": "Airline Passenger Services MCP Server - Exposes flight, passenger, booking, and loyalty data as AI tools via PostgreSQL",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Airline MCP server for Agentic AI - Passenger Services",
      "settings": {
        "serverName": "AirlinePassengerServices",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/airlinemcpserver",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "AirlineMCPServer",
      "handlers": [
        {
          "description": "Retrieve all flight records",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetFlights",
            "handlerDescription": "Get all flight information including flight number, origin, destination, scheduled and estimated times, status (ON_TIME, DELAYED, CANCELLED), gate, delay minutes, delay reason, and aircraft type. Use this to check flight status or find available flights.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getFlights"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
