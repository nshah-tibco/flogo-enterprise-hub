{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "PassengerServicesAIOrchestrator",
  "description": "Airline Passenger Services AI Orchestrator - WebSocket chat interface orchestrating MCP and A2A agents for flight disruption management",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "Websocket server listens for connection request from the client",
      "settings": {
        "port": 8083,
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "",
          "settings": {
            "method": "GET",
            "path": "/airline",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers",
              "content": "=$.content",
              "wsconnection": "=$.wsconnection"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Key\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Version\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Upgrade\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator Flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "Configure AI Agent in the flow",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://d1e2f3a4-1111-2222-3333-444455556666",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://e1f2a3b4-aaaa-bbbb-cccc-111122223333",
                  "conn://f1a2b3c4-aaaa-bbbb-cccc-222233334444",
                  "conn://a1b2c3d4-aaaa-bbbb-cccc-333344445555"
                ],
                "mcpServers": [
                  "conn://b1c2d3e4-aaaa-bbbb-cccc-444455556666"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Airline Passenger Services AI Agent responsible for helping passengers with flight disruptions at a hub-and-spoke airline operating through Atlanta (ATL). You manage three sub-agents: connection_risk_agent for assessing connection risk when flights are delayed, rebook_passenger_agent for rebooking disrupted passengers onto alternative flights, and send_confirmation_email for sending rebooking confirmation emails to passengers.\n\nINTENT ANALYSIS: Before invoking any sub-agent, carefully analyze the user's request to determine which tasks are needed.\n- If the user asks about a flight status → use MCP tools (GetFlights) to retrieve flight status information\n- If the user asks about their booking or PNR → use MCP tools (GetBookings, GetBookingSegments, GetPassengers) to look up booking details\n- If the user asks about loyalty status → use MCP tools (GetFrequentFlyer) to check tier and miles\n- If a flight is delayed and the passenger has a connecting flight → invoke connection_risk_agent with the PNR to assess connection risk\n- If the passenger needs rebooking → invoke rebook_passenger_agent with PNR, original flight, new flight, and new seat\n- Only invoke send_confirmation_email if the user explicitly requests a confirmation email, and only ONCE after rebooking is complete\n\nWORKFLOW FOR DISRUPTION HANDLING: Follow this sequence when handling a flight disruption.\nStep 1: Use MCP tools to check flight status and identify delays.\nStep 2: Use MCP tools to look up the passenger's booking by PNR and identify connecting flights.\nStep 3: If a connection is at risk, invoke connection_risk_agent with the PNR to calculate risk and find alternative flights.\nStep 4: Present the risk assessment and alternative options to the passenger. Wait for confirmation before proceeding.\nStep 5: If the passenger confirms rebooking, invoke rebook_passenger_agent with the agreed details.\nStep 6: Only if the passenger requests a confirmation email, invoke send_confirmation_email exactly ONCE. When you do, compose a complete subject line and a full email body yourself, describing the original flight, the new flight (number, departure time, arrival time, seat, gate), and the reason for rebooking, and pass them as the subject and body arguments. The recipient delivery address is preconfigured in the email service, so you do NOT need the passenger's email address to send — always proceed with the email. If you already know the passenger's email from an earlier GetPassengers lookup, you may include it as the email argument for the records, but NEVER withhold the email or report that it failed merely because you lack an email address.\n\nCRITICAL EMAIL RULE: You must NEVER invoke send_confirmation_email more than once in a single conversation. Only invoke it as the very last step after rebooking is fully completed and the user has explicitly requested it. Track whether you have already called it and refuse to call it a second time.\n\nMCP TOOLS: Use for all read-only data queries (flight status, booking lookup, passenger info, frequent flyer tier). The MCP server provides 5 tools: GetFlights, GetPassengers, GetFrequentFlyer, GetBookings, GetBookingSegments. Never use MCP tools for modifications - use the rebook_passenger_agent sub-agent for that.\n\nRESPONSE STYLE: Be warm, professional, and proactive. Address passengers by name when known. Acknowledge loyalty tier (Gold members get priority language, Platinum members get VIP treatment language). Always explain the situation clearly before asking for confirmation. Format connection times clearly (e.g., \"You would have only 15 minutes to make your connection, which is below the minimum 60-minute connection time\").\n\nSCOPE: You only handle flight status inquiries, booking lookups, connection risk assessment, passenger rebooking, and confirmation emails. Politely decline requests about baggage, upgrades, refunds, meal preferences, or other services. Clearly state what you can and cannot assist with.\n\nTERMINATION RULES: Complete each sub-agent task within a maximum of 3 attempts. If any sub-agent fails after 3 attempts, collect partial results and report what was completed and what failed."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": ""
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Websocket Write Data Activity will write data to existing Websocket connection",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiQUlBZ2VudCI6eyJ4IjoyNDgsInkiOjk2fSwiV2Vic29ja2V0V3JpdGVEYXRhIjp7IngiOjQ2OCwieSI6OTV9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
