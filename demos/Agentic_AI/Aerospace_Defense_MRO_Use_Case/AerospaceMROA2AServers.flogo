  "name": "AerospaceMROA2AServers",
  "description": "Aerospace MRO A2A Agents",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Opens a new maintenance work order for an aircraft. Validates the tail exists, then inserts a work order with an auto-generated WO number.",
      "settings": {
        "llmProviderConnection": "conn://ff2f7e22-394f-4c0f-b987-4cbf2c05c30d",
        "agentName": "schedule_maintenance_agent",
        "agentDescription": "Opens a new maintenance work order for an aircraft. Validates the tail exists, then inserts a work order with an auto-generated WO number.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SCHEDULE_MAINTENANCE_AGENT_PORT\"]",
        "agentUrl": "=$property[\"SCHEDULE_MAINTENANCE_AGENT_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Maintenance Scheduling Agent. You open a new maintenance work order for an aircraft in the MRO system. Use the tool with these parameters: tail_number (e.g. AD-0142 or N738MA), wo_type (one of Scheduled, Unscheduled, AOG, Inspection), description (the work to be done), priority (one of ROUTINE, URGENT, AOG), and due_date (YYYY-MM-DD). The tool validates the tail exists, then inserts a work order with an auto-generated WO number and status OPEN. Return the confirmation with the tail, type, priority and due date. Do not hand over to other agents. Complete within 3 tool-call attempts; on failure return the error and stop."
      },
      "id": "schedule_maintenance_agent",
      "handlers": [
        {
          "description": "Opens a new maintenance work order for an aircraft. Validates the tail exists, then inserts a work order with an auto-generated WO number.",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "schedule_maintenance_agent",
            "agentToolDescription": "Open a new maintenance work order for a tail. Provide tail_number, wo_type (Scheduled/Unscheduled/AOG/Inspection), description, priority (ROUTINE/URGENT/AOG), and due_date (YYYY-MM-DD). Returns the created work order confirmation.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:schedule_maintenance_agent_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": "schema://schedule_maintenance_agent_Resp",
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": "schema://schedule_maintenance_agent_ToolParams",
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "schedule_maintenance_agent_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Raises a part order (optionally EXPEDITE) against a work order/tail. Validates the part exists and flags stock at/below reorder level.",
      "settings": {
        "llmProviderConnection": "conn://ff2f7e22-394f-4c0f-b987-4cbf2c05c30d",
        "agentName": "order_part_agent",
        "agentDescription": "Raises a part order (optionally EXPEDITE) against a work order/tail. Validates the part exists and flags stock at/below reorder level.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"ORDER_PART_AGENT_PORT\"]",
        "agentUrl": "=$property[\"ORDER_PART_AGENT_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Parts Ordering Agent. You raise a part order (optionally EXPEDITE) against a work order/tail. Parameters: part_number (e.g. PN-4471-A), quantity (integer), tail_number, wo_number, priority (ROUTINE or EXPEDITE). The tool validates the part exists and flags if quantity on hand is at or below the reorder level, then inserts a part order with an auto-generated order id and status ORDERED. Return the confirmation. Do not hand over to other agents. Complete within 3 attempts; on failure return the error and stop."
      },
      "id": "order_part_agent",
      "handlers": [
        {
          "description": "Raises a part order (optionally EXPEDITE) against a work order/tail. Validates the part exists and flags stock at/below reorder level.",
