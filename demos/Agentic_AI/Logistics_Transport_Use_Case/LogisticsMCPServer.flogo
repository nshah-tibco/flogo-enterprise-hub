      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Logistics MCP server",
      "settings": {
        "serverName": "Logistics",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/logisticsmcpserver",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "LogisticsMCPServer",
      "handlers": [
        {
          "description": "Get the shipper/customer profile: name, account type (Individual/Business), loyalty tier, email and phone. Use to identify who the customer is.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetCustomerProfile",
            "handlerDescription": "Get the shipper/customer profile: name, account type (Individual/Business), loyalty tier, email and phone. Use to identify who the customer is.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getCustomers"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://EmptyArgs"
            }
          },
          "name": "getCustomers"
        },
        {
          "description": "List shipments with tracking number, status (Label Created/In Transit/Out for Delivery/Delivered/Delayed/Exception), service level, origin, destination, carrier, weight, declared value and estimated/actual delivery dates. Use to find a shipment or check its status.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
