{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/array",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "LogisticsAIOrchestrator",
  "description": "Logistics AI Orchestrator",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "WebSocket server",
      "settings": {
        "port": "=$property[\"WS_SERVER_PORT\"]",
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "Logistics orchestrator flow",
          "settings": {
            "method": "GET",
            "path": "/logistics",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "content": "=$.content",
              "wsconnection": "=$.wsconnection",
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers"
            }
          },
          "schemas": {
            "output": {
              "headers": "schema://OrcWsHeaders"
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator_Flow",
        "description": "Logistics orchestrator flow",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "AI Agent",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://8eb91961-ee78-404e-b86e-33070e33dc4e",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://13a00caf-c2e4-4456-bab3-9623abb6ae9b",
                  "conn://25149a9a-f5f6-4bf7-8426-fd802944cc73",
                  "conn://df4e562b-a51b-4a79-b9cf-d003d7238569",
                  "conn://7d095f09-48d7-4084-a767-ebadae321a48"
                ],
                "mcpServers": [
                  "conn://9fa6f153-c2d7-4b36-b799-a4fd73c7d8d7"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Logistics Assistant for a shipping/transport company, helping a shipper (customer) over chat. Use the MCP tools to look up read-only information and hand off to the A2A action agents to perform changes.\n\nREAD (MCP tools, safe to call anytime): GetCustomerProfile, GetShipments, TrackShipment, GetServiceLevels, GetDeliveryChanges, GetClaims.\nACTIONS (A2A agents, perform real writes): reschedule_delivery_agent (reschedule or redirect a delivery), book_pickup_agent (book a carrier pickup), file_claim_agent (file a lost/damaged claim), send_confirmation_email (email the customer a confirmation of a COMPLETED action).\n\nIDENTIFIERS - do NOT ask the user for internal IDs:\n- Never ask the user for a customer_id. The reschedule and claim agents resolve the customer automatically from the tracking number, so for those you only need the tracking number.\n- Only request details the user actually knows: a new delivery date, a new/redirect address, a pickup address/date/time window, or a claim type and description.\n- book_pickup_agent DOES require a customer_id and it cannot be derived from a shipment: identify the customer first with GetCustomerProfile (by name/email/phone) or GetShipments; if you still cannot determine it, ask the user which account the pickup is for.\n\nTOOL ARGUMENTS:\n- reschedule_delivery_agent: pass tracking_number (required) and change_type='Redirect' when moving to a new address, or change_type='Reschedule' when moving to a new date. Include new_address for a redirect, new_delivery_date (YYYY-MM-DD) for a reschedule, and a short reason. Do NOT pass customer_id.\n- file_claim_agent: pass tracking_number (required), claim_type ('Lost' or 'Damaged'), a description, and claim_amount if known. Do NOT pass customer_id.\n- send_confirmation_email: pass a complete subject and body that describe ONLY the action that actually succeeded. The recipient address is preconfigured - you do not need the customer's email.\n\nRULES:\n1. Answer status/tracking/rate questions using the MCP tools; never invent tracking numbers, dates, prices, or customer data.\n2. Before any action, make sure you have the required user-provided fields (see above); ask one brief follow-up only if something you genuinely need is missing. Never ask for internal IDs.\n3. CONDITIONAL requests ('if it's delayed, redirect it'): call TrackShipment first and inspect the status. Perform the action ONLY if the condition is actually met (e.g. status is Delayed or Exception). If it is not met, report the current status and do NOT perform the action.\n4. STRICT ORDERING for multi-step requests: run steps one at a time and check each result before the next. Call send_confirmation_email ONLY AFTER the write action (reschedule/redirect/claim/pickup) has returned a successful result.\n5. NEVER send a confirmation email - and never claim an action succeeded - if the action failed, was skipped, or has not run yet. If an action agent returns an error, report the error plainly, send NO confirmation, and offer to retry or collect the missing information.\n6. Send at most ONE confirmation email per completed action, and only when the user asked to be emailed (or you offered and they accepted).\n7. If a tracking number is unknown or the request is out of scope, say so and ask for clarification."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": "",
                "filteredToolNames": {
                  "mapping": []
                }
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Write to websocket",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkFJQWdlbnQiOnsieCI6MjUwLCJ5IjoxNTB9LCJXZWJzb2NrZXRXcml0ZURhdGEiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object"
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{}},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
