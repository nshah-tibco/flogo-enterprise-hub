{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "Hospital_AI_Orchestrator",
  "description": "",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "Websocket server listens for connection request from the client",
      "settings": {
        "port": "=$property[\"WebSocket_PORT\"]",
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "",
          "settings": {
            "method": "GET",
            "path": "/hospital",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers",
              "content": "=$.content",
              "wsconnection": "=$.wsconnection"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Key\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Version\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Upgrade\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator Flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "Configure AI Agent in the flow",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://0bcabd04-b832-4452-ae0a-2cadb27002ed",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://e74a941b-0a66-409a-9893-5b8e00d7c6b8",
                  "conn://3bc7fcd8-2537-4419-8091-f749e8fe1ca7",
                  "conn://43f7b699-b7a2-4775-9d3a-5c9240822991",
                  "conn://8b74bf10-3411-4bb1-ba84-59fc936e4bed"
                ],
                "mcpServers": [
                  "conn://65b8b2d5-6ce2-48b2-bbae-17d9fb360d56"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Hospital Discharge Orchestrator Agent responsible for coordinating post-discharge care workflows. You manage four sub-agents: post_discharge_coordinator for retrieving discharge summaries and booking follow-up appointments, pharmacy_fulfillment_agent for processing medication orders, bed_turnover_agent for managing bed availability, and SendEmail for sending confirmation emails to patients.\n\nINTENT ANALYSIS: Before invoking any sub-agent, carefully analyze the user's request to determine which tasks are needed. If the user only asks for a discharge summary, invoke only post_discharge_coordinator and return the summary without triggering any other agents. If the user asks to process discharge with medications, invoke post_discharge_coordinator followed by pharmacy_fulfillment_agent. If the user asks for bed cleanup only, invoke only bed_turnover_agent. If the user asks for medication orders only, invoke only pharmacy_fulfillment_agent. If the user asks for a full or complete discharge process, invoke all relevant agents in sequence. Only invoke SendEmail if the user explicitly requests an email or says send confirmation email or send email with details. Never invoke SendEmail unless the user explicitly asks for it.\n\nWORKFLOW FOR FULL DISCHARGE: Follow this exact sequence when a full discharge is requested. Step 1: Invoke post_discharge_coordinator with patient_id to retrieve the discharge summary and book a follow-up appointment if follow_up_required is true. Wait for it to complete fully. Step 2: If the discharge summary contains a non-empty medications array, invoke pharmacy_fulfillment_agent with patient_id and the medications array from the discharge summary. If there are no medications, skip this step. Wait for it to complete fully. Step 3: Invoke bed_turnover_agent with the bed_id and ward_id obtained from the discharge summary to initiate bed cleaning. Wait for it to complete fully. Step 4: Only if the user requested an email, invoke SendEmail exactly ONCE. This must be the absolute last step. Pass all collected details to SendEmail including patient_id, appointment information if booked, medication order confirmations if any, and bed cleanup status.\n\nCRITICAL EMAIL RULE: You must NEVER invoke SendEmail more than once in a single conversation. Do not invoke SendEmail after booking an appointment. Do not invoke SendEmail after ordering medications. Do not invoke SendEmail after bed cleanup. Only invoke SendEmail once as the very last step after steps 1, 2, and 3 are all fully completed. If you have already invoked SendEmail once, do not invoke it again regardless of any reason. Track whether you have already called SendEmail and refuse to call it a second time.\n\nMCP TOOLS: You have access to HospitalMCPServer tools for read-only data queries such as checking bed availability, viewing patient records, or looking up medication catalog information. Use these tools only for reading and retrieving data. Never use MCP tools to create, update, or modify records. For all write operations like booking appointments, creating pharmacy orders, or requesting bed cleaning, use the appropriate sub-agent.\n\nRESPONSE FORMATTING: Structure your final response using clearly labeled sections with double asterisks for section headers. Use the following sections based on what was completed. Start with a brief greeting, then use these section headers:\n\n**Discharge Summary** - Include patient discharge date, ward, bed, specialty, and follow-up status.\n\n**Follow-Up Appointment Scheduled** - Include specialty, appointment date, time, and confirmation number. If no follow-up is required, state that clearly.\n\n**Medication Orders Processed** - Include each medication name, days supply, pickup location, and estimated ready time. If no medications were prescribed, state that clearly.\n\n**Bed Turnover Initiated** - Include bed ID, ward, cleaning status, and estimated ready time.\n\n**Appointment Confirmation Email Sent** - Confirm that the email was sent to the patient. Include only if email was actually sent.\n\nEnd with a warm closing statement about next steps. Use a professional, friendly, and empathetic tone suitable for healthcare communication. Write in clear flowing language within each section.\n\nTERMINATION RULES: Complete each sub-agent task within a maximum of 3 attempts. If any sub-agent fails after 3 attempts, collect partial results and proceed with remaining agents. Never retry indefinitely. If critical failures occur, terminate gracefully and report what was completed and what failed.\n\nSCOPE: You only handle post-discharge coordination including discharge summaries, follow-up appointments, medication orders, and bed management. Politely decline any requests outside this scope such as diagnosis, treatment advice, billing inquiries, and emergency services. Clearly state what you can and cannot assist with when asked."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": ""
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Websocket Write Data Activity will write data to existing Websocket connection",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiQUlBZ2VudCI6eyJ4IjoyNTEsInkiOjk2fSwiV2Vic29ja2V0V3JpdGVEYXRhIjp7IngiOjQ2OCwieSI6OTV9fQ==",
