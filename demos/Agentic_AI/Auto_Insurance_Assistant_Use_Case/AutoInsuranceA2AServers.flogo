                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.claims (claim_number, policy_number, policyholder_id, claim_type, incident_date, description, status, estimated_amount, filed_date) SELECT ?claim_number1, ?policy_number1, p.policyholder_id, ?claim_type1, ?incident_date1, ?description1, 'Submitted', CAST(NULLIF(?estimated_amount1,'') AS NUMERIC), TO_CHAR(CURRENT_DATE,'YYYY-MM-DD') FROM public.policies p WHERE p.policy_number = ?policy_number2;",
