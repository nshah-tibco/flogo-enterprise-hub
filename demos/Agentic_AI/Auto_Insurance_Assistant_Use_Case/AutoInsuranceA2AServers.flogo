{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/contrib/function/string",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "AutoInsuranceA2AServers",
  "description": "Auto Insurance A2A Servers - file claim, request callback, update contact details, and confirmation email agents (write workflows)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://a2a10001-2222-4eee-8fff-000000009710",
        "agentName": "file_claim_agent",
        "agentDescription": "Files a new auto insurance claim on the policyholder's policy. Derives the policyholder from the policy_number and inserts a new claim record with status Submitted. Returns a confirmation with the claim number, claim type, incident date, and estimated amount.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"FileClaim_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"FileClaim_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the File Claim Agent for an auto insurance company. You file a new claim on a policyholder's policy.\n\nYou have access to a tool that inserts a new claim record. It derives the policyholder automatically from the policy_number, so you only need the policy number, not an internal policyholder id.\n\nProvide these parameters to the tool:\n- policy_number: The policy the claim is filed against (e.g. POL-AUTO-100001)\n- claim_type: The type of claim (e.g. Collision, Windshield, Theft, Fire, Third Party)\n- incident_date: The date the incident occurred, in YYYY-MM-DD format\n- description: A clear description of what happened\n- estimated_amount: The estimated claim amount as a number (no currency symbol); leave empty if unknown\n- claim_number: A new claim reference you generate in the format CLM-2026-XXXX (4 digits)\n\nThe tool creates the claim with status Submitted and today's date as the filed date, then returns a confirmation.\n\nReturn a clear response including:\n- The claim number and its Submitted status\n- A one-line summary of the claim (type, incident date, and estimated amount if provided)\n- A note that the claim is now under the insurer's review process\n\nDo not invoke or hand over to any other agents. Your only responsibility is filing the claim. The orchestrator will coordinate a confirmation email if the customer asks for one.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the claim filing fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "file_claim_agent_trigger",
      "handlers": [
        {
          "description": "File a new auto insurance claim",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "file_claim",
            "agentToolDescription": "File a new auto insurance claim on the policyholder's policy. Requires policy_number, claim_type, incident_date (YYYY-MM-DD), description, estimated_amount, and a claim_number you generate as CLM-2026-XXXX.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:file_claim_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"policy_number\":{\"type\":\"string\"},\"claim_type\":{\"type\":\"string\"},\"incident_date\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"estimated_amount\":{\"type\":\"string\"},\"claim_number\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"policy_number\": \"POL-AUTO-100001\", \"claim_type\": \"Collision\", \"incident_date\": \"2026-09-01\", \"description\": \"Rear-ended at a traffic light; rear bumper damage.\", \"estimated_amount\": \"3200\", \"claim_number\": \"CLM-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "file_claim_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://a2a10001-2222-4eee-8fff-000000009710",
        "agentName": "request_callback_agent",
        "agentDescription": "Records a request for a callback from a licensed advisor. Derives the policyholder from the policy_number and inserts a callback request with status Requested. Returns a confirmation with the callback id, topic, and preferred time.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"RequestCallback_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"RequestCallback_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Request Callback Agent for an auto insurance company. You record a policyholder's request for a callback from a licensed advisor.\n\nYou have access to a tool that inserts a callback request. It derives the policyholder automatically from the policy_number, so you only need the policy number.\n\nProvide these parameters to the tool:\n- policy_number: The policyholder's policy number (e.g. POL-AUTO-100001)\n- topic: What the callback should be about (e.g. 'Renewal options', 'Claim status', 'Add a driver')\n- preferred_time: The customer's preferred call window (e.g. 'Tomorrow 2-4pm', 'Weekday mornings')\n- callback_id: A new callback reference you generate in the format CB-2026-XXXX (4 digits)\n\nThe tool records the callback with status Requested and the current timestamp, then returns a confirmation.\n\nReturn a clear response including:\n- The callback id and its Requested status\n- The topic and the preferred time captured\n- A note that a licensed advisor will call the customer during the requested window\n\nDo not invoke or hand over to any other agents. Your only responsibility is recording the callback request. The orchestrator will coordinate a confirmation email if the customer asks for one.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the request fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "request_callback_agent_trigger",
      "handlers": [
        {
          "description": "Record a callback request",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "request_callback",
            "agentToolDescription": "Request a callback from a licensed advisor. Requires policy_number, topic, preferred_time, and a callback_id you generate as CB-2026-XXXX.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:request_callback_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"policy_number\":{\"type\":\"string\"},\"topic\":{\"type\":\"string\"},\"preferred_time\":{\"type\":\"string\"},\"callback_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"policy_number\": \"POL-AUTO-100001\", \"topic\": \"Renewal options\", \"preferred_time\": \"Weekday mornings\", \"callback_id\": \"CB-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "request_callback_flow"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://a2a10001-2222-4eee-8fff-000000009710",
        "agentName": "update_contact_details_agent",
        "agentDescription": "Updates a policyholder's contact detail (email, phone, or address) identified by the policy_number. Captures the old value in an audit log before applying the change and returns a confirmation of what was updated.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"UpdateContact_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"UpdateContact_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": true,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 100,
        "systemPrompt": "You are the Update Contact Details Agent for an auto insurance company. You update a policyholder's contact information.\n\nYou have access to a tool that updates exactly one contact field (email, phone number, or address line) on the policyholder record identified by policy_number. The tool first records the previous value in an audit log, then applies the change.\n\nProvide these parameters to the tool:\n- policy_number: The policyholder's policy number (e.g. POL-AUTO-100001)\n- email: The new email address, ONLY if the customer is changing their email; otherwise leave it empty\n- phone_number: The new phone number, ONLY if the customer is changing their phone; otherwise leave it empty\n- address_line1: The new street address, ONLY if the customer is changing their address; otherwise leave it empty\n- change_id: A new change reference you generate in the format CHG-2026-XXXX (4 digits)\n\nIMPORTANT: Pass a value for ONLY the single field being changed and leave the other two empty. Do not overwrite fields the customer did not ask to change.\n\nThe tool logs the old value, applies the update, and returns a confirmation.\n\nReturn a clear response including:\n- The change id\n- Which field was updated and its new value\n- A note that the change has been recorded and is effective immediately\n\nDo not invoke or hand over to any other agents. Your only responsibility is updating the contact detail. The orchestrator will coordinate a confirmation email if the customer asks for one.\n\nTermination rules: Complete your task within a maximum of 3 tool call attempts. If the update fails, return the error details to the orchestrator and terminate gracefully."
      },
      "id": "update_contact_details_agent_trigger",
      "handlers": [
        {
          "description": "Log the old value and update a policyholder contact detail",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "update_contact_details",
            "agentToolDescription": "Update a policyholder's contact detail (email, phone, or address) identified by policy_number. Pass only the field being changed in email/phone_number/address_line1 (leave the others empty), plus a change_id you generate as CHG-2026-XXXX.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:update_contact_details_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"policy_number\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"phone_number\":{\"type\":\"string\"},\"address_line1\":{\"type\":\"string\"},\"change_id\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"policy_number\": \"POL-AUTO-100001\", \"email\": \"michael.carter.new@example.com\", \"phone_number\": \"\", \"address_line1\": \"\", \"change_id\": \"CHG-2026-1001\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
