                "State": "609f87bb-88c9-4be2-9e07-4a366038b98eUPDATE public.policyholders SET email = COALESCE(NULLIF(?email1,''), email), phone_number = COALESCE(NULLIF(?phone1,''), phone_number), address_line1 = COALESCE(NULLIF(?address1,''), address_line1) WHERE policyholder_id = (SELECT policyholder_id FROM public.policies WHERE policy_number = ?policy_number1);",
