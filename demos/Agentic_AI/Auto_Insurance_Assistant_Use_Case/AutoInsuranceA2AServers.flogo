    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://a2a10001-2222-4eee-8fff-000000009710",
        "agentName": "send_confirmation_email_agent",
        "agentDescription": "Sends a single confirmation email after an auto insurance action (a claim filing, a callback request, or a contact-detail update) is complete. The recipient delivery address is preconfigured in the email service, so a customer email address is optional. Must only be invoked once at the very end after the action is confirmed.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"SendEmail_A2AServer_PORT\"]",
        "agentUrl": "=$property[\"SendEmail_A2AServer_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": false,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "None",
        "memoryMaxSize": 10,
        "systemPrompt": "You are the Confirmation Email Agent for an auto insurance assistant. You send a single confirmation email after an auto insurance action (a claim filing, a callback request, or a contact-detail update) has been completed.\n\nIMPORTANT DELIVERY NOTE: The recipient delivery address is already preconfigured in the email service. You do NOT need the customer's email address to send the email. NEVER refuse to send, and NEVER report failure, because an email address was not provided. Always dispatch the email using the subject and body you are given. A customer email address, if provided, is optional and may only be referenced inside the body for the customer's records.\n\nYour task: ALWAYS call your send tool exactly once to dispatch the confirmation email using the provided subject and body. If the subject or body are incomplete, compose a professional and warm email that includes any available details:\n- For a claim: the claim number, the claim type, the incident date, the estimated amount, and the Submitted status\n- For a callback: the callback id, the topic, and the preferred time\n- For a contact update: the change id and which field was updated\n- General next steps and a note to contact the insurer for any questions\n\nFormat the email in plain text with clear sections and line breaks. Use a warm, professional insurance customer service tone and address the customer by name when known.\n\nSend the email exactly once. Do not send multiple emails under any circumstances. Only report a failure if the underlying send tool itself returns an error - never report failure simply because a customer email address was missing.\n\nDo not invoke or hand over to any other agents."
      },
      "id": "send_confirmation_email_agent_trigger",
      "handlers": [
        {
          "description": "Send a single confirmation email for an auto insurance action",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "send_confirmation_email",
            "agentToolDescription": "Send a confirmation email summarizing what was done. Requires subject and body.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:send_confirmation_email_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": {
                "mapping": {
                  "data": "=$.response.data",
                  "error": "=$.response.error"
                }
              }
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"subject\": \"\", \"body\": \"\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
