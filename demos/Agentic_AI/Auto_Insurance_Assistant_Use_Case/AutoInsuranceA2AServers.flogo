              "ref": "#insert",
              "input": {
                "Connection": "conn://a2a20002-2222-4eee-8fff-000000009710",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.contact_change_log (change_id, policyholder_id, field_changed, old_value, new_value, changed_at) SELECT ?change_id1, ph.policyholder_id, CASE WHEN NULLIF(?email1,'') IS NOT NULL THEN 'email' WHEN NULLIF(?phone1,'') IS NOT NULL THEN 'phone_number' WHEN NULLIF(?address1,'') IS NOT NULL THEN 'address_line1' ELSE 'unknown' END, CASE WHEN NULLIF(?email2,'') IS NOT NULL THEN ph.email WHEN NULLIF(?phone2,'') IS NOT NULL THEN ph.phone_number WHEN NULLIF(?address2,'') IS NOT NULL THEN ph.address_line1 ELSE '' END, COALESCE(NULLIF(?email3,''), NULLIF(?phone3,''), NULLIF(?address3,'')), TO_CHAR(CURRENT_TIMESTAMP,'YYYY-MM-DD HH24:MI') FROM public.policyholders ph JOIN public.policies po ON po.policyholder_id = ph.policyholder_id WHERE po.policy_number = ?policy_number1;",
                "manualmode": false,
                "Fields": [
