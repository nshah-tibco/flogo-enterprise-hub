            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://a2a20002-2222-4eee-8fff-000000009710",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.callbacks (callback_id, policyholder_id, policy_number, topic, preferred_time, status, created_at) SELECT ?callback_id1, p.policyholder_id, ?policy_number1, ?topic1, ?preferred_time1, 'Requested', TO_CHAR(CURRENT_TIMESTAMP,'YYYY-MM-DD HH24:MI') FROM public.policies p WHERE p.policy_number = ?policy_number2;",
                "manualmode": false,
                "Fields": [
                  {
