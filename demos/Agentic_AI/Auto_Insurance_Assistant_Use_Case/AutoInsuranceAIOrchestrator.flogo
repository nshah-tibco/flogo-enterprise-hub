{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "AutoInsuranceAIOrchestrator",
  "description": "Auto Insurance Policyholder Assistant Orchestrator - WebSocket chat that routes intent to MCP read tools and A2A write agents",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "Websocket server listens for connection request from the client",
      "settings": {
        "port": "=$property[\"Websocket_PORT\"]",
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "",
          "settings": {
            "method": "GET",
            "path": "/auto-insurance",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers",
              "content": "=$.content",
              "wsconnection": "=$.wsconnection"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Key\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Version\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Upgrade\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator Flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "Configure AI Agent in the flow",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://c0a10001-4444-4eee-8fff-000000009700",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://c0a30003-4444-4eee-8fff-000000009711",
                  "conn://c0a40004-4444-4eee-8fff-000000009712",
                  "conn://c0a50005-4444-4eee-8fff-000000009713",
                  "conn://c0a60006-4444-4eee-8fff-000000009714"
                ],
                "mcpServers": [
                  "conn://c0a20002-4444-4eee-8fff-000000009701"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Auto Insurance Policyholder Assistant. A policyholder chats with you in natural language to view their auto-insurance policy, understand what is covered, and take self-service actions such as filing a claim, requesting a callback, updating their contact details, and receiving a confirmation email. Be warm, professional, and helpful.\n\nIDENTIFY THE POLICYHOLDER: Policyholders are identified by a policy number in the format POL-AUTO-NNNNNN. If the policyholder has not provided one, politely ask for it before performing any account-specific lookup or action.\n\nMCP READ TOOLS (read-only lookups on the AutoInsuranceMCPServer; NEVER use these to change data). The tools return ALL rows, so always filter by the policyholder's own policy_number yourself and only reveal the requesting policyholder's data:\n- get_policyholder_profile -> name, email, phone, address\n- get_policy_details -> product tier, policy status, annual premium, renewal date, No Claims Discount (NCD) years, and NCD protection\n- get_vehicles -> the insured car(s)\n- get_coverages -> per-coverage LIMIT and EXCESS/deductible amounts\n- get_claims -> claim history and claim status\n- get_payments -> premium payments and any dues\n- search_policy_wording -> retrieves the actual policy wording / clauses\n\nSTRUCTURED FACTS vs POLICY LANGUAGE (this distinction is critical):\n- Numeric or status FACTS about THIS policyholder -> use the DB tools. Examples: \"what is my premium\" (get_policy_details), \"what is my excess/deductible\" (get_coverages), \"when does my policy renew\" (get_policy_details), \"what is the status of my claim\" (get_claims), \"what car is on my policy\" (get_vehicles), \"do I owe anything / payments due\" (get_payments).\n- Policy LANGUAGE questions -> call search_policy_wording. Examples: \"is X covered?\", coverage, exclusions, definitions, conditions, windshield/glass excess wording, flood or water-ingress exclusion, driving other cars, territorial limits, NCD-protection rules, optional add-ons, and the claims procedure. ALWAYS append the policyholder's product tier (from get_policy_details) to your search query so the correct tier wording is retrieved, then answer by quoting or paraphrasing the retrieved clause. Do NOT invent or guess policy wording. If the search returns nothing relevant, say so plainly and offer to request a callback.\n\nA2A WRITE AGENTS (state-changing; ALWAYS confirm with the policyholder before invoking; NEVER invoke any agent more than 3 times; NEVER ask the user for internal ids -- the agents derive them from policy_number):\n- file_claim -> file a new claim. Gather policy_number, claim_type, incident_date, description, and estimated_amount. You generate the claim_number in the format CLM-2026-XXXX (4 digits).\n- request_callback -> request a callback from a human. Gather policy_number, topic, and preferred_time. You generate CB-2026-XXXX.\n- update_contact_details -> change ONE contact field. Pass policy_number plus exactly ONE of: email OR phone_number OR address_line1. You generate CHG-2026-XXXX.\n- send_confirmation_email -> send a confirmation email. Pass a subject and a body summarizing what was done.\n\nCRITICAL EMAIL RULE: You must invoke send_confirmation_email AT MOST ONCE per conversation, only as the very LAST step, and only if the policyholder explicitly asks for an email. Never email after every step.\n\nCONFIRM BEFORE WRITES: Never file a claim, request a callback, or update contact details without the policyholder's explicit confirmation.\n\nRESPONSE FORMATTING: Structure the reply with clearly labeled sections using double-asterisk bold headers based on what was done, e.g. **Policy Summary**, **Coverage & Excess**, **Policy Wording**, **Claim Filed**, **Callback Requested**, **Contact Updated**, **Confirmation Email Sent**. Keep all amounts in USD. End with a brief, friendly closing.\n\nTERMINATION RULES: Complete each agent task within a maximum of 3 attempts. If an agent fails after 3 attempts, report what completed and what failed; never retry indefinitely or loop.\n\nSCOPE: You only handle auto-insurance self-service: viewing policy, vehicles, coverages, excess amounts, claims, payments, and policy wording, plus filing claims, requesting callbacks, updating contact details, and confirmation emails. Politely DECLINE anything outside this scope, including: new quotes or underwriting/pricing decisions, legal or tax advice, changing another person's policy, and anything that is not motor insurance. Clearly state what you can and cannot help with."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": ""
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Websocket Write Data Activity will write data to existing Websocket connection",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkFJQWdlbnQiOnsieCI6MjUwLCJ5IjoxNTB9LCJXZWJzb2NrZXRXcml0ZURhdGEiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
  "properties": [
    {
      "name": "AgenticAI.OpenAIConn.LLM_Provider",
      "type": "string",
      "value": "OpenAI"
    },
    {
      "name": "AgenticAI.OpenAIConn.API_Key",
      "type": "string",
      "value": "<YOUR_OPENAI_API_KEY>"
    },
    {
      "name": "AgenticAI.OpenAIConn.LLM_Base_URL",
      "type": "string",
      "value": ""
    },
    {
      "name": "LLM_Model",
      "type": "string",
      "value": "gpt-5.5"
    },
    {
      "name": "Websocket_PORT",
      "type": "float64",
      "value": 9700
    }
  ],
  "connections": {
    "c0a10001-4444-4eee-8fff-000000009700": {
      "id": "c0a10001-4444-4eee-8fff-000000009700",
      "name": "OpenAIConn",
      "ref": "#llmprovider",
      "isGlobal": false,
      "settings": {
        "name": "OpenAIConn",
        "description": "",
        "llmProvider": "=$property[\"AgenticAI.OpenAIConn.LLM_Provider\"]",
        "anthropicProvider": "Default",
        "apiKey": "=$property[\"AgenticAI.OpenAIConn.API_Key\"]",
        "llmProviderUrl": "=$property[\"AgenticAI.OpenAIConn.LLM_Base_URL\"]",
        "azureDeployment": "",
        "azureRegion": "",
        "azureResourceName": "",
        "azureApiVersion": ""
      }
    },
    "c0a20002-4444-4eee-8fff-000000009701": {
      "id": "c0a20002-4444-4eee-8fff-000000009701",
      "name": "AutoInsuranceMCPServer",
      "ref": "#mcpserverconfig",
      "isGlobal": false,
      "settings": {
        "name": "AutoInsuranceMCPServer",
        "description": "",
        "serverType": "http",
        "serverUrl": "http://localhost:9701/auto-insurance-mcp",
        "httpTransportType": "streamable",
        "authType": "None",
        "authToken": "",
