      "name": "FileClaimA2AServer",
      "ref": "#a2aserverconnection",
      "isGlobal": false,
      "settings": {
        "name": "FileClaimA2AServer",
        "description": "FileClaimA2AServer",
        "serverUrl": "http://localhost:9711",
        "authType": "None",
        "authToken": ""
      }
    },
    "c0a40004-4444-4eee-8fff-000000009712": {
